ref<DynArray> s_comp_rela = 0;

ui8 GetSymbolInfo(ui8 binding, ui8 type) {
	return (binding << 4) + (type & 0xF);
}

ui64 GetRelocationInfo(ui64 symbol, ui64 type) {
	return (symbol << 32) + (type & 0xffffffff);
}

// NOTE: IDEA: Maybe use something like this instead of making nearly the same function several times
struct X86_64Instr {
	ui8 srcReg;
	ui8 destReg;
	ui8 srcSize;
	ui8 destSize;
	bool deref;
	i32 offset;
	bool srcIsSection;
}

void MoveRBP(ref<ByteArr> bytes, i32 offset, ui8 reg, ui8 size) {
	/*
	[0] => rax
	[1] => rcx
	[2] => rdx
	[3] => rbx
	[4] => rsp
	[5] => rbp
	[6] => rsi
	[7] => rdi
	 */
	ui8 modRM = 0;
	ui8 rex = 0;
	bool small = false;
	if (offset <= 127) & (offset >= -128) {
		modRM = 0x45 + ((reg % 8) * 8);
		small = true;
	} else {
		modRM = 0x85 + ((reg % 8) * 8);
	}
	if reg > 7 {
		rex = 0x4C;
	} else {
		rex = 0x48;
	}
	if size == 8 {
		bytes.AddByte(rex);
	}
	if size == 1 {
		bytes.AddByte(0x88);
	} else {
		bytes.AddByte(0x89);
	}
	bytes.AddByte(modRM);
	if small {
		bytes.AddByte(offset);
	} else {
		bytes.AddBytes(\offset, 4);
	}
}

ui8 GetREX(bool wide, bool reg, bool rm, bool index) {
	ui8 rex = 0x40;
	if wide {
		rex |= 0x8;
	}
	if reg {
		rex |= 0x4;
	}
	if index {
		rex |= 0x2;
	}
	if rm {
		rex |= 0x1;
	}
	return rex;
}

void MoveRAX(ref<ByteArr> bytes, ui8 reg, bool to) {
	ui8 rex = GetREX(true, reg > 7, false, false);
	bytes.AddByte(rex);
	ui8 modRM = 0xC0 + ((reg % 8) * 8);
	if to {
		bytes.AddByte(0x89);
	} else {
		bytes.AddByte(0x8B);
	}
	bytes.AddByte(modRM);
}

void MoveIntoRAX(ref<ByteArr> bytes, ui8 srcReg) {
	ui8 rex = GetREX(true, srcReg > 7, false, false);
	bytes.AddByte(rex);
	ui8 modRM = 0x00 + ((srcReg % 8) * 8);
	bytes.AddByte(0x89);
	bytes.AddByte(modRM);
}

// This array will just resolve all symbols where they are resolved now, just more dynamic.
// This is also so I don't have to mess around with the order of instructions
// rela.offset = bytes.GetCount()
// rela.addend = addend (comes from variable.offset)

// ModRM byte is 04, 0C, 14, 1C, 24, 2C, 34, 3C depending on the register
// SIB base byte is always 5 for this functionality, if no scale, always 0x25
void MoveFromSection(ref<ByteArr> bytes, ui8 reg, ui8 srcSectionType, ui64 addend, ui8 size, ui8 desiredSize) {
	ui8 rex = GetREX(true, reg > 7, false, false);

	ui8 modRM = 0x04 + ((reg % 8) * 8);

	if (size == 8) | (desiredSize == 8) {
		bytes.AddByte(rex);
	}

	if (desiredSize >= 4) & (size <= 2) {
		// movzx
		bytes.AddByte(0x0F);
		if size == 1 {
			bytes.AddByte(0xB6);
		} else {
			bytes.AddByte(0xB7);
		}
	} else {
		// mov
		if size == 1 {
			bytes.AddByte(0x8A);
		} else {
			bytes.AddByte(0x8B);
		}
	}
	
	bytes.AddByte(modRM);

	// SIB
	bytes.AddByte(0x25);

	// Add rela entry
	CompRelaEntry rela = {
		bytes.GetCount(),
		addend,
		_cCOMPILATION_SECTION_TEXT,
		srcSectionType
	};

	s_comp_rela.Add(\rela);

	bytes.AddUI32(0);
}

// ModRM byte is 04, 0C, 14, 1C, 24, 2C, 34, 3C depending on the register
// SIB base byte is always 5 for this functionality, if no scale, always 0x25
void MoveToSection(ref<ByteArr> bytes, ui8 reg, ui8 srcSectionType, ui64 addend, ui8 size) {
	ui8 rex = GetREX(true, reg > 7, false, false);

	ui8 modRM = 0x04 + ((reg % 8) * 8);

	if size == 8 {
		bytes.AddByte(rex);
	}

	// mov
	if size == 1 {
		bytes.AddByte(0x88);
	} else {
		bytes.AddByte(0x89);
	}
	
	bytes.AddByte(modRM);

	// SIB
	bytes.AddByte(0x25);

	// Add rela entry
	CompRelaEntry rela = {
		bytes.GetCount(),
		addend,
		_cCOMPILATION_SECTION_TEXT,
		srcSectionType
	};

	s_comp_rela.Add(\rela);

	bytes.AddUI32(0);
}

void LoadFromSection(ref<ByteArr> bytes, ui8 reg, ui8 srcSectionType, ui64 addend, ui8 size, ui8 desiredSize) {
	ui8 rex = GetREX(true, reg > 7, false, false);
	ui8 modRM = 0x04 + ((reg % 8) * 8);

	if (size == 8) | (desiredSize == 8) {
		bytes.AddByte(rex);
	}
	bytes.AddByte(0x8D); // lea
	bytes.AddByte(modRM);
	
	// SIB
	bytes.AddByte(0x25);
	
	// Add rela entry
	CompRelaEntry rela = {
		bytes.GetCount(),
		addend,
		_cCOMPILATION_SECTION_TEXT,
		srcSectionType
	};

	s_comp_rela.Add(\rela);

	bytes.AddUI32(0);
}

void LoadFromRBP(ref<ByteArr> bytes, ui8 reg, i32 offset, ui8 size) {
	ui8 rex = GetREX(true, reg > 7, false, false);
	ui8 modRM = 0;
	bool small = false;
	
	if (offset <= 127) & (offset >= -128) {
		modRM = 0x45 + ((reg % 8) * 8);
		small = true;
	} else {
		modRM = 0x85 + ((reg % 8) * 8);
	}
	
	if size == 8 {
		bytes.AddByte(rex);
	}
	
	bytes.AddByte(0x8D); // lea
	bytes.AddByte(modRM);
	if small {
		bytes.AddByte(offset);
	} else {
		bytes.AddBytes(\offset, 4);
	}
}

void MoveFromRBP(ref<ByteArr> bytes, i32 offset, ui8 reg, ui8 size, ui8 desiredSize) {
	// REX.W + 8B /r if size == desiredSize
	// REX.W + 0F B6/7 /r
	ui8 modRM = 0;
	ui8 rex = 0;
	bool small = false;
	if (offset <= 127) & (offset >= -128) {
		modRM = 0x45 + ((reg % 8) * 8);
		small = true;
	} else {
		modRM = 0x85 + ((reg % 8) * 8);
	}
	if reg > 7 {
		rex = 0x4C;
	} else {
		rex = 0x48;
	}
	if (size == 8) | (desiredSize == 8) {
		bytes.AddByte(rex);
	}
	if (desiredSize >= 4) & (size <= 2) {
		// movzx
		bytes.AddByte(0x0F);
		if size == 1 {
			bytes.AddByte(0xB6);
		} else {
			bytes.AddByte(0xB7);
		}
	} else {
		// mov
		if size == 1 {
			bytes.AddByte(0x8A);
		} else {
			bytes.AddByte(0x8B);
		}
	}
	bytes.AddByte(modRM);
	if small {
		bytes.AddByte(offset);
	} else {
		bytes.AddBytes(\offset, 4);
	}
}

void CompareFromRBP(ref<ByteArr> bytes, i32 offset, ui8 reg, ui8 size) {
	// REX.W + 39 /r (+-bit
	// REX + 38 /r (8-bit)
	ui8 modRM = 0;
	bool wide = (size == 8);
	bool needsReg = (reg > 7);
	ui8 rex = GetREX(wide, needsReg, false, false);
	bool small = false;
	if (offset <= 127) & (offset >= -128) {
		modRM = 0x45 + ((reg % 8) * 8);
		small = true;
	} else {
		modRM = 0x85 + ((reg % 8) * 8);
	}

	if rex != 0x40 {
		bytes.AddByte(rex);
	}

	// cmp
	if size == 1 {
		bytes.AddByte(0x38);
	} else {
		bytes.AddByte(0x39);
	}

	bytes.AddByte(modRM);

	if small {
		bytes.AddByte(offset);
	} else {
		bytes.AddBytes(\offset, 4);
	}
}

void CompareFromSection(ref<ByteArr> bytes, ui8 reg, ui8 srcSectionType, ui64 addend, ui8 size) {
	ui8 rex = GetREX(true, reg > 7, false, false);

	ui8 modRM = 0x04 + ((reg % 8) * 8);
	
	if rex != 0x40 {
		bytes.AddByte(rex);
	}

	// cmp
	if size == 1 {
		bytes.AddByte(0x38);
	} else {
		bytes.AddByte(0x39);
	}

	bytes.AddByte(modRM);

	// SIB
	bytes.AddByte(0x25);

	// Add rela entry
	CompRelaEntry rela = {
		bytes.GetCount(),
		addend,
		_cCOMPILATION_SECTION_TEXT,
		srcSectionType
	};

	s_comp_rela.Add(\rela);

	bytes.AddUI32(0);
}

ui64[128] s_undefined_jumps;
ui64[128] s_jump_labels;
ui64 s_jump_count = 0;

ui64[128] s_stack_sizes;
ui64 s_stack_count = 0;

ui64 s_executable_code_size = 0;
ui64 s_debug_info_size = 0;
ui64 s_offset_debug_abbrev = 0;
ui64 s_debug_abbrev_size = 0;
ui64 s_offset_debug_line = 0;
ui64 s_debug_line_size = 0;

ui64 s_debug_info_high_pc = 0;

ui64[128] s_relocation_offsets;
ui64 s_relocation_offset_count = 0;

ui8[256] s_file_name;
ui8[256] s_dir_path;
ui64 s_dir_path_length = 0;

ref<ByteArr> s_debug_info = 0;
ref<ByteArr> s_debug_abbrev = 0;
ui64 s_debug_index = 1;
ref<ByteArr> s_rela_debug_info = 0;
ui64 s_symbol_text = 0;
ref<ByteArr> s_debug_aranges = 0;

void AddSymbolTableEntry(ref<ByteArr> bytes, ui32 name, ui8 info, ui16 sectionHeaderIndex, ui64 value, ui64 size) {
	Elf64SymbolTableEntry entry = {
		name,
		info,
		_cSTV_DEFAULT, // All symbols are default visibility, which is public for global and private for local
		sectionHeaderIndex,
		value,
		size
	};
	bytes.AddBytes(\entry, 0x18);
}

ui16 GetLineNumberOpcode(i8 lineIncrement, i8 opcodeAdvance) {
	i16 lineBase = -5;
	i16 lineRange = 14;
	i16 opcodeBase = 13;
	return ((lineIncrement - lineBase) + (lineRange * opcodeAdvance)) + opcodeBase;
}

void DebugAddHeader(i32 fd, ref<ui8> fileName) {
	// HACK: The file descriptor SHOULDNT be above 9, so we can just convert it to an ascii char
	ui8[16] procPath = { '/', 'p', 'r', 'o', 'c', '/', 's', 'e', 'l', 'f', '/', 'f', 'd', '/', fd + '0', 0 };

	ui64 length = SYS_READLINK(\procPath, \s_dir_path, 256);
	ui64 lastSlash = 0;
	loop i, 0..length {
		if (s_dir_path[i]) == '/' {
			lastSlash = i;
		}
	}
	lastSlash += 1;
	s_dir_path[lastSlash] = 0;
	stdout.writeln("Directory of file");
	SYS_WRITE(1, \s_dir_path, lastSlash);
	stdout.write("\n");
	s_dir_path_length = lastSlash;

	DwarfCompilationUnitHeader cuh = {
		0, // We are going to be updating the length when we're done
		5, // Version 5
		1, // DW_UT_compile
		8, // Address size
		0 // Abbreviation offset is 0 for some reason, maybe because relocation?
	};
	s_debug_info.AddBytes(\cuh, 12);
	s_relocation_offsets[s_relocation_offset_count] = 8;
	s_relocation_offset_count += 1;

	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_info.AddULEB128(s_debug_index);
	s_debug_index += 1;
	s_debug_abbrev.AddULEB128(0x11);
	s_debug_abbrev.AddByte(1); // Yes children

	s_debug_abbrev.AddULEB128(0x11); // DW_AT_low_pc
	s_debug_abbrev.AddULEB128(0x01); // DW_FORM_addr
	
	Elf64RelocationAddendEntry rela = {
		s_debug_info.GetCount(),
		GetRelocationInfo(s_symbol_text, 0x1),
		0
	};
	s_rela_debug_info.AddBytes(\rela, 0x18);
	
	s_debug_info.AddUI64(0); // It's gonna be relocated anyways (text section)

	s_debug_abbrev.AddULEB128(0x12); // DW_AT_hi_pc
	s_debug_abbrev.AddULEB128(0x07); // DW_FORM_data8
	//ui8 added = s_debug_info.AddSLEB128(s_executable_code_size);
	//s_debug_info.AddSame(0, 8 - added);
	s_debug_info_high_pc = s_debug_info.GetCount();
	s_debug_info.AddUI64(s_executable_code_size);

	s_debug_abbrev.AddULEB128(0x13); // DW_AT_language
	s_debug_abbrev.AddULEB128(0x06); // DW_FORM_data4
	//added = s_debug_info.AddULEB128(0x8000); // DW_LANG_lo_user (custom language)
	//s_debug_info.AddSame(0, 4 - added);
	//s_debug_info.AddUI32(0x8000);
	s_debug_info.AddUI32(0x8001);

	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // DW_FORM_string
	ui64 fileNameLength = GetLengthOfCstring(\s_file_name);
	s_debug_info.AddBytes((\s_file_name) + lastSlash, (fileNameLength - lastSlash) + 1); // File name
	//s_debug_info.AddULEB128(0);

	s_debug_abbrev.AddULEB128(0x25); // DW_AT_producer
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes("Forest 0.0.1", 12);
	s_debug_info.AddByte(0); // Null terminated

	s_debug_abbrev.AddULEB128(0x1b); // DW_AT_comp_dir
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes(\s_dir_path, lastSlash);
	s_debug_info.AddByte(0);

	s_debug_abbrev.AddULEB128(0x10); // DW_AT_stmt_list
	s_debug_abbrev.AddULEB128(0x17); // DW_FORM_sec_offset
	s_relocation_offsets[s_relocation_offset_count] = s_debug_info.GetCount();
	s_relocation_offset_count += 1;
	s_debug_info.AddUI32(0); // It's gonna be relocated anyways (line nr section)

	DebugEndChain();
}

ui8 DebugGetEncoding(ui8 typeType) {
	if (typeType >= _cPARSER_TYPETYPE_UI8) & (typeType <= _cPARSER_TYPETYPE_UI64) {
		return 0x07; // DW_ATE_unsigned
	} else if (typeType >= _cPARSER_TYPETYPE_I8) & (typeType <= _cPARSER_TYPETYPE_I64) {
		return 0x05; // DW_ATE_signed
	} else if (typeType >= _cPARSER_TYPETYPE_F8) & (typeType <= _cPARSER_TYPETYPE_F64) {
		return 0x04; // DW_ATE_float
	} else if typeType == _cPARSER_TYPETYPE_BOOL {
		return 0x02; // DW_ATE_boolean
	} else if typeType == _cPARSER_TYPETYPE_CHAR {
		return 0x08; // DW_ATE_unsigned_char
	}
	return 0;
}

ui64[128] s_debug_types_offsets;
ui64 s_debug_types_offsets_count = 0;

void DebugAddTokenMember(ref<Token> tPtr, ui64 typeRef) {
	Token t = @tPtr;

	s_debug_info.AddULEB128(s_debug_index);
	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_index += 1;
	
	s_debug_abbrev.AddULEB128(0x0d); // DW_TAG_member
	s_debug_abbrev.AddByte(0); // No children
	
	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes(t.text, t.textLength); // name
	s_debug_info.AddByte(0); // null-terminated

	s_debug_abbrev.AddULEB128(0x49); // DW_AT_type
	s_debug_abbrev.AddULEB128(0x14); // DW_FORM_ref8
	s_debug_info.AddUI64(typeRef);
}

void DebugAddField(ref<DynArray> tArr, ref<DynArray> typeArr, ui64 fieldIndex) {
	ref<Field> fieldPtr = s_field_array.At(fieldIndex);
	Field field = @fieldPtr;

	ui64 fieldTypeRef = DebugAddChildType(tArr, typeArr, field.typeIndex);
	
	if (field.aliasCount) > 1 {
		s_debug_info.AddULEB128(s_debug_index);
		s_debug_abbrev.AddULEB128(s_debug_index);
		s_debug_index += 1;
		// DW_TAG_union_type, children yes
		// loop aliases
		// add abbreviation index for each and add as member
		// close with 0 byte
		
		s_debug_abbrev.AddULEB128(0x17); // DW_TAG_union_type
		s_debug_abbrev.AddByte(1); // Yes children

		DebugEndChain();

		loop j, 0..field.aliasCount {
			ui64 tokenIndex = (field.startTokenIndex) + (j * 2);
			ref<Token> tPtr = tArr.At(tokenIndex);
			DebugAddTokenMember(tPtr, fieldTypeRef);
			DebugEndChain();
		}
		DebugEndChain();
		s_debug_info.AddByte(0); // Close list of siblings
	} else {
		ref<Token> tPtr = tArr.At(field.startTokenIndex);
		Token t = @tPtr;
		DebugAddTokenMember(tPtr, fieldTypeRef);
		s_debug_abbrev.AddULEB128(0x38); // DW_AT_data_member_location
		s_debug_abbrev.AddULEB128(0x0f); // DW_FORM_udata
		s_debug_info.AddULEB128(field.offset);
		DebugEndChain();
	}
}

ui64 DebugAddChildType(ref<DynArray> tArr, ref<DynArray> typeArr, ui64 typeIndex) {
	if typeIndex <= s_debug_types_offsets_count {
		return s_debug_types_offsets[typeIndex];
	}
	ref<Type> typePtr = typeArr.At(typeIndex);
	Type type = @typePtr;

	ui64 refType = 0;
	ui64 typeCount = typeArr.GetCount();
	if ((type.firstChild) != -1) & ((type.firstChild) < typeCount) {
		refType = DebugAddChildType(tArr, typeArr, type.firstChild);
	}

	s_debug_info.AddULEB128(s_debug_index);
	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_index += 1;
	ui16 typeType = type.typeType;
	
	if typeType == _cPARSER_TYPETYPE_REF {
		if refType == 0 {
			stdout.write("[Compiler#DebugAddChildType]: Error: Ref Type of Ref was 0\n");
			SYS_EXIT(1);
		}

		ui64 state = s_debug_info.GetCount() - 1;
		s_debug_abbrev.AddULEB128(0x0f); // DW_TAG_pointer_type
		//s_debug_abbrev.AddULEB128(0x10); // DW_TAG_reference_type
		s_debug_abbrev.AddByte(0); // No children
		
		s_debug_abbrev.AddULEB128(0x49); // DW_AT_type
		s_debug_abbrev.AddULEB128(0x14); // DW_FORM_ref8
		s_debug_info.AddUI64(refType);

		refType = state;
		DebugEndChain();
	} else if typeType == _cPARSER_TYPETYPE_ARRAY {
		if refType == 0 {
			stdout.write("[Compiler#DebugAddChildType]: Error: Ref Type of Array was 0\n");
			SYS_EXIT(1);
		}
		ui64 arrType = s_debug_info.GetCount() - 1;
		s_debug_abbrev.AddULEB128(0x01); // DW_TAG_array_type
		s_debug_abbrev.AddByte(0); // No children
		
		s_debug_abbrev.AddULEB128(0x49); // DW_AT_type
		s_debug_abbrev.AddULEB128(0x14); // DW_FORM_ref8
		s_debug_info.AddUI64(refType);

		s_debug_abbrev.AddULEB128(0x0b); // DW_AT_byte_size
		s_debug_abbrev.AddULEB128(0x0f); // DW_FORM_udata
		s_debug_info.AddULEB128(type.byteSize);

		refType = arrType;
		DebugEndChain();
	} else if typeType == _cPARSER_TYPETYPE_STRUCT {
		refType = s_debug_info.GetCount() - 1;
		s_debug_abbrev.AddULEB128(0x13); // DW_TAG_structure_type
		s_debug_abbrev.AddByte(1); // Yes children

		ref<Struct> structPtr = s_struct_array.At(type.extraIndex);
		Struct s = @structPtr;

		s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
		s_debug_abbrev.AddULEB128(0x08); // string
		s_debug_info.AddBytes(s.name, s.nameLength); // name
		s_debug_info.AddByte(0); // Null-terminated

		s_debug_abbrev.AddULEB128(0x0b); // DW_AT_byte_size
		s_debug_abbrev.AddULEB128(0x0f); // DW_FORM_udata
		ui64 byteSize = type.byteSize;
		s_debug_info.AddULEB128(type.byteSize);

		DebugEndChain();

		loop i, 0..s.fieldCount {
			ui64 fieldIndex = (s.firstFieldIndex) + i;
			DebugAddField(tArr, typeArr, fieldIndex);
		}

		s_debug_info.AddByte(0); // Close off children list
	} else if typeType == _cPARSER_TYPETYPE_CLASS {
		refType = s_debug_info.GetCount() - 1;
		s_debug_abbrev.AddULEB128(0x02); // DW_TAG_class_type
		s_debug_abbrev.AddByte(1); // Yes children

		ref<Struct> classPtr = s_struct_array.At(type.extraIndex);
		Struct c = @classPtr;

		s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
		s_debug_abbrev.AddULEB128(0x08); // string
		s_debug_info.AddBytes(c.name, c.nameLength); // name
		s_debug_info.AddByte(0); // Null-terminated

		s_debug_abbrev.AddULEB128(0x0b); // DW_AT_byte_size
		s_debug_abbrev.AddULEB128(0x0f); // DW_FORM_udata
		s_debug_info.AddULEB128(type.byteSize);
		
		DebugEndChain();

		loop i, 0..c.fieldCount {
			ui64 fieldIndex = (c.firstFieldIndex) + i;
			DebugAddField(tArr, typeArr, fieldIndex);
			DebugEndChain();
		}
	} else if typeType == _cPARSER_TYPETYPE_ENUM {
		refType = s_debug_info.GetCount() - 1;
		s_debug_abbrev.AddULEB128(0x04); //DW_TAG_enumeration_type
		s_debug_abbrev.AddByte(1); // yes children

		ref<Struct> enumClassPtr = s_struct_array.At(type.extraIndex);
		Struct enumClass = @enumClassPtr;

		s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
		s_debug_abbrev.AddULEB128(0x08); // string
		s_debug_info.AddBytes(enumClass.name, enumClass.nameLength); // name
		s_debug_info.AddByte(0); // Null-terminated

		s_debug_abbrev.AddULEB128(0x6d); // DW_AT_enum_class
		s_debug_abbrev.AddULEB128(0x19); // DW_FORM_flag_present (means no byte needed in debug_info)
			
		s_debug_abbrev.AddULEB128(0x0b); // DW_AT_byte_size
		s_debug_abbrev.AddULEB128(0x0f); // DW_FORM_udata
		s_debug_info.AddULEB128(type.byteSize);

		DebugEndChain();

		loop i, 0..enumClass.fieldCount {
			s_debug_info.AddULEB128(s_debug_index);
			s_debug_abbrev.AddULEB128(s_debug_index);
			s_debug_index += 1;
			
			s_debug_abbrev.AddULEB128(0x28); //DW_TAG_enumerator
			s_debug_abbrev.AddByte(0); // no children
			
			s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
			s_debug_abbrev.AddULEB128(0x08); // string


			ref<Enum> ePtr = s_enum_array.At((enumClass.firstFieldIndex) + i);
			Enum e = @ePtr;
			s_debug_info.AddBytes(e.name, e.nameLength);
			s_debug_info.AddByte(0); // null-terminated

			s_debug_abbrev.AddULEB128(0x1c); //DW_AT_const_value
			s_debug_abbrev.AddULEB128(0x0f); //DW_FORM_udata
			s_debug_info.AddULEB128(e.value);

			//DebugEndChain();

			DebugEndChain();
		}
		s_debug_info.AddByte(0); // Close off children list
		
	} else {
		stdout.write("[Compiler#DebugAddChildType]: Error: Unexpected typetype in type parser ");
		stdout.writeln(typeType);
		SYS_EXIT(1);
	}
	
	return refType;
}

void DebugAddTypes(ref<DynArray> tArr, ref<DynArray> typeArr) {
	ui64 typeCount = typeArr.GetCount();

	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_info.AddULEB128(s_debug_index);
	
	s_debug_abbrev.AddULEB128(0x24); // DW_TAG_base_type
	s_debug_abbrev.AddByte(0); // No children
	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // string
	
	s_debug_abbrev.AddULEB128(0x3e); // DW_AT_encoding
	s_debug_abbrev.AddULEB128(0x0b); // DW_FORM_data1
	
	s_debug_abbrev.AddULEB128(0x0b); // DW_AT_byte_size
	s_debug_abbrev.AddULEB128(0x0b); // DW_FORM_data1

	// Base types
	loop i, 1.._cPARSER_TYPETYPE_REF {
		ref<Type> typePtr = typeArr.At(i);
		Type type = @typePtr;
		ui64 currCount = s_debug_info.GetCount();
		if i == 1 {
			currCount -= 1; // HACK: For some reason this is one off for the first type
		}
		s_debug_types_offsets[i] = currCount; // GDB requires this to point to the abbrev number and not the name
		s_debug_types_offsets_count += 1;
		
		s_debug_info.AddULEB128(s_debug_index);

		// Name
		ref<ui8> typeName = GetNameFromTypeIndex(i);
		ui64 len = GetLengthOfCstring(typeName);
		s_debug_info.AddBytes(typeName, len + 1);

		// Encoding
		ui8 encoding = DebugGetEncoding(type.typeType);
		s_debug_info.AddByte(encoding);

		// Byte size
		s_debug_info.AddByte(type.byteSize);
	}
	s_debug_index += 1;
	DebugEndChain();

	ui64 j = _cPARSER_TYPETYPE_REF;
	
	loop {
		if j >= typeCount {
			break;
		}
		ref<Type> typePtr = typeArr.At(j);
		Type type = @typePtr;

		ui64 refType = DebugAddChildType(tArr, typeArr, j);
		s_debug_types_offsets[j] = refType;
		s_debug_types_offsets_count = j;

		if (type.nextSibling) == -1 {
			break;
		} else if (type.nextSibling) >= typeCount {
			break;
		}
		j = type.nextSibling;
	}
}

ui8 DebugLineAddCode(ui64 opDiff, ui64 lineDiff, ui8 debugByte, ref<ByteArr> lineInfoBytes) {
	ui16 specialOpcode = GetLineNumberOpcode(lineDiff, opDiff);
	stdout.write("Increasing line number by: ");
	stdout.write(lineDiff);
	stdout.write(" and ops by: ");
	stdout.write(opDiff);
	stdout.write(" Opcode: ");
	stdout.writeln(specialOpcode);
	bool shouldExit = false;
	
	if specialOpcode > 255 {
		lineInfoBytes.AddByte(_cANALYSER_INSTRTYPE_DEBUG_ADVANCE_PC - 100);
		lineInfoBytes.AddULEB128(opDiff);
		
		lineInfoBytes.AddByte(_cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE - 100);
		lineInfoBytes.AddSLEB128(lineDiff);
		shouldExit = true;
	}
	if shouldExit {
		return 0;
	}
	if specialOpcode <= 255 {
		lineInfoBytes.AddByte(specialOpcode);
	} else {
		lineInfoBytes.AddByte(debugByte);
	}
	return 1;
}

ui64 s_debug_function_state = 0;

void DebugAddFunction(ref<ui8> name, ui64 nameLength, ui64 byteOffset) {
	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_info.AddULEB128(s_debug_index);
	s_debug_index += 1;

	s_debug_abbrev.AddULEB128(0x2e); // DW_TAG_subprogram
	s_debug_abbrev.AddByte(1); // Children
	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes(name, nameLength);
	s_debug_info.AddByte(0); // Null-terminated

	s_debug_abbrev.AddULEB128(0x3f); // DW_AT_external
	s_debug_abbrev.AddULEB128(0x19); // DW_FORM_flag_present (means no byte needed in debug_info)

	s_debug_abbrev.AddULEB128(0x11); // DW_AT_low_pc
	s_debug_abbrev.AddULEB128(0x01); // DW_FORM_addr

	Elf64RelocationAddendEntry rela = {
		s_debug_info.GetCount(),
		GetRelocationInfo(s_symbol_text, 0xa),
		byteOffset
	};
	s_rela_debug_info.AddBytes(\rela, 0x18);
	
	s_debug_info.AddUI64(0); // It's gonna be relocated anyways
	
	s_debug_abbrev.AddULEB128(0x12); // DW_AT_hi_pc
	s_debug_abbrev.AddULEB128(0x07); // DW_FORM_data8
	s_debug_function_state = s_debug_info.GetCount();
	s_debug_info.AddUI64(0);

	s_debug_abbrev.AddULEB128(0x40); // DW_AT_frame_base
	s_debug_abbrev.AddULEB128(0x18); // DW_FORM_exprloc
	s_debug_info.AddByte(1); // 1 entry
	s_debug_info.AddByte(0x56); // DW_OP_reg6 (rbp)
}

void DebugEndFunction(ui64 functionSize) {
	s_debug_info.UpdateBytes(\functionSize, s_debug_function_state, 8);
	s_debug_info.AddByte(0); // Close this nested depth
}

void DebugAddWithType(ui64 typeIndex) {
	s_debug_abbrev.AddULEB128(0x49); // DW_AT_type
	s_debug_abbrev.AddULEB128(0x14); // DW_FORM_ref8
	ui64 offset = s_debug_types_offsets[typeIndex];
	s_debug_info.AddUI64(offset);
}

void DebugAddParameter(ref<ui8> name, ui64 nameLength, i8 offset) {
	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_info.AddULEB128(s_debug_index);
	s_debug_index += 1;

	s_debug_abbrev.AddULEB128(0x05); // DW_TAG_formal_parameter
	s_debug_abbrev.AddByte(0); // Children
	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes(name, nameLength);
	s_debug_info.AddByte(0); // Null-terminated

	s_debug_abbrev.AddULEB128(0x02); // DW_AT_location
	s_debug_abbrev.AddULEB128(0x18); // DW_FORM_exprloc
	ui64 byteState = s_debug_info.GetCount();
	s_debug_info.AddByte(2); // 2 byte block
	s_debug_info.AddByte(0x91); // DW_OP_fbreg (frame base reg + offset)
	ui8 added = s_debug_info.AddSLEB128(offset); // Offset
	added += 1;
	s_debug_info.UpdateBytes(\added, byteState, 1);
}

void DebugAddVariable(ref<ui8> name, ui64 nameLength, i8 offset) {
	s_debug_abbrev.AddULEB128(s_debug_index);
	s_debug_info.AddULEB128(s_debug_index);
	s_debug_index += 1;

	s_debug_abbrev.AddULEB128(0x34); // DW_TAG_variable
	s_debug_abbrev.AddByte(0); // Children
	s_debug_abbrev.AddULEB128(0x03); // DW_AT_name
	s_debug_abbrev.AddULEB128(0x08); // string
	s_debug_info.AddBytes(name, nameLength);
	s_debug_info.AddByte(0); // Null-terminated

	s_debug_abbrev.AddULEB128(0x02); // DW_AT_location
	s_debug_abbrev.AddULEB128(0x18); // DW_FORM_exprloc
	ui64 byteState = s_debug_info.GetCount();
	s_debug_info.AddByte(2); // 2 byte block
	s_debug_info.AddByte(0x91); // DW_OP_fbreg (frame base reg + offset)
	ui8 added = s_debug_info.AddSLEB128(offset); // Offset
	added += 1;
	s_debug_info.UpdateBytes(\added, byteState, 1);
}

void DebugEndChain() {
	s_debug_abbrev.AddByte(0);
	s_debug_abbrev.AddByte(0);
}

void DebugAddAranges(ref<ByteArr> relaBytes, ui64 debugInfoSymbol) {
	s_debug_aranges.AddUI32(0); // Length;
	s_debug_aranges.AddUI16(2); // Version (always 2)

	ui64 byteCount = s_debug_aranges.GetCount();
	Elf64RelocationAddendEntry relaEntry = {
		byteCount,
		GetRelocationInfo(debugInfoSymbol, 0xa),
		0
	};
	s_debug_aranges.AddUI32(0); // debug_info_offset (needs relocation to debug info)
	relaBytes.AddBytes(\relaEntry, 0x18);

	s_debug_aranges.AddByte(8); // Address size
	s_debug_aranges.AddByte(0); // segment_selector_size

	byteCount = s_debug_aranges.GetCount();
	ui8 padding = (16 - (byteCount % 16)) % 16;
	s_debug_aranges.AddSame(0, padding);

	byteCount = s_debug_aranges.GetCount();
	relaEntry = {
		byteCount,
		GetRelocationInfo(s_symbol_text, 0x1),
		0
	};

	s_debug_aranges.AddUI64(0x40); // Address of text section (Needs relocation)
	s_debug_aranges.AddUI64(s_executable_code_size); // Length of text section
	relaBytes.AddBytes(\relaEntry, 0x18);

	s_debug_aranges.AddUI64(0); // Null address
	s_debug_aranges.AddUI64(0); // Null length

	byteCount = s_debug_aranges.GetCount();
	ui32 actualLength = byteCount - 4;
	s_debug_aranges.UpdateBytes(\actualLength, 0, 4);
}

void FinishDebugInfo() {
	s_debug_abbrev.AddSame(0, 8);
	s_debug_info.AddByte(0);
	ui32 endInfoState = s_debug_info.GetCount();
	ui32 toUpdateLength = endInfoState - 4;
	s_debug_info.UpdateBytes(\toUpdateLength, 0, 4);	
}

void AddDebugInfo(ref<DynArray> tArr, ref<DynArray> nodeArr, ref<DynArray> typeArr, ref<ByteArr> bytes) {
	//stdout.writeln(fd);
	// Add debug line info
	ui64 lineLengthState = bytes.GetCount();
	bytes.AddUI32(0x48); // Length
	bytes.AddUI16(5); // Version
	bytes.AddByte(8); // Address Size
	bytes.AddByte(0); // Segment selector size (no fucking clue what this is)
	ui64 headerState = bytes.GetCount();
	bytes.AddUI32(0x2a); // Header length after this property (has to be recalculated)
	bytes.AddByte(1); // Minimum instruction length
	bytes.AddByte(1); // Maximum operations per instruction
	bytes.AddByte(1); // Default is statement
	bytes.AddByte(-5); // line base
	bytes.AddByte(14); // Line range
	bytes.AddByte(0x0d); // Opcode base (just a default value for DWARF-3 and higher)
	bytes.AddByte(0); // Standard opcode lengths. I still don't know what the fuck this is but the following 12 values are required (stolen from a gcc compiled object file
	bytes.AddByte(1);
	bytes.AddByte(1);
	bytes.AddByte(1);
	bytes.AddByte(1);
	bytes.AddByte(0);
	bytes.AddByte(0);
	bytes.AddByte(0);
	bytes.AddByte(1);
	bytes.AddByte(0);
	bytes.AddByte(0);
	bytes.AddByte(1);
	
	bytes.AddByte(1); // Directory entry format count
	bytes.AddULEB128(1); // DW_LNCT_PATH (part of directory_entry_format)
	bytes.AddULEB128(8); // DW_FORM_STRING (part of directory_entry_format)
	bytes.AddULEB128(1); // Directories count
	bytes.AddBytes(\s_dir_path, s_dir_path_length + 1); // Directory 
	bytes.AddByte(2); // File name entry count
	bytes.AddULEB128(1); // DW_LNCT_PATH (part of file_name_entry_format)
	bytes.AddULEB128(8); // DW_FORM_STRING (part of file_name_entry_format)

	bytes.AddULEB128(2); // DW_LCNT_directory_index
	bytes.AddULEB128(0x0f); // DW_FORM_udata

	bytes.AddULEB128(2); // File name count

	ui64 lastSlash = 0;
	ui64 fileNameLength = GetLengthOfCstring(\s_file_name);
	loop i, 0..fileNameLength {
		if (s_file_name[i]) == '/' {
			lastSlash = i;
		}
	}
	lastSlash += 1;

	bytes.AddBytes((\s_file_name) + lastSlash, (fileNameLength - lastSlash) + 1); // File name
	bytes.AddULEB128(0);
	bytes.AddBytes((\s_file_name) + lastSlash, (fileNameLength - lastSlash) + 1); // File name
	bytes.AddULEB128(0);

	ui64 byteCount = bytes.GetCount();
	s_debug_line_size = byteCount - s_offset_debug_line;
	ui32 actualHeaderLength = byteCount - (headerState + 4);
	ui32 actualLineNumberLength = byteCount - (lineLengthState + 4);
	bytes.UpdateBytes(\actualHeaderLength, headerState, 4);
	bytes.UpdateBytes(\actualLineNumberLength, lineLengthState, 4);
}

ui64[20] s_section_offsets;

void CompileToELF64(ref<DynArray> tArr, ref<DynArray> nodeArr, ref<DynArray> typeArr, ref<DynArray> instrArr, i32 fd, ref<ui8> fileName) {
	ByteArr bytes = {0, 0, 0};
	bytes.New(1024);

	ByteArr abbrevBytes = {0, 0, 0};
	abbrevBytes.New(1024);

	ByteArr infoBytes = {0, 0, 0};
	infoBytes.New(1024);

	ByteArr arangesBytes = {0, 0, 0};
	arangesBytes.New(1024);

	ByteArr dataBytes = {0, 0, 0};
	dataBytes.New(1024);

	ByteArr rodataBytes = {0, 0, 0};
	rodataBytes.New(1024);

	ByteArr bssBytes = {0, 0, 0};
	// bss doesn't have any bytes so no need to allocate anything. This array is just to keep track of the count

	s_debug_info = \infoBytes;
	s_debug_abbrev = \abbrevBytes;
	s_debug_aranges = \arangesBytes;

	ByteArr lineInfoBytes = {0, 0, 0};
	lineInfoBytes.New(1024);

	DynArray sections = {0, 0, 0, 64};
	sections.New(20); // Arbitrary choice

	ByteArr textBytes = {0, 0, 0};
	textBytes.New(4096);
	ByteArr strBytes = {0, 0, 0};
	strBytes.New(1024);
	ByteArr symBytes = {0, 0, 0};
	symBytes.New(1024);
	ByteArr shstrBytes = {0, 0, 0};
	shstrBytes.New(1024);
	ByteArr relaDebugInfoBytes = {0, 0, 0};
	relaDebugInfoBytes.New(1024);
	ByteArr relaDebugLineBytes = {0, 0, 0};
	relaDebugLineBytes.New(1024);

	ByteArr relaTextBytes = {0, 0, 0};
	relaTextBytes.New(1024);

	DynArray compRelaArr = {0, 0, 0, 18};
	compRelaArr.New(100);
	s_comp_rela = \compRelaArr;

	ByteArr relaDebugArangesBytes = {0, 0, 0};
	relaDebugArangesBytes.New(1024);

	s_rela_debug_info = \relaDebugInfoBytes;
	
	/* String section table
	[0]: Nullbyte
	[1]: Program file name
	[2]: _start
	[3..N]: function names in order of s_token_index_array
	 */
	shstrBytes.AddByte(0);
	ref<ui8> name = ".text";
	ui64 nameLength = GetLengthOfCstring(name);
	ui64 nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	Section section = {
		name,
		nameLength + 1,
		\textBytes,
		nameOffset,
		_cSHT_PROGBITS, // type
		_cSHF_ALLOC | _cSHF_EXECINSTR,	// flags
		0, // link
		0, // info
		16, // align
		0 // entrySize
	};
	ui64 textIndex = sections.Add(\section);
	
	// Required empty first entry
	AddSymbolTableEntry(\symBytes, 0, 0, 0, 0, 0);
	ui8 localSymbolCount = 0;
	
	// Program file
	AddSymbolTableEntry(\symBytes, s_string_table_offsets[0], GetSymbolInfo(_cSTB_LOCAL, _cSTT_FILE), _cSHN_ABS, 0, 0);
	localSymbolCount += 1;
	
	// .text section symbol
	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), textIndex, 0, 0);
	localSymbolCount += 1;
	s_symbol_text = localSymbolCount;

	DebugAddHeader(fd, fileName);
	DebugAddTypes(tArr, typeArr);
	AddDebugInfo(tArr, nodeArr, typeArr, \lineInfoBytes);
	

	Elf64Header header = {
		0x7F, 'E', 'L', 'F',
		2, // ELF64
		1, // Little-Endian
		1, // Version 1
		0, // UNIX System V ABI
		0, // ABI version 0
		0, 0, 0, 0, 0, 0, 0, // padding
		1, // Relocatable file
		62, // Machine (62 is AMD64)
		1, // Object file version
		0, // Entry point
		0, // Programme Header offset
		272, // Section header offset
		0, // Flags
		64, // ELF64 header size
		0, // Programme Header byte size
		0, // Programme Header entry count
		64, // Section Header byte size
		8, // Section header entry count
		2 // String section index
	};
	bytes.AddBytes(\header, 64);

	ui64 instrCount = instrArr.GetCount();
	ui64 byteCount = bytes.GetCount();
	ui8[46] hiddenStart = {
		0x48, 0x8b, 0x04, 0x24, // mov rax, [rsp]
		0x48, 0x8d, 0x5c, 0x24,	0x08, // lea rbx, [rsp+8]
		0x55, // push rbp
		0x48, 0x89,	0xe5, // mov rbp, rsp
		0x48, 0x83, 0xec, 0x10, // sub rsp, 16
		0x48, 0x89, 0x45, 0xf0, // mov qword [rbp-16], rax
		0x48, 0x89, 0x5d, 0xf8, // mov qword [rbp-8], rbx
		0x48, 0x8d, 0x7d, 0xf0, // lea rdi, [rbp-16]
		0xe8, /* Address */ 0xff, 0xff, 0xff, 0xff, // call main (this gets changed later)
		0x48, 0x89, 0xc7, // mov rdi, rax
		0x48, 0xc7, 0xc0, 0x3c, 0x00, 0x00, 0x00, // mov rax, 60
		0x0f, 0x05 // syscall
	};
	textBytes.AddBytes(\hiddenStart, 46);
	bool[15] regsInUse = {
		false, false, false, false, false, false, false, false,
		false, false, false, false, false, false, false
	};
	ui8[6] callRegs = { 7, 6, 2, 1, 8, 9 };
	ui64 stackVariables = 0;
	ui64 paramCount = 0;
	ui64[3] offsets = { 0, 0, 0 };
	DynArray variables = {0, 0, 0, 37};
	variables.New(128);
	Variable currentVar = {0, 0, 0, 0, 0, 0};
	Type currentType = {0, 0, 0, 0, 0, 0, 0};
	
	ui8 lastInstructionType = 0;
	ui64 instructionCounter = 0;
	ui64 lastJumpState = 0;

	ui64 dbgLastOpcodeByte = 0;
	ui64 dbgLastLine = 1;
	ui64 line = 1;

	lineInfoBytes.AddByte(0); // Specify Extended opcode
	lineInfoBytes.AddULEB128(9); // size 9
	lineInfoBytes.AddByte(0x2); // DW_LNE_set_address
	ui64 lineRelaState = lineInfoBytes.GetCount();
	lineInfoBytes.AddUI64(0);
	//lineInfoBytes.AddByte(0x4); // DW_LNS_set_file
	//lineInfoBytes.AddByte(0);

	ui64 variableState = 0;

	i64 currentMemOffset = 0;
	ui8 currentMemoryLocation = 0;
	ui8 currentMemoryReg = 0;

	dbgLastOpcodeByte = 46;
	ui64 lastFunctionOffset = 0;
	loop i, 0..instrCount {
		ref<Instr> instrPtr = instrArr.At(i);
		Instr instruction = @instrPtr;
		if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_FUNC {
			ui64 byteOffset = textBytes.GetCount();
			lastFunctionOffset = byteOffset;

			variableState = variables.GetCount();

			ref<Node> funcNodePtr = nodeArr.At(instruction.value);
			Node funcNode = @funcNodePtr;
			s_token_index_array[s_token_index_array_count] = funcNode.tokenIndex;
			s_func_byte_offsets[s_token_index_array_count] = byteOffset;
			s_token_index_array_count += 1;


			ref<Token> funcToken = tArr.At(funcNode.tokenIndex);
			Token t = @funcToken;

			ui64 opDiff = byteOffset - dbgLastOpcodeByte;
			ui64 lineDiff = (t.line) - dbgLastLine;
			dbgLastOpcodeByte = byteOffset;
			dbgLastLine = t.line;
			lineInfoBytes.AddByte(0x2); // DW_LNS_advance_pc
			lineInfoBytes.AddULEB128(opDiff);
			if lineDiff > 0 {
				lineInfoBytes.AddByte(0x03); // DW_LNS_advance_line
				lineInfoBytes.AddULEB128(lineDiff);
			}
			lineInfoBytes.AddByte(0x1); // DW_LNS_copy
			
			DebugAddFunction(t.text, t.textLength, byteOffset);

			if StrEquals((t.text), "main", 4) {
				ui32 callAddress = byteOffset - 34;
				textBytes.UpdateBytes(\callAddress, 30, 4);
			}


			// Reset stack offsets
			offsets[_cVARIABLE_LOCATION_STACK] = 0;
			
			// Add prologue
			ui8[4] prologue = {
				0x55, // push rbp
				0x48, 0x89, 0xE5 // mov rbp, rsp
			};
			textBytes.AddBytes(\prologue, 4);
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_FUNC {
			// Add epilogue
			// add stack to rsp (REX.W + 83 /0 ib)
			// 0x48, 0x83, 0xC4
			s_stack_count -= 1;
			ui8 stackSize = s_stack_sizes[s_stack_count];
			if stackSize != 0 {
				ui8[3] addRsp = {
					0x48, 0x83, 0xC4
				};
				textBytes.AddBytes(\addRsp, 3);
				textBytes.AddByte(stackSize);
			}

			// clean up variables
			ui64 currVariableCount = variables.GetCount();
			variables.DeleteLastN(currVariableCount - variableState);
			
			ui8[2] epilogue = {
				0x5D, // pop rbp
				0xC3, // ret
			};
			textBytes.AddBytes(\epilogue, 2);
			ui64 byteOffset = textBytes.GetCount();
			DebugEndFunction(byteOffset - lastFunctionOffset);
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_STACK {
			ui32 value = NearestMultipleOf(instruction.value, 8);
			if value != 0 {	
				if value < 255 {
					ui8[3] subRsp = {
						0x48, 0x83, 0xEC
					};
					textBytes.AddBytes(\subRsp, 3);
					textBytes.AddByte(value);
				} else {
					stdout.write("[Compiler#CompileToElf64]: Stack size too big for now, can only handle bytes. It was ");
					stdout.writeln(value);
					SYS_EXIT(1);
				}
				s_stack_sizes[s_stack_count] = value;
				s_stack_count += 1;
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CALL_FUNC {
			ref<Token> tokenPtr = tArr.At(instruction.value);
			Token token = @tokenPtr;

			loop j, 0..s_token_index_array_count {
				ui64 tokenIndex = s_token_index_array[j];
				ref<Token> compareTokenPtr = tArr.At(tokenIndex);
				Token compareToken = @compareTokenPtr;
				bool equals = StrEquals(token.text, compareToken.text, token.textLength);
				if equals {
					textBytes.AddByte(0xE8);
					ui64 currentByteCount = textBytes.GetCount();
					ui64 byteOffset = s_func_byte_offsets[j];
					textBytes.AddUI32(byteOffset - (currentByteCount + 4));
					break;
				}
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LABEL {
			regsInUse[0] = false; // Clear RAX after match parameter comparisons
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_HEADER {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_BODY {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_FOOTER {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_BREAKDOWN {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_IF {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_IF {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ELSE {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ELSE_IF {
			ui64 currentByteCount = textBytes.GetCount();
			s_label_bytes[instruction.value] = currentByteCount;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_LOOP {
			ui8[3] addRsp = {
				0x48, 0x83, 0xC4
			};
			textBytes.AddBytes(\addRsp, 3);
			s_stack_count -= 1;
			ui8 stackSize = s_stack_sizes[s_stack_count];
			textBytes.AddByte(stackSize);
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_PARAM {
			// Add it to some kind of symbols array with offset
			currentVar.nodeIndex = instruction.value;
			ref<Node> node = nodeArr.At(instruction.value);
			currentVar.tokenIndex = node.GetTokenIndex();
			ref<Token> tPtr = tArr.At(currentVar.tokenIndex);
			Token t = @tPtr;
			currentVar.name = t.text;
			currentVar.nameLength = t.textLength;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_VAR {
			currentVar.nodeIndex = instruction.value;
			ref<Node> node = nodeArr.At(instruction.value);
			currentVar.tokenIndex = node.GetTokenIndex();
			ref<Token> tPtr = tArr.At(currentVar.tokenIndex);
			Token t = @tPtr;
			currentVar.name = t.text;
			currentVar.nameLength = t.textLength;
			currentVar.location = _cVARIABLE_LOCATION_STACK;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_GLOBAL_VAR {
			currentVar.nodeIndex = instruction.value;
			ref<Node> node = nodeArr.At(instruction.value);
			currentVar.tokenIndex = node.GetTokenIndex();
			ref<Token> tPtr = tArr.At(currentVar.tokenIndex);
			Token t = @tPtr;
			currentVar.name = t.text;
			currentVar.nameLength = t.textLength;
			currentVar.location = _cVARIABLE_LOCATION_BSS;
		}  else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_ASSIGN_GLOBAL_VAR {
			currentVar.nodeIndex = instruction.value;
			ref<Node> node = nodeArr.At(instruction.value);
			currentVar.tokenIndex = node.GetTokenIndex();
			ref<Token> tPtr = tArr.At(currentVar.tokenIndex);
			Token t = @tPtr;
			currentVar.name = t.text;
			currentVar.nameLength = t.textLength;
			currentVar.location = _cVARIABLE_LOCATION_DATA;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SET_ARG {
			ui64 argNumber = instruction.value;
			if argNumber >= 6 {
				stdout.writeln("[Compiler]: Setting more than 6 arguments is currently unsupported");
				SYS_EXIT(1);
			}
			ui8 reg = callRegs[argNumber];
			MoveRAX(\textBytes, reg, false);
			regsInUse[reg] = true;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SET_VALUE {
			if (instruction.valueType) == _cANALYSER_INSTRVALUE_NODE {
				ref<Node> nodePtr = nodeArr.At(instruction.value);
				Node node = @nodePtr;
				ref<Token> varTokenPtr = tArr.At(node.tokenIndex);
				Token varToken = @varTokenPtr;

				ui64 index = variables.FindString(16, varToken.text, varToken.textLength);
				if index == -1 {
					stdout.write("[Compiler#CompileToElf64.set_value]: Error: Unknown variable ");
					ref<Token> t = tArr.At(node.tokenIndex);
					PrintToken(t);
					SYS_EXIT(1);
				}
				ref<Variable> variablePtr = variables.At(index);
				Variable variable = @variablePtr;
				ref<Node> definingNodePtr = nodeArr.At(variable.nodeIndex);
				Node definingNode = @definingNodePtr;
				ref<Type> typePtr = typeArr.At(definingNode.typeIndex);
				Type type = @typePtr;
				if (variable.location) == _cVARIABLE_LOCATION_STACK {	
					MoveRBP(\textBytes, variable.offset, 0, type.byteSize);
				} else {
					stdout.write("[Compiler#CompileToElf64.set_value]: Error: Unknown variable location ");
					ui16 location = variable.location;
					stdout.writeln(location);
					SYS_EXIT(1);
				}
			} else if (instruction.valueType) == _cANALYSER_INSTRVALUE_MEMORY {
				// TODO: This assumes that the most recent memory lookup was a property we are assigning to
				if currentMemoryLocation == _cVARIABLE_LOCATION_STACK {
					MoveRBP(\textBytes, currentMemOffset, 3, currentType.byteSize);
				} else if currentMemoryLocation == _cVARIABLE_LOCATION_DATA {
					MoveToSection(\textBytes, 0, _cCOMPILATION_SECTION_DATA, currentMemOffset, currentType.byteSize);
				} else if currentMemoryLocation == _cVARIABLE_LOCATION_REGISTER {
					MoveIntoRAX(\textBytes, 3);
				} else {
					stdout.write("[Compiler#CompileToElf64.set_value]: Error: Unknown variable location ");
					stdout.writeln(currentMemoryLocation);
					SYS_EXIT(1);
				}
			} else {
				stdout.write("[Compiler#CompileToElf64.set_value]: Error: Unknown instruction value type ");
				ui16 valueType = instruction.valueType;
				stdout.writeln(valueType);
				SYS_EXIT(1);
			}
			regsInUse[0] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_VARIABLE {
			ref<Token> varTokenPtr = tArr.At(instruction.value);
			Token varToken = @varTokenPtr;

			ui64 index = variables.FindString(16, varToken.text, varToken.textLength);
			if index == -1 {
				stdout.write("[Compiler#CompileToElf64.load_variable]: Error: Unknown variable ");
				ref<Token> t = tArr.At(instruction.value);
				PrintToken(t);
				SYS_EXIT(1);
			}
			ref<Variable> variablePtr = variables.At(index);
			Variable variable = @variablePtr;
			memcopy2(\currentVar, \variable, 37);
			ref<Node> nodePtr = nodeArr.At(variable.nodeIndex);
			Node node = @nodePtr;
			ref<Type> typePtr = typeArr.At(node.typeIndex);
			Type type = @typePtr;
			
			bool inUse = regsInUse[0];
			ui8 inUseReg = 0;
			if inUse {
				inUseReg = 3;
			}

			if (type.typeType) == _cPARSER_TYPETYPE_REF {
				currentMemOffset = 0;
				currentMemoryLocation = _cVARIABLE_LOCATION_REGISTER;
				currentMemoryReg = inUseReg;
			}
			
			if (variable.location) == _cVARIABLE_LOCATION_STACK {
				MoveFromRBP(\textBytes, variable.offset, inUseReg, type.byteSize, 8);
			} else if (variable.location) == _cVARIABLE_LOCATION_DATA {
				MoveFromSection(\textBytes, inUseReg, _cCOMPILATION_SECTION_DATA, variable.offset, type.byteSize, 8);
			} else {
				stdout.write("[Compiler#CompileToElf64.load_variable]: Error: Unknown variable location ");
				ui16 location = variable.location;
				stdout.writeln(location);
				SYS_EXIT(1);
			}
			regsInUse[inUseReg] = true;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CMP_VARIABLE {
			ref<Token> varTokenPtr = tArr.At(instruction.value);
			Token varToken = @varTokenPtr;

			ui64 index = variables.FindString(16, varToken.text, varToken.textLength);
			if index == -1 {
				stdout.write("[Compiler#CompileToElf64.cmp_variable]: Error: Unknown variable ");
				ref<Token> t = tArr.At(instruction.value);
				PrintToken(t);
				SYS_EXIT(1);
			}
			ref<Variable> variablePtr = variables.At(index);
			Variable variable = @variablePtr;
			ref<Node> nodePtr = nodeArr.At(variable.nodeIndex);
			Node node = @nodePtr;
			ref<Type> typePtr = typeArr.At(node.typeIndex);
			Type type = @typePtr;
			if (variable.location) == _cVARIABLE_LOCATION_STACK {
				CompareFromRBP(\textBytes, variable.offset, 0, type.byteSize);
			} else if (variable.location) == _cVARIABLE_LOCATION_DATA {
				CompareFromSection(\textBytes, 0, _cCOMPILATION_SECTION_DATA, variable.offset, type.byteSize);
			} else {
				stdout.write("[Compiler#CompileToElf64.cmp_variable]: Error: Unknown variable location ");
				ui16 location = variable.location;
				stdout.writeln(location);
				SYS_EXIT(1);
			}
			regsInUse[0] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CMP_LOADED {
			bool raxUsed = regsInUse[0];
			bool rbxUsed = regsInUse[3];
			if (raxUsed & rbxUsed) {
				ui8[3] cmpRaxRbx = {
					0x48, 0x3B, 0xC3
				};
				textBytes.AddBytes(\cmpRaxRbx, 3);
				regsInUse[0] = false;
				regsInUse[3] = false;
			} else {
				stdout.write("[Compiler#CompileToELF64.cmp_loaded]: Error: Expected both RAX and RBX to be in use");
				SYS_EXIT(1);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CMP_VALUE {
			bool raxUsed = regsInUse[0];
			if (raxUsed) {
				ui8[2] cmpRaxLit = {
					0x48, 0x3D
				};
				textBytes.AddBytes(\cmpRaxLit, 2);
				textBytes.AddUI32(instruction.value);
				//regsInUse[0] = false; RAX gets unset at a DEF_LABEL
				// NOTE: THis is for match cases
			} else {
				stdout.write("[Compiler#CompileToELF64.cmp_value]: Error: Expected RAX to be in use");
				SYS_EXIT(1);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_LABEL {
			ui64 byteOffsetLabel = s_label_bytes[instruction.value];
			textBytes.AddByte(0xE9);
			
			if byteOffsetLabel == 0 {
				stdout.writeln("[Compiler#CompileToELF64.jmp_label]: Warning: Jumping to unknown label\n");
				s_undefined_jumps[s_jump_count] = textBytes.GetCount();
				s_jump_labels[s_jump_count] = instruction.value;
				s_jump_count += 1;
			}
			
			i64 currentByteCount = textBytes.GetCount();
			textBytes.AddUI32(byteOffsetLabel - (currentByteCount + 4));
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_LT {
			instructionCounter = instruction.value;
			textBytes.AddByte(0x72); // JB
			lastJumpState = textBytes.GetCount();
			textBytes.AddByte(0x0);
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_EQ {
			if (instruction.valueType) == _cANALYSER_INSTRVALUE_LABEL {
				// JE rel32
				textBytes.AddByte(0x0F);
				textBytes.AddByte(0x84);

				if (instruction.value) >= s_jump_count {
					stdout.writeln("[Compiler#CompileToELF64.jmp_eq]: Warning: Jumping to unknown label\n");
					s_undefined_jumps[s_jump_count] = textBytes.GetCount();
					s_jump_labels[s_jump_count] = instruction.value;
					s_jump_count += 1;

					textBytes.AddUI32(0);
				} else {
					ui64 byteOffsetLabel = s_label_bytes[instruction.value];
					i64 currentByteCount = textBytes.GetCount();
					textBytes.AddUI32(byteOffsetLabel - (currentByteCount + 4));
				}

			} else {
				instructionCounter = instruction.value;
				textBytes.AddByte(0x74); // JE rel8
				lastJumpState = textBytes.GetCount();
				textBytes.AddByte(0x0);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_INTEGER {
			ui64 counter = 1;
			loop {
				ref<Instr> nextInstrPtr = instrArr.At(i + counter);
				Instr nextInstr = @nextInstrPtr;
				if (nextInstr.type) != _cANALYSER_INSTRTYPE_LOAD_INTEGER {
					break;
				}
				counter += 1;
			}
			if counter == 1 {
				bool inUse = regsInUse[0];
				if !inUse {
					ui8[3] movRax = {
						0x48, 0xC7, 0xC0
					};
					textBytes.AddBytes(\movRax, 3);
					regsInUse[0] = true;
				} else {
					ui8[3] movRbx = {
						0x48, 0xC7, 0xC3
					};
					textBytes.AddBytes(\movRbx, 3);
					regsInUse[3] = true;
				}
				textBytes.AddUI32(instruction.value);
			} else if counter == 2 {
				ui8[3] movRax = {
					0x48, 0xC7, 0xC0
				};
				textBytes.AddBytes(\movRax, 3);
				textBytes.AddUI32(instruction.value);
				regsInUse[0] = true;

				ref<Instr> loadSecondPtr = instrArr.At(i + 1);
				Instr loadSecond = @loadSecondPtr;
				ui8[3] movRbx = {
					0x48, 0xC7, 0xC3
				};
				textBytes.AddBytes(\movRbx, 3);
				textBytes.AddUI32(loadSecond.value);
				regsInUse[3] = true;
				i += 1;
			} else {
				loop j, 0..counter - 2 {
					ref<Instr> nextInstrPtr = instrArr.At(i + j);
					Instr nextInstr = @nextInstrPtr;
					textBytes.AddByte(0x68); // Push imm32
					textBytes.AddUI32(nextInstr.value);
					stackVariables += 1;
				}
				ref<Instr> aPtr = instrArr.At(i + (counter - 2));
				ref<Instr> bPtr = instrArr.At(i + (counter - 1));
				Instr a = @aPtr;
				Instr b = @bPtr;

				ui8[3] movRax = {
					0x48, 0xC7, 0xC0
				};
				textBytes.AddBytes(\movRax, 3);
				textBytes.AddUI32(a.value);
				regsInUse[0] = true;

				ui8[3] movRbx = {
					0x48, 0xC7, 0xC3
				};
				textBytes.AddBytes(\movRbx, 3);
				textBytes.AddUI32(b.value);
				regsInUse[3] = true;
				i += (counter - 1);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_RETURN {
			// TODO: Restore however many stack allocations this block has had
			// Add 0xC3
			ui64 totalStackSize = 0;
			loop j, 0..s_stack_count {
				ui8 stackSize = s_stack_sizes[j];
				totalStackSize += stackSize;
			}
			if totalStackSize > 255 {
				// TODO: Fix
				stdout.write("[Compiler#CompileToELF64.return]: Error: Total stack bigger than 255\n");
				SYS_EXIT(1);
			}
			if totalStackSize != 0 {
				ui8[3] addRsp = {
					0x48, 0x83, 0xC4
				};
				textBytes.AddBytes(\addRsp, 3);
				textBytes.AddByte(totalStackSize);
			}
			
			ui8[2] epilogue = {
				0x5D, // pop rbp
				0xC3, // ret
			};
			textBytes.AddBytes(\epilogue, 2);
			regsInUse[0] = false;
			regsInUse[3] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_STRING {
			ui64 tokenIndex = instruction.value;
			ref<Token> tokenRef = tArr.At(tokenIndex);
			Token token = @tokenRef;
			ui64 stringOffset = dataBytes.GetCount();
			dataBytes.AddBytes(token.text, token.textLength);

			// RAX = 0
			LoadFromSection(\textBytes, 0, _cCOMPILATION_SECTION_DATA, stringOffset, 8, 8);
			regsInUse[0] = true;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_LIST {
			// ignore
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_VALUE {
			if (currentVar.location) == _cVARIABLE_LOCATION_STACK {
				stdout.write("[Compiler#CompileToElf64.with_value]: Error: Wrong instruction type WITH_VALUE for a stack variable\n");
				SYS_EXIT(1);
			} else if (currentVar.location) == _cVARIABLE_LOCATION_DATA {
				// Assert
				ui64 dataCount = dataBytes.GetCount();
				if (currentVar.offset) != dataCount {
					stdout.write("[Compiler#CompileToElf64.with_value]: Assertion Error: Variable offset did not match data bytes count\n");
					stdout.writeln(dataCount);
					i32 offset = currentVar.offset;
					stdout.writeln(offset);
					SYS_EXIT(1);
				}

				i64 exprValue = instruction.value;
				ui64 byteSize = currentType.byteSize;
				dataBytes.AddBytes(\exprValue, currentType.byteSize);
				stdout.write("------------------------------\n");
				stdout.writeln(exprValue);
				stdout.writeln(byteSize);
			} else {
				stdout.write("[Compiler#CompileToElf64.with_value]: Error: Unknown variable location ");
				ui16 location = currentVar.location;
				stdout.writeln(location);
				SYS_EXIT(1);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_VARIABLE_MEMORY {
			ref<Token> varTokenPtr = tArr.At(instruction.value);
			Token varToken = @varTokenPtr;

			ui64 index = variables.FindString(16, varToken.text, varToken.textLength);
			if index == -1 {
				stdout.write("[Compiler#CompileToElf64.load_variable_memory]: Error: Unknown variable ");
				ref<Token> t = tArr.At(instruction.value);
				PrintToken(t);
				SYS_EXIT(1);
			}
			ref<Variable> variablePtr = variables.At(index);
			Variable variable = @variablePtr;
			currentMemOffset = variable.offset;
			currentMemoryLocation = variable.location;
			ref<Node> nodePtr = nodeArr.At(variable.nodeIndex);
			Node node = @nodePtr;
			ref<Type> typePtr = typeArr.At(node.typeIndex);
			Type type = @typePtr;
			bool inUse = regsInUse[0];
			ui8 inUseReg = 0;
			if inUse {
				inUseReg = 3;
			}
			currentMemoryReg = inUseReg;

			currentType.firstChild = type.firstChild;
			currentType.nextSibling = type.nextSibling;
			currentType.extraIndex = type.extraIndex;
			currentType.align = type.align;
			currentType.signed = type.signed;
			currentType.typeType = type.typeType;
			currentType.byteSize = type.byteSize;
			
			if (variable.location) == _cVARIABLE_LOCATION_STACK {
				LoadFromRBP(\textBytes, inUseReg, variable.offset, type.byteSize);
			} else if (variable.location) == _cVARIABLE_LOCATION_DATA {
				LoadFromSection(\textBytes, inUseReg, _cCOMPILATION_SECTION_DATA, variable.offset, type.byteSize, 8);
			} else {
				stdout.write("[Compiler#CompileToElf64.load_variable_memory]: Error: Unknown variable location ");
				ui16 location = variable.location;
				stdout.writeln(location);
				SYS_EXIT(1);
			}
			regsInUse[inUseReg] = true;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_PROPERTY {
			i32 structIndex = currentType.extraIndex;
			ref<Struct> structRef = s_struct_array.At(structIndex);
			Struct strukt = @structRef;

			ref<Token> varTokenPtr = tArr.At(instruction.value);
			Token varToken = @varTokenPtr;

			ui64 fieldCount = strukt.fieldCount;
			ui64 firstFieldIndex = strukt.firstFieldIndex;
			i64 foundFieldIndex = -1;
			loop fieldIt, 0..fieldCount {
				ref<Field> fieldRef = s_field_array.At(firstFieldIndex + fieldIt);
				Field field = @fieldRef;
				ui64 aliasCount = field.aliasCount;
				ui64 startToken = field.startTokenIndex;
				bool found = false;
				loop aliasIt, 0..aliasCount {
					ref<Token> aliasTokenRef = tArr.At(startToken + (aliasIt * 2));
					bool equal = CompareTokens(aliasTokenRef, varTokenPtr);
					if equal {
						found = true;
						break;
					}
				}
				if found {
					foundFieldIndex = firstFieldIndex + fieldIt;
					break;
				}
			}
			if foundFieldIndex == -1 {
				stdout.write("[Compiler#CompileToElf64.load_property]: Error: Unknown property ");
				PrintToken(varTokenPtr);
				stdout.write(" on struct/class type ");
				SYS_WRITE(1, strukt.name, strukt.nameLength);
				stdout.write("\n");
				SYS_EXIT(1);
			}
			ref<Field> foundFieldRef = s_field_array.At(foundFieldIndex);
			Field foundField = @foundFieldRef;
			ui64 foundFieldOffset = foundField.offset;
			currentMemOffset += foundFieldOffset;

			if currentMemoryLocation == _cVARIABLE_LOCATION_REGISTER {
				ui8[3] addRax = {
					0x48, 0x81, 0xC0 // REX.W ADD r/m64, imm32
				};
				textBytes.AddBytes(\addRax, 3);
				textBytes.AddUI32(foundFieldOffset);
			}

			ref<Type> foundFieldTypeRef = typeArr.At(foundField.typeIndex);
			Type foundFieldType = @foundFieldTypeRef;
			
			currentType.firstChild = foundFieldType.firstChild;
			currentType.nextSibling = foundFieldType.nextSibling;
			currentType.extraIndex = foundFieldType.extraIndex;
			currentType.align = foundFieldType.align;
			currentType.signed = foundFieldType.signed;
			currentType.typeType = foundFieldType.typeType;
			currentType.byteSize = foundFieldType.byteSize;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_VALUE {
			bool inUse = regsInUse[0];
			ui8 inUseReg = 0;
			if inUse {
				inUseReg = 3;
			}
			if (instruction.valueType) == _cANALYSER_INSTRVALUE_MEMORY {
				inUseReg = currentMemoryReg;
				if currentMemoryLocation == _cVARIABLE_LOCATION_STACK {
					MoveFromRBP(\textBytes, currentMemOffset, inUseReg, currentType.byteSize, 8);
				} else if currentMemoryLocation == _cVARIABLE_LOCATION_DATA {
					MoveFromSection(\textBytes, inUseReg, _cCOMPILATION_SECTION_DATA, currentMemOffset, currentType.byteSize);
				} else if currentMemoryLocation == _cVARIABLE_LOCATION_REGISTER {
					// Do absolutely nothing, we're already loaded
				} else {
					stdout.write("[Compiler#CompileToElf64.load_value]: Error: Unknown variable location ");
					ui16 location = currentVar.location;
					stdout.writeln(location);
					SYS_EXIT(1);
				}
			}
			regsInUse[inUseReg] = true;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SET_ITEM {
			ui64 nodeIndex = currentVar.nodeIndex;
			ref<Node> nodeRef = nodeArr.At(nodeIndex);
			Node node = @nodeRef;
			
			i32 typeIndex = node.typeIndex;
			ref<Type> typeRef = typeArr.At(node.typeIndex);
			Type type = @typeRef;

			i32 structIndex = type.extraIndex;
			ref<Struct> structRef = s_struct_array.At(structIndex);
			Struct strukt = @structRef;
			
			ui64 firstFieldIndex = strukt.firstFieldIndex;
			ref<Field> fieldRef = s_field_array.At(firstFieldIndex + (instruction.value));
			Field field = @fieldRef;
			i64 memoryOffset = (currentVar.offset) + (field.offset);
			ui64 fieldTypeIndex = field.typeIndex;
			ref<Type> fieldTypeRef = typeArr.At(fieldTypeIndex);
			Type fieldType = @fieldTypeRef;
			
			if (currentVar.location) == _cVARIABLE_LOCATION_STACK {
				MoveRBP(\textBytes, memoryOffset, 0, fieldType.byteSize);
			} else if (currentVar.location) == _cVARIABLE_LOCATION_DATA {
				MoveToSection(\textBytes, 0, _cCOMPILATION_SECTION_DATA, memoryOffset, fieldType.byteSize);
			} else {
				stdout.write("[Compiler#CompileToElf64.set_item]: Error: Unknown variable location ");
				ui16 location = currentVar.location;
				stdout.writeln(location);
				SYS_EXIT(1);
			}
			regsInUse[0] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_TYPE {
			ref<Type> typePtr = typeArr.At(instruction.value);
			Type type = @typePtr;
			currentType.firstChild = type.firstChild;
			currentType.nextSibling = type.nextSibling;
			currentType.extraIndex = type.extraIndex;
			currentType.align = type.align;
			currentType.signed = type.signed;
			currentType.typeType = type.typeType;
			currentType.byteSize = type.byteSize;
			ui16 size = type.byteSize;

			if lastInstructionType == _cANALYSER_INSTRTYPE_DEF_PARAM {
				i32 offset = offsets[_cVARIABLE_LOCATION_STACK];
				i32 newOffset = offset + size;
				offsets[_cVARIABLE_LOCATION_STACK] = newOffset;
				currentVar.offset = newOffset * -1;
				
				variables.Add(\currentVar);
				// mov [rbp-offset], param index
				// paramCount += 1
				if paramCount < 6 {
					MoveRBP(\textBytes, size * -1, callRegs[paramCount], size);
				} else {
					stdout.writeln("[Compiler]: TODO: More than 6 parameters for a function is not supported yet");
					SYS_EXIT(1);
				}
				paramCount += 1;
				DebugAddParameter(currentVar.name, currentVar.nameLength, currentVar.offset);
				DebugAddWithType(instruction.value);
				DebugEndChain();
			} else if lastInstructionType == _cANALYSER_INSTRTYPE_DEF_VAR {
				i32 offset = offsets[_cVARIABLE_LOCATION_STACK];
				i32 newOffset = offset + size;
				offsets[_cVARIABLE_LOCATION_STACK] = newOffset;
				currentVar.offset = newOffset * -1;
				
				variables.Add(\currentVar);
				DebugAddVariable(currentVar.name, currentVar.nameLength, currentVar.offset);
				DebugAddWithType(instruction.value);
				DebugEndChain();
			} else if lastInstructionType == _cANALYSER_INSTRTYPE_DEF_GLOBAL_VAR {
				currentVar.offset = offsets[_cVARIABLE_LOCATION_BSS];
				i32 offset = offsets[_cVARIABLE_LOCATION_BSS];
				i32 newOffset = offset + size;
				offsets[_cVARIABLE_LOCATION_BSS] = newOffset;
				
				bssBytes.AddToCount(size);
				variables.Add(\currentVar);
			} else if lastInstructionType == _cANALYSER_INSTRTYPE_DEF_ASSIGN_GLOBAL_VAR {
				currentVar.offset = offsets[_cVARIABLE_LOCATION_DATA];
				i32 offset = offsets[_cVARIABLE_LOCATION_DATA];
				i32 newOffset = offset + size;
				offsets[_cVARIABLE_LOCATION_DATA] = newOffset;

				variables.Add(\currentVar);
			} else if lastInstructionType == _cANALYSER_INSTRTYPE_DEF_FUNC {
				DebugAddWithType(instruction.value);
				DebugEndChain();
			} else {
				stdout.write("[Compiler]: Error: Unknown WITH_TYPE ");
				stdout.writeln(lastInstructionType);
				SYS_EXIT(1);
			}
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_INC {
			ui8[3] inc = {
				0x48, 0xFF, 0xC0
			}; // inc rax
			textBytes.AddBytes(\inc, 3);
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ADD {
			bool hasSecond = regsInUse[3];
			if !hasSecond {
				if stackVariables == 0 {
					stdout.writeln("[Compiler]: Error: No variable available for add");
					SYS_EXIT(1);
				}
				textBytes.AddByte(0x5B); // Pop rbx
			}
			ui8[3] add = {
				0x48, 0x01, 0xD8
			};
			textBytes.AddBytes(\add, 3);
			regsInUse[0] = true;
			regsInUse[3] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SUB {
			bool hasSecond = regsInUse[3];
			if !hasSecond {
				if stackVariables == 0 {
					stdout.writeln("[Compiler]: Error: No variable available for sub");
					SYS_EXIT(1);
				}
				textBytes.AddByte(0x5B); // Pop rbx
			}
			ui8[3] sub = {
				0x48, 0x29, 0xD8
			};
			textBytes.AddBytes(\sub, 3);
			regsInUse[0] = true;
			regsInUse[3] = false;
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_MULT {
			bool hasSecond = regsInUse[3];
			if !hasSecond {
				if stackVariables == 0 {
					stdout.writeln("[Compiler]: Error: No variable available for mul");
					SYS_EXIT(1);
				}
				textBytes.AddByte(0x5B); // Pop rbx
			}
			ui8[3] mul = {
				0x48, 0xF7, 0xE3
			}; // mul rbx
			textBytes.AddBytes(\mul, 3);
			regsInUse[0] = true;
			regsInUse[2] = true;
			regsInUse[3] = false;
		} else if (instruction.type) >= 100 {
			PrintInstr(instrPtr);

			// Debugging instructions
			// if !debug { skip; }
			ui8 debugByte = (instruction.type) - 100;
			ui64 newOpByte = textBytes.GetCount();
			ui64 opDiff = newOpByte - dbgLastOpcodeByte;
			ui64 lineDiff = 0;

			bool shouldAddLineInfo = false;
			bool shouldSkip = false;

			if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_BASIC_BLOCK {
				//lineInfoBytes.AddByte(0x07); // DW_LNS_set_basic_block
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_PROLOGUE_END {
				lineInfoBytes.AddByte(0x0a); // DW_LNS_set_prologue_end
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE {
				// Handled by statement
				/*
				lineInfoBytes.AddByte(_cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE - 100);
				ui32 value = instruction.value;
				lineInfoBytes.AddSLEB128(value);
				dbgLastLine += value;
				shouldSkip = true;
				*/
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_EPILOGUE_BEGIN {
				lineInfoBytes.AddByte(0x0b); // DW_LNS_set_epilogue_begin

				ref<Token> epiTokenPtr = tArr.At(instruction.value);
				Token epiToken = @epiTokenPtr;
				lineDiff = (epiToken.line) - dbgLastLine;
				dbgLastLine = epiToken.line;
				dbgLastOpcodeByte = newOpByte;
				
				shouldAddLineInfo = true;
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_COLUMN {
				lineInfoBytes.AddByte(0x05); // DW_LNS_set_column
				lineInfoBytes.AddByte(instruction.value);
				shouldSkip = true;
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_STATEMENT {
				ref<Token> stmtTokenPtr = tArr.At(instruction.value);
				Token stmtToken = @stmtTokenPtr;
				lineDiff = (stmtToken.line) - dbgLastLine;
				dbgLastLine = stmtToken.line;
				dbgLastOpcodeByte = newOpByte;
				shouldAddLineInfo = true;
			} else {
				stdout.write("[Compiler#CompileToELF64]: Error: Unhandled debugging instruction ");
				PrintInstr(instrPtr);
				SYS_EXIT(1);
			}
			if shouldSkip {
				skip;
			}

			
			if shouldAddLineInfo {
				if (opDiff == 0) & (lineDiff == 0) {
					skip;
				}
				DebugLineAddCode(opDiff, lineDiff, debugByte, \lineInfoBytes);
			}
		} else {
			stdout.write("[Compiler#CompileToELF64]: Error: Unexpected instruction ");
			PrintInstr(instrPtr);
			SYS_EXIT(1);
		}
		lastInstructionType = instruction.type;
		if instructionCounter != 0 {
			instructionCounter -= 1;
			if instructionCounter == 0 {
				ui64 currCount = textBytes.GetCount();
				ui8 relativeOffset = currCount - lastJumpState;
				textBytes.UpdateByte(lastJumpState, (relativeOffset - 1));
			}
		}
	}

	ui64 newOpByte = textBytes.GetCount();
	ui64 opDiff = newOpByte - dbgLastOpcodeByte;

	if opDiff > 0 {
		lineInfoBytes.AddByte(0x2); // DW_LNS_advance_pc
		lineInfoBytes.AddULEB128(opDiff);
		//lineInfoBytes.AddByte(0x1); // DW_LNS_copy
	}

	lineInfoBytes.AddByte(0);
	lineInfoBytes.AddULEB128(1);
	lineInfoBytes.AddByte(1); // DW_LNE_end_sequence

	loop i, 0..s_jump_count {
		ui64 byteToUpdate = s_undefined_jumps[i];
		ui64 labelValue = s_jump_labels[i];
		ui64 labelByteOffset = s_label_bytes[labelValue];
		i32 relativeOffset = labelByteOffset - (byteToUpdate + 4);
		textBytes.UpdateBytes(\relativeOffset, byteToUpdate, 4);
	}

	s_executable_code_size = textBytes.GetCount();
	s_debug_info.UpdateBytes(\s_executable_code_size, s_debug_info_high_pc, 8);
	
	strBytes.AddByte(0);
	ui64 stringTableOffset = 1;
	s_string_table_offsets[s_string_table_offsets_count] = stringTableOffset;
	s_string_table_offsets_count += 1;

	ui64 fileNameLength = GetLengthOfCstring(fileName);
	strBytes.AddBytes(fileName, fileNameLength + 1); // + 1 because of null byte

	stringTableOffset += (fileNameLength + 1);
	s_string_table_offsets[s_string_table_offsets_count] = stringTableOffset;
	s_string_table_offsets_count += 1;

	ui8[7] _start = {
		'_', 's', 't', 'a', 'r', 't', 0
	};
	strBytes.AddBytes(\_start, 7);

	stringTableOffset += 7;
	s_string_table_offsets[s_string_table_offsets_count] = stringTableOffset;
	s_string_table_offsets_count += 1;

	loop i, 0..s_token_index_array_count {
		ui64 tokenIndex = s_token_index_array[i];
		ref<Token> tokenPtr = tArr.At(tokenIndex);
		Token token = @tokenPtr;
		strBytes.AddBytes(token.text, token.textLength);
		strBytes.AddByte(0);

		stringTableOffset += ((token.textLength) + 1);
		s_string_table_offsets[s_string_table_offsets_count] = stringTableOffset;
		s_string_table_offsets_count += 1;
	}

	name = ".strtab";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \strBytes, nameOffset, _cSHT_STRTAB, 0, 0, 0, 0, 0 };
	ui64 stringTableIndex = sections.Add(\section);

	name = ".shstrtab";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \shstrBytes, nameOffset, _cSHT_STRTAB, 0, 0, 0, 0, 0 };
	ui64 sectionHeaderStringsIndex = sections.Add(\section);

	name = ".rodata";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \rodataBytes, nameOffset, _cSHT_PROGBITS, _cSHF_ALLOC, 0, 0, 1, 0 };
	ui64 rodataIndex = sections.Add(\section);

	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), rodataIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolRoData = localSymbolCount;

	name = ".data";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \dataBytes, nameOffset, _cSHT_PROGBITS, _cSHF_WRITE | _cSHF_ALLOC, 0, 0, 1, 0 };
	ui64 dataIndex = sections.Add(\section);

	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), dataIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolData = localSymbolCount;

	name = ".bss";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \bssBytes, nameOffset, _cSHT_NOBITS, _cSHF_WRITE | _cSHF_ALLOC, 0, 0, 1, 0 };
	ui64 bssIndex = sections.Add(\section);

	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), bssIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolBss = localSymbolCount;

	name = ".debug_info";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, s_debug_info, nameOffset, _cSHT_PROGBITS, 0, 0, 0, 1, 0 };
	ui64 debugInfoIndex = sections.Add(\section);

	name = ".debug_abbrev";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, s_debug_abbrev, nameOffset, _cSHT_PROGBITS, 0, 0, 0, 1, 0 };
	ui64 debugAbbrevIndex = sections.Add(\section);

	ui32 lineInfoLength = lineInfoBytes.GetCount() - 4;
	lineInfoBytes.UpdateBytes(\lineInfoLength, 0, 4);
	name = ".debug_line";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \lineInfoBytes, nameOffset, _cSHT_PROGBITS, 0, 0, 0, 1, 0 };
	ui64 debugLineIndex = sections.Add(\section);


	// .debug_info
	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), debugInfoIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolDebugInfo = localSymbolCount;

	// .debug_abbrev
	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), debugAbbrevIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolDebugAbbrev = localSymbolCount;

	// .debug_line
	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), debugLineIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolDebugLine = localSymbolCount;

	// .debug_aranges
	DebugAddAranges(\relaDebugArangesBytes, symbolDebugInfo);
	name = ".debug_aranges";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \arangesBytes, nameOffset, _cSHT_PROGBITS, 0, 0, 0, 1, 0 };
	ui64 debugArangesIndex = sections.Add(\section);

	AddSymbolTableEntry(\symBytes, 0, GetSymbolInfo(_cSTB_LOCAL, _cSTT_SECTION), debugArangesIndex, 0, 0);
	localSymbolCount += 1;
	ui64 symbolDebugAranges = localSymbolCount;

	// _start
	AddSymbolTableEntry(\symBytes, s_string_table_offsets[1], GetSymbolInfo(_cSTB_GLOBAL, _cSTT_NOTYPE), textIndex, 0, 0);

	// Loop over functions and add them to the symbol table
	loop i, 0..s_token_index_array_count {
		ui64 byteOffset = s_func_byte_offsets[i];
		AddSymbolTableEntry(\symBytes, s_string_table_offsets[i + 2], GetSymbolInfo(_cSTB_GLOBAL, _cSTT_FUNC), textIndex, byteOffset, 0);
	}

	Elf64RelocationAddendEntry relaEntry = {
		8, // offset to Abbreviation table in CU header
		GetRelocationInfo(symbolDebugAbbrev, 0xa),
		0 // addend 0
	};
	relaDebugInfoBytes.AddBytes(\relaEntry, 0x18);

	relaEntry.offset = s_relocation_offsets[1];
	relaEntry.info = GetRelocationInfo(symbolDebugLine, 0xa);
	relaDebugInfoBytes.AddBytes(\relaEntry, 0x18);

	relaEntry.offset = lineRelaState;
	relaEntry.info = GetRelocationInfo(s_symbol_text, 0x1);
	relaEntry.addend = 46;
	relaDebugLineBytes.AddBytes(\relaEntry, 0x18);

	ui64 textRelaEntryCount = s_comp_rela.GetCount();
	loop i, 0..textRelaEntryCount {
		ref<CompRelaEntry> entryPtr = s_comp_rela.At(i);
		CompRelaEntry entry = @entryPtr;
		relaEntry.offset = entry.offset;
		relaEntry.addend = entry.addend;
		
		if (entry.srcSectionType) == _cCOMPILATION_SECTION_DATA {
			relaEntry.info = GetRelocationInfo(symbolData, 0xa);
		} else {
			ui16 srcSection = entry.srcSectionType;
			stdout.write("[Compiler#CompileElf64]: Error: Unknown relocation source section ");
			stdout.writeln(srcSection);
			SYS_EXIT(1);
		}

		if (entry.destSectionType) == _cCOMPILATION_SECTION_TEXT {
			relaTextBytes.AddBytes(\relaEntry, 0x18);
		} else {
			ui16 destSection = entry.destSectionType;
			stdout.write("[Compiler#CompileElf64]: Error: Unknown relocation destination section ");
			stdout.writeln(destSection);
			SYS_EXIT(1);
		}
		
	}
	
	name = ".symtab";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \symBytes, nameOffset, _cSHT_SYMTAB, 0, stringTableIndex, localSymbolCount + 1, 8, 0x18 };
	ui64 symbolTableIndex = sections.Add(\section);

	name = ".rela.text";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \relaTextBytes, nameOffset, _cSHT_RELA, 0, symbolTableIndex, textIndex, 8, 0x18 };
	ui64 relaTextIndex = sections.Add(\section);

	name = ".rela.debug_info";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \relaDebugInfoBytes, nameOffset, _cSHT_RELA, 0, symbolTableIndex, debugInfoIndex, 8, 0x18 };
	ui64 relaDebugInfoIndex = sections.Add(\section);

	name = ".rela.debug_line";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \relaDebugLineBytes, nameOffset, _cSHT_RELA, 0, symbolTableIndex, debugLineIndex, 8, 0x18 };
	ui64 relaDebugLineIndex = sections.Add(\section);

	name = ".rela.debug_aranges";
	nameLength = GetLengthOfCstring(name);
	nameOffset = shstrBytes.AddBytes(name, nameLength + 1);
	section = { name, nameLength + 1, \relaDebugArangesBytes, nameOffset, _cSHT_RELA, 0, symbolTableIndex, debugArangesIndex, 8, 0x18 };
	ui64 relaDebugArangesIndex = sections.Add(\section);

	FinishDebugInfo();
	
	ui64 sectionCount = sections.GetCount();
	loop i, 0..sectionCount {
		byteCount = bytes.GetCount();
		s_section_offsets[i] = byteCount;

		ref<Section> secPtr = sections.At(i);
		Section sec = @secPtr;
		SYS_WRITE(1, sec.name, sec.nameLength);
		stdout.write("\n");
		if (sec.type) != _cSHT_NOBITS {	
			ref<ByteArr> secBytesPtr = sec.bytes;
			if secBytesPtr == 0 {
				stdout.write("[Compiler#CompileToElf64:loop_sections]: Error: Section bytes are null. Section:\nName: ");
				SYS_WRITE(1, sec.name, sec.nameLength);
				SYS_EXIT(1);
			}
			ui64 secBytesCount = secBytesPtr.GetCount();
			ref<ui8> firstByte = secBytesPtr.At(0);
			bytes.AddBytes(firstByte, secBytesCount);
			byteCount = bytes.GetCount();
			ui8 padding = (16 - (byteCount % 16)) % 16;
			bytes.AddSame(0, padding);
		}
	}

	ui64 startOfSectionHeaders = bytes.GetCount();
	Elf64SectionHeader section0 = {
		0, // No name
		0, // Inactive
		0, // No flags
		0, // No address,
		0, // No offset
		0, // No size
		0, // No linking
		0, // No extra info
		0, // No alignment
		0 // No entrySize
	};
	bytes.AddBytes(\section0, 64);

	loop i, 0..sectionCount {
		ref<Section> secPtr = sections.At(i);
		Section sec = @secPtr;
		ui64 secOffset = s_section_offsets[i];
		ref<ByteArr> secBytesPtr = sec.bytes;
		ui64 secSize = secBytesPtr.GetCount();
		ui64 nameOff = sec.nameOffset;
		
		Elf64SectionHeader sectionHeader = {
			nameOff,
			sec.type,
			sec.flags,
			0,
			secOffset,
			secSize,
			sec.link,
			sec.info,
			sec.addressAlign,
			sec.entrySize
		};
		bytes.AddBytes(\sectionHeader, 64);
	}

	header.sectionHeaderOffset = startOfSectionHeaders;

	header.sectionHeaderEntryCount = sectionCount + 1;
	header.sectionHeaderStringTableIndex = sectionHeaderStringsIndex;
	bytes.UpdateBytes(\header, 0, 64);
	
	SYS_WRITE(fd, bytes.bytes, bytes.count);
}


ui8 main(cstring[] argv) {
	DynArray tokens = {0, 0, 0, s_sizeof_Token};
	tokens.New(1024);
	i32 fd = SYS_OPEN(argv[1], 0, 0);
	ui32 lengthOfFile = GetLengthOfCstring(argv[1]);
	if fd < 0 {
		stdout.writeln("Could not open file: ");
		SYS_WRITE(1, argv[1], lengthOfFile);
		return -1;
	}
	ui64 fileSize = SYS_LSEEK(fd, 0, 2);
	SYS_LSEEK(fd, 0, 0);
	ref<ui8> source = alloc(fileSize);

	ui64 sizeRead = SYS_READ(fd, source, fileSize);
	if (sizeRead == 0) {
		stdout.writeln("Could not read from file");
		return -1;
	}
	// HACK: The file descriptor SHOULDNT be above 9, so we can just convert it to an ascii char
	ui8[16] procPath = { '/', 'p', 'r', 'o', 'c', '/', 's', 'e', 'l', 'f', '/', 'f', 'd', '/', fd + '0', 0 };

	ui64 length = SYS_READLINK(\procPath, \s_file_name, 256);
	s_file_name[length] = 0;
	SYS_CLOSE(fd);
	Tokenise(\tokens, source, sizeRead, \s_file_name);
	ui64 tokenCount = tokens.count;

	DynArray nodes = {0, 0, 0, s_sizeof_Node};
	nodes.New(tokenCount);
	DynArray types = {0, 0, 0, s_sizeof_Type};
	types.New(256);
	SetupTypeArray(\types);

	DynArray structs = {0, 0, 0, s_sizeof_Struct};
	structs.New(256);
	s_struct_array = \structs;

	DynArray fields = {0, 0, 0, s_sizeof_Field};
	fields.New(256);
	s_field_array = \fields;

	DynArray enums = {0, 0, 0, s_sizeof_Enum};
	enums.New(256);
	s_enum_array = \enums;

	DynArray parserVars = {0, 0, 0, s_sizeof_ParserVariable};
	parserVars.New(256);
	s_parser_variables_array = \parserVars;

	Parse(\tokens, \nodes, \types);

	PrintASTAsDot(\tokens, \nodes);

	DynArray instructions = {0, 0, 0, s_sizeof_Instr};
	instructions.New(tokenCount * 2);
	Analyse(\tokens, \nodes, \types, \instructions);
	PrintInstrArray(\instructions);

	ref<ui8> outputFile = alloc(lengthOfFile + 2);
	memcopy2(outputFile, argv[1], lengthOfFile);
	outputFile[lengthOfFile] = '.';
	outputFile[lengthOfFile + 1] = 'o';
	i32 outputFd = SYS_CREAT(outputFile, 420); // 0o644
	if outputFd < 0 {
		stdout.writeln("Could not open output file");
		return -1;
	}
	CompileToELF64(\tokens, \nodes, \types, \instructions, outputFd, \s_file_name);
	SYS_CLOSE(outputFd);

	return 0;
}
