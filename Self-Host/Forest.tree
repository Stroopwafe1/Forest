ui64[1024] s_token_index_array;
ui16 s_token_index_array_count = 0;
ui64[1024] s_func_byte_offsets;
ui64[1024] s_label_bytes;
ui64[1024] s_string_table_offsets;
ui16 s_string_table_offsets_count = 0;

void memcopy2(ref<ui8> dest, ref<ui8> src, ui64 bytes) {
	loop i, 0..bytes {
		dest[i] = src[i];
	}
}

void memcopy(ref<ui8> destination, ref<ui8> source, ui64 bytes) {
	// First copy over every 8 bytes, and then individual bytes
	ref<ui64> resizedDest = destination;
	ref<ui64> resizedSrc = source;
	ui64 size = bytes / 8;
	loop i, 0..size {
		resizedDest[i] = resizedSrc[i];
	}
	loop i, 0..bytes % 8 {
		destination[(size * 8) + i] = source[i];
	}
}

bool StrEquals(ref<ui8> s1, ref<ui8> s2, ui64 length) {
	loop i, 0..length {
		if s1[i] != s2[i] {
			return false;
		}
	}
	return true;
}

ui16 GetLengthOfCstring(ref<ui8> input) {
	ui32 it = 0;
	loop {
		ui8 byte = input[it];
		if byte != 0 {
			it += 1;
		} else {
			return it;
		}
	}
	return 0;
}

ui64 StringToUI64(ref<ui8> text, ui64 textLength) {
	ui64 returnValue = 0;
	ui64 multiplier = 1;
	loop i, 1..textLength + 1 {
		ui64 it = textLength - i;
		ui8 byte = text[it];
		returnValue += ((byte - '0') * multiplier);
		multiplier *= 10;
	}
	return returnValue;
}

struct Token {
	ui16 type;
	ui32 line;
	ui32 column;
	ref<ui8> file;
	ref<ui8> text;
	ui64 textLength;
}

void PrintToken(ref<Token> token) {
	Token t = @token;
	ui16 lengthOfFile = GetLengthOfCstring(t.file);
	stdout.write("'");
	SYS_WRITE(1, t.text, t.textLength);
	stdout.write("' at ");
	SYS_WRITE(1, t.file, lengthOfFile);
	stdout.write(":");
	ui32 line = t.line;
	stdout.write(line);
	ui32 column = t.column;
	stdout.write(":");
	stdout.writeln(column);
}

class DynArray {
	ui64 size;
	ui64 count;
	ref<ui8> data;
	ui64 entrySize;

	void New(ui64 _size) {
		size = _size;
		data = alloc((size * entrySize) + entrySize);
		count = 0;
	}

	void Add(ref<ui8> entry) {
		if (count + 1) == size {
			ui64 s = size * 2;
			ref<ui8> newRef = alloc(s + 1);
			memcopy2(newRef, data, count);
			dealloc(data, count);
			data = newRef;
			size = s;
		}
		memcopy2(data + (count * entrySize), entry, entrySize);
		ui64 c = count;
		c += 1;
		count = c;
	}

	ref<ui8> At(ui64 index) {
		if index > count {
			stdout.writeln("[Error]: Dynamic Array index out of bounds");
			SYS_EXIT(1);
		}
		return data + (index * entrySize);
	}

	ui64 GetCount() {
		return count;
	}
}

void Tokenise(ref<DynArray> tokens, ref<ui8> source, ui64 sourceLength, ref<ui8> file) {
	Token currentToken = {1, 1, 0, file, 0, 0};
	ui64 start = 0;
	ui16 currentType = 0;
	ui64 textLength = 0;
	ui32 line = 1;
	loop i, 0..sourceLength {
		start += 1;
		ui8 byte = source[i];
		if (currentType == _cTOKENTYPE_STRING) & (byte != '"') {
			textLength += 1;
			skip;
		} else if (currentType == _cTOKENTYPE_CHAR) & (byte != 39) {
			textLength += 1;
			skip;
		} else if currentType == _cTOKENTYPE_MULTILINE_COMMENT {
			if (byte == '*') & (source[i + 1] == '/') {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				textLength = 0;
				currentType = 0;
				i += 1;
				skip;
			} else {
				textLength += 1;
				skip;
			}
		} else if (currentType == _cTOKENTYPE_SINGLELINE_COMMENT) & (byte != 10) {
			textLength += 1;
			skip;
		}

		if (byte >= '0') & (byte <= '9') {
			if currentType == _cTOKENTYPE_NONE {
				currentType = _cTOKENTYPE_INTEGER;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			} else if currentType <= _cTOKENTYPE_CHAR {
				textLength += 1;
			} else if currentType == _cTOKENTYPE_NONE {
				currentType = _cTOKENTYPE_INTEGER;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			} else if currentType == _cTOKENTYPE_MINUS {
				currentType = _cTOKENTYPE_INTEGER;
				textLength += 1;
			}  else if currentType == _cTOKENTYPE_KEYWORD_IDENTIFIER {
				textLength += 1;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_INTEGER;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '.' {
			if currentType == _cTOKENTYPE_FLOAT {
				currentToken.type = _cTOKENTYPE_INTEGER;
				currentToken.textLength = textLength - 1;
				EndToken(tokens, \currentToken);
				currentToken.type = _cTOKENTYPE_RANGE;
				currentToken.text = source + (i - 1);
				currentToken.column = start - 1;
				currentToken.textLength = 2;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_NONE;
				textLength = 0;
			} else if currentType == _cTOKENTYPE_DOT {
				currentToken.type = _cTOKENTYPE_RANGE;
				currentToken.textLength = textLength + 1;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_NONE;
				textLength = 0;
			} else if currentType == _cTOKENTYPE_INTEGER {
				currentType = _cTOKENTYPE_FLOAT;
				textLength += 1;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_DOT;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '/' {
			if currentType == _cTOKENTYPE_DIVIDE {
				currentType = _cTOKENTYPE_SINGLELINE_COMMENT;
				currentToken.text = (source + i) + 1;
				textLength = 0;
				currentToken.column = start + 1;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_DIVIDE;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '-' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_MINUS;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '+' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_PLUS;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '@' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_DEREFERENCE;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '!' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_NOT;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '~' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_NEGATE;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '(' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_PARENTHESIS_OPEN;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == ')' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_PARENTHESIS_CLOSE;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == 123 { // Opening '{'
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_CURLY_OPEN;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '}' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_CURLY_CLOSE;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '[' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_SQUARE_OPEN;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == ']' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_SQUARE_CLOSE;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == ',' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_COMMA;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '^' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_XOR;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '#' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_MACRO;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '%' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_MODULUS;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if byte == '=' {
			if ((currentType >= _cTOKENTYPE_MINUS) & (currentType <= _cTOKENTYPE_BOOL_AND)) | (currentType == _cTOKENTYPE_ASSIGNMENT) {
				currentToken.type = currentType + _cTOKENTYPE_ASSIGNMENT;
				currentToken.textLength = textLength + 1;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_ASSIGNMENT;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == ':' {
			if currentType == _cTOKENTYPE_COLON {
				currentToken.textLength = textLength + 1;
				currentToken.type = _cTOKENTYPE_NAMESPACE;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_COLON;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '|' {
			if currentType == _cTOKENTYPE_OR {
				textLength += 1;
				currentToken.type = _cTOKENTYPE_BOOL_OR;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_OR;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '&' {
			if currentType == _cTOKENTYPE_AND {
				textLength += 1;
				currentToken.type = _cTOKENTYPE_BOOL_AND;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_MODULUS;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '*' {
			if currentType == _cTOKENTYPE_MULTIPLY {
				currentToken.type = _cTOKENTYPE_POWER_OF;
				currentToken.textLength = textLength + 1;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			} else if currentType == _cTOKENTYPE_DIVIDE {
				currentType = _cTOKENTYPE_MULTILINE_COMMENT;
				currentToken.text = (source + i) + 1;
				currentToken.column = start + 1;
				textLength = 0;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_MULTIPLY;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '>' {
			if currentType == _cTOKENTYPE_GREATER_THAN {
				textLength += 1;
				currentToken.type = _cTOKENTYPE_SHIFT_RIGHT;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_GREATER_THAN;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '<' {
			if currentType == _cTOKENTYPE_LESS_THAN {
				textLength += 1;
				currentToken.type = _cTOKENTYPE_SHIFT_LEFT;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_LESS_THAN;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == '"' {
			if currentType == _cTOKENTYPE_STRING {
				currentToken.type = currentType;
				currentToken.textLength = textLength - 1;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_STRING;
				currentToken.column = start;
				currentToken.text = (source + i) + 1;
				textLength = 1;
			}
		} else if byte == 39 { // single quote
			if currentType == _cTOKENTYPE_CHAR {
				if textLength > 1 {
					stdout.write("[Tokeniser]: Character literal length longer than 1 character at ");
					ui32 lengthOfFile = GetLengthOfCstring(file);
					SYS_WRITE(1, file, lengthOfFile);
					stdout.write(":");
					stdout.write(line);
					ui32 column = currentToken.column;
					stdout.write(":");
					stdout.writeln(column);
					SYS_EXIT(1);
				}
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_CHAR;
				currentToken.column = start;
				currentToken.text = (source + i) + 1;
				textLength = 0;
			}
		} else if byte == 92 { // '\'
			if currentType == _cTOKENTYPE_STRING {
				currentType = _cTOKENTYPE_ESCAPE_STRING;
			} else if currentType == _cTOKENTYPE_CHAR {
				currentType = _cTOKENTYPE_ESCAPE_CHAR;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_REFERENCE_OF;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else if byte == ';' {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = _cTOKENTYPE_SEMICOLON;
			currentToken.column = start;
			currentToken.text = source + i;
			textLength = 1;
		} else if (byte == 32) | (byte == 9) { // ' ' or '\t'
			if ((currentType == _cTOKENTYPE_SINGLELINE_COMMENT) | (currentType == _cTOKENTYPE_MULTILINE_COMMENT)) | ((currentType == _cTOKENTYPE_STRING) | (currentType == _cTOKENTYPE_CHAR)) {
				textLength += 1;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = 0;
				textLength = 0;
			}
		} else if byte == 10 {
			currentToken.type = currentType;
			currentToken.textLength = textLength;
			EndToken(tokens, \currentToken);
			currentType = 0;
			line += 1;
			currentToken.line = line;
			start = 0;
			textLength = 0;
		} else if ((byte == 'x') | (byte == 'o')) | (((byte >= 'a') & (byte <= 'f')) | ((byte >= 'A') & (byte <= 'F'))) {
			if currentType == _cTOKENTYPE_INTEGER {
				textLength += 1;
			} else if currentType == _cTOKENTYPE_KEYWORD_IDENTIFIER {
				textLength += 1;
			} else {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_KEYWORD_IDENTIFIER;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			}
		} else {
			if currentType != _cTOKENTYPE_KEYWORD_IDENTIFIER {
				currentToken.type = currentType;
				currentToken.textLength = textLength;
				EndToken(tokens, \currentToken);
				currentType = _cTOKENTYPE_KEYWORD_IDENTIFIER;
				currentToken.column = start;
				currentToken.text = source + i;
				textLength = 1;
			} else {
				textLength += 1;
			}
		}
	}
	currentToken.type = currentType;
	currentToken.textLength = textLength;
	EndToken(tokens, \currentToken);
}

void EndToken(ref<DynArray> tokens, ref<Token> token) {
	Token t = @token;
	if (((t.type) != _cTOKENTYPE_NONE) & ((t.type) != _cTOKENTYPE_SINGLELINE_COMMENT)) & ((t.type) != _cTOKENTYPE_MULTILINE_COMMENT) {
		tokens.Add(token);
	}
}

struct Type {
	i32 firstChild;
	i32 nextSibling;
	//i32 extraIndex; // Extra index is to index into the structs/classes array, depending on the TypeType. Structs/Classes will have the name of the struct/class. Name is not necessary for the base types.
	ui16 byteSize;
	i16 align;
	bool signed;
	ui8 typeType; // VOID, UI8, UI16, UI32, UI64, I8, I16, I32, I64, F8, F16, F32, F64, BOOL, CHAR, REF, ARRAY, STRUCT, CLASS
} // (size 14)

class Node {
	i32 firstChild;
	i32 nextSibling;
	ui16 type;
	i32 typeIndex;
	ui64 tokenIndex;

	void SetNS(i32 ns) {
		nextSibling = ns;
	}

	void SetFC(i32 fc) {
		firstChild = fc;
	}

	ui64 GetFC() {
		return firstChild;
	}

	ui64 GetTokenIndex() {
		return tokenIndex;
	}

	void PrintNode() {
		stdout.write("Node: FC(");
		stdout.write(firstChild);
		stdout.write(") NS(");
		stdout.write(nextSibling);
		stdout.write(") Type(");
		stdout.write(type);
		stdout.write(") TypeIndex(");
		stdout.write(typeIndex);
		stdout.write(") TokenIndex(");
		stdout.write(tokenIndex);
		stdout.write(")");
	}
}// (size 22)

class NodeArr {
	ui64 size;
	ui64 count;
	ref<Node> nodes;

	void New(ui64 _size) {
		size = _size;
		nodes = alloc((size * 22) + 22);
		count = 0;
	}

	void AddNode(ref<Node> node) {
		// If count exceeded size, realloc and move
		if (count + 1) == size {
			ui64 s = size * 2;
			ui64 c = count + 1;
			ref<Node> newRef = alloc((s * 22) + 22);
			memcopy2(newRef, nodes, count * 22);
			dealloc(nodes, (size * 22) + 22);
			nodes = newRef;
			memcopy2(newRef + (count * 22), node, 22);
			size = s;
			count = c;
		} else {
			ui64 c = count;
			memcopy2(nodes + (count * 22), node, 22);
			c += 1;
			count = c;
		}
	}

	void DeleteLast() {
		ui64 c = count - 1;
		count = c;
	}

	ui64 GetCount() {
		return count;
	}

	void UpdateNS(ui64 index, i32 ns) {
		ref<Node> node = nodes + (index * 22);
		node.SetNS(ns);
	}

	void UpdateFC(ui64 index, i32 fc) {
		ref<Node> node = nodes + (index * 22);
		node.SetFC(fc);
	}

	ref<Node> At(ui64 index) {
		return nodes + (index * 22);
	}

	ref<Node> Pop() {
		ref<Node> returnValue = nodes + ((count - 1) * 22);
		ui64 c = count - 1;
		count = c;
		return returnValue;
	}

	void UndoPop() {
		ui64 c = count + 1;
		count = c;
	}
}

ui64 GetTypeIndexFromName(ref<DynArray> typArr, ref<Token> t) {
	Token token = @t;
	bool equals = StrEquals(token.text, "ui8", 3);
	if equals {
		return _cPARSER_TYPETYPE_UI8;
	}
	equals = StrEquals(token.text, "ui16", 4);
	if equals {
		return _cPARSER_TYPETYPE_UI16;
	}
	equals = StrEquals(token.text, "ui32", 4);
	if equals {
		return _cPARSER_TYPETYPE_UI32;
	}
	equals = StrEquals(token.text, "ui64", 4);
	if equals {
		return _cPARSER_TYPETYPE_UI64;
	}
	equals = StrEquals(token.text, "i8", 2);
	if equals {
		return _cPARSER_TYPETYPE_I8;
	}
	equals = StrEquals(token.text, "i16", 3);
	if equals {
		return _cPARSER_TYPETYPE_I16;
	}
	equals = StrEquals(token.text, "i32", 3);
	if equals {
		return _cPARSER_TYPETYPE_I32;
	}
	equals = StrEquals(token.text, "i64", 3);
	if equals {
		return _cPARSER_TYPETYPE_I64;
	}
	equals = StrEquals(token.text, "f8", 2);
	if equals {
		return _cPARSER_TYPETYPE_F8;
	}
	equals = StrEquals(token.text, "f16", 3);
	if equals {
		return _cPARSER_TYPETYPE_F16;
	}
	equals = StrEquals(token.text, "f32", 3);
	if equals {
		return _cPARSER_TYPETYPE_F32;
	}
	equals = StrEquals(token.text, "f64", 3);
	if equals {
		return _cPARSER_TYPETYPE_F64;
	}
	equals = StrEquals(token.text, "bool", 4);
	if equals {
		return _cPARSER_TYPETYPE_BOOL;
	}
	equals = StrEquals(token.text, "char", 4);
	if equals {
		return _cPARSER_TYPETYPE_CHAR;
	}
	equals = StrEquals(token.text, "void", 4);
	if equals {
		return _cPARSER_TYPETYPE_VOID;
	}
	return 15;
}

ref<ui8> GetNameFromTypeIndex(ui64 typeType) {
	if typeType == _cPARSER_TYPETYPE_VOID {
		return "void";
	} else if typeType == _cPARSER_TYPETYPE_UI8 {
		return "ui8";
	} else if typeType == _cPARSER_TYPETYPE_UI16 {
		return "ui16";
	} else if typeType == _cPARSER_TYPETYPE_UI32 {
		return "ui32";
	} else if typeType == _cPARSER_TYPETYPE_UI64 {
		return "ui64";
	} else if typeType == _cPARSER_TYPETYPE_I8 {
		return "i8";
	} else if typeType == _cPARSER_TYPETYPE_I16 {
		return "i16";
	} else if typeType == _cPARSER_TYPETYPE_I32 {
		return "i32";
	} else if typeType == _cPARSER_TYPETYPE_I64 {
		return "i64";
	} else if typeType == _cPARSER_TYPETYPE_F8 {
		return "f8";
	} else if typeType == _cPARSER_TYPETYPE_F16 {
		return "f16";
	} else if typeType == _cPARSER_TYPETYPE_F32 {
		return "f32";
	} else if typeType == _cPARSER_TYPETYPE_F64 {
		return "f64";
	} else if typeType == _cPARSER_TYPETYPE_BOOL {
		return "bool";
	} else if typeType == _cPARSER_TYPETYPE_CHAR {
		return "char";
	}
	return "";
}

bool IsTokenSpecifiedType(ref<DynArray> tArr, ui64 offset, ui16 desiredType) {
	DynArray tokens = @tArr;
	if offset >= (tokens.count) {
		return false;
	}
	ref<Token> t = tArr.At(offset);
	Token token = @t;
	return (token.type) == desiredType;
}

// Returns how much to increment i by
// TODO: We do nothing with the child types if recursing from ref< or array<
ui16 ParseType(ref<DynArray> tArr, ref<DynArray> typeArr, ui64 offset) {
	DynArray tokens = @tArr;
	DynArray typesArr = @typeArr;
	ui64 tokenCount = tokens.count;
	// id [<? ]>?
	ref<Token> t = tArr.At(offset);
	Token token = @t;

	ui64 ttype = token.type;
	if (ttype != _cTOKENTYPE_KEYWORD_IDENTIFIER) {
		stdout.write("[Parser]: Expected a type identifier but got ");
		PrintToken(t);
		SYS_EXIT(1);
		return 0;
	}
	ui16 returnVal = 1;
	ui64 childTypeIndex = GetTypeIndexFromName(typeArr, t);
	// if childType == 15, it's not a primitive type
	ref<Type> childTypePtr = typeArr.At(childTypeIndex);
	Type childType = @childTypePtr;

	t = tArr.At(offset + 1);
	Token nextToken = @t;
	ttype = nextToken.type;
	if ttype == _cTOKENTYPE_SQUARE_OPEN {
		bool isNextLiteral = IsTokenSpecifiedType(tArr, offset + 2, _cTOKENTYPE_INTEGER);
		Type typ = {
			childTypeIndex,
			-1,
			childType.byteSize,
			childType.align,
			false,
			_cPARSER_TYPETYPE_ARRAY
		};

		if childTypeIndex >= 15 {
			stdout.writeln("[Parser]: Non-primitive type arrays are not implemented yet");
			SYS_EXIT(1);
		}

		if isNextLiteral {
			bool isNextClosingSquare = IsTokenSpecifiedType(tArr, offset + 3, _cTOKENTYPE_SQUARE_CLOSE);
			if !isNextClosingSquare {
				stdout.write("[Parser]: Expected an integer or ']' but got ");
				PrintToken(t);
				SYS_EXIT(1);
			}
			ui64 value = find_ui64_in_string(token.text);
			typ.byteSize = (childType.byteSize) * value;
			returnVal += 3;
		} else {
			bool isNextClosingSquare = IsTokenSpecifiedType(tArr, offset + 2, _cTOKENTYPE_SQUARE_CLOSE);
			if !isNextClosingSquare {
				stdout.write("[Parser]: Expected an integer or ']' but got ");
				PrintToken(t);
				SYS_EXIT(1);
			}
			returnVal += 2;
		}
		typeArr.Add(\typ);
	}
	else if ttype == _cTOKENTYPE_LESS_THAN {
		bool isRef = StrEquals(token.text, "ref", 3);
		bool isArr = StrEquals(token.text, "array", 5);
		ui64 typeCount = typeArr.GetCount();
		if isRef {
			Type typ = {
				typeCount + 1,
				-1,
				8,
				8,
				false,
				_cPARSER_TYPETYPE_REF
			};
			typeArr.Add(\typ);
		} else if isArr {
			Type typ = {
				typeCount + 1,
				-1,
				8,
				8,
				false,
				_cPARSER_TYPETYPE_ARRAY
			};
			typeArr.Add(\typ);
		}
		ui16 depth = ParseType(tArr, typeArr, offset + 2);
		bool hasClosing = IsTokenSpecifiedType(tArr, (offset + 2) + depth, _cTOKENTYPE_GREATER_THAN);
		if !hasClosing {
			stdout.write("[Parser]: Unbalanced angle brackets, expected a '>' to close the ");
			PrintToken(\token);
			stdout.write(" but got ");
			ref<Token> unexpected = tArr.At((offset + 2) + depth);
			PrintToken(unexpected);
			SYS_EXIT(1);
		}
		returnVal += (2 + depth);
	} else {
		return returnVal;
	}

	return returnVal;
}

ui64 ParseExpressionProperty(ref<DynArray> tArr, ref<NodeArr> nodeArr, ui64 offset, ui64 max) {

	return 0;
}

bool IsOperator(ref<Token> tokenPtr) {
	Token token = @tokenPtr;
	if ((token.type) >= _cTOKENTYPE_MINUS) & ((token.type) <= _cTOKENTYPE_BOOL_AND) {
		return true;
	}
	ui16 assignmentType = (token.type) ^ _cTOKENTYPE_ASSIGNMENT;
	if (assignmentType >= _cTOKENTYPE_MINUS) & (assignmentType <= _cTOKENTYPE_BOOL_AND) {
		return true;
	} else if (token.type) == _cTOKENTYPE_EQUALITY {
		return true;
	}
	return false;
}

ui64[128] s_expression_indices;
ui64 s_expression_indices_count = 0;
ui64[128] s_expression_stack;
ui64 s_expression_stack_count = 0;
ui8[150] s_precedences;

// TODO(#3): Just really expand on this; Try to actually make a kind of tree, give different expression types, EXPR_VARIABLE, EXPR_PROPERTY, EXPR_FUNC_CALL, EXPR_INIT_LIST, EXPR_CLASS_FUNC_CALL
// It would be nice if I could build a tree without the spamming of parentheses, but it's the most important that these above get grouped together first.
// Because I want to have EXPR_FUNC_CALL EXPRESSION(+) EXPRESSION, instead of EXPRESSION(ident) EXPRESSION(open_paren) EXPRESSION(arg) EXPRESSION(close_paren) EXPRESSION(+) EXPRESSION
ui64 ParseExpression(ref<DynArray> tArr, ref<NodeArr> nodeArr, ui64 offset, ui64 max, ui16 endType) {
	ui64 returnValue = 0;
	Node currentNode = { 0, 0, 0, 0, 0 };
	NodeArr nodes = @nodeArr;
	ui64 startCount = nodeArr.GetCount();
	loop i, offset..max {
		bool end = IsTokenSpecifiedType(tArr, i, endType);
		bool isNextEnd = IsTokenSpecifiedType(tArr, i + 1, endType);
		bool isNextMax = (i + 1) == max;
		if end {
			returnValue = i - offset;
			break;
		}
		bool isIdentifier = IsTokenSpecifiedType(tArr, i, _cTOKENTYPE_KEYWORD_IDENTIFIER);
		if isIdentifier {
			bool isProperty = false;
			// FUNC_CALL is always identifier + paren_open
			// PROPERTY is always dot + identifier + NOT(id, paren, square)
			// VARIABLE is any identifier not FUNC_CALL or PROPERTY
			// ARRAY_INDEX is nested expression, out of scope for now
			ui64 prevType = _cTOKENTYPE_KEYWORD_IDENTIFIER;
			bool shouldSkip = false;
			loop j, i + 1..max + 1 {
				ref<Token> nextTokenPtr = tArr.At(j);
				Token nextToken = @nextTokenPtr;

				bool isNextDot = false;
				if (nextToken.type) == _cTOKENTYPE_DOT {
					isNextDot = true;
					isProperty = true;
				}
				bool isNextIdentifier = (nextToken.type) == _cTOKENTYPE_KEYWORD_IDENTIFIER;
				bool isNextNamespace = (nextToken.type) == _cTOKENTYPE_NAMESPACE;
				bool isNextParen = (nextToken.type) == _cTOKENTYPE_PARENTHESIS_OPEN;
				bool isNextArr = (nextToken.type) == _cTOKENTYPE_SQUARE_OPEN;
				// if it's none of these, break;
				bool oneOfThese = ((isNextDot | isNextIdentifier) | (isNextNamespace | isNextParen));
				if !oneOfThese {
					if isProperty {
						ui64 toSkip = ParseExpressionProperty(tArr, nodeArr, i, j); // TODO(#4): Make this function
						i += toSkip;
						returnValue += toSkip;
						shouldSkip = true;
					} else {
						// Is just a variable
						currentNode.type = _cPARSER_NODETYPE_EXPRESSION_VARIABLE;
						currentNode.firstChild = -1;
						if isNextEnd | isNextMax {
							currentNode.nextSibling = -1;
						} else {
							ui64 nodeCount = nodeArr.GetCount();
							currentNode.nextSibling = nodeCount + 1;
						}
						currentNode.typeIndex = -1;
						currentNode.tokenIndex = i;
						nodeArr.AddNode(\currentNode);
						shouldSkip = true;
						returnValue += 1;
					}
					break;
				}
				if (prevType == _cTOKENTYPE_KEYWORD_IDENTIFIER) & isNextParen {
					currentNode.type = _cPARSER_NODETYPE_EXPRESSION_FUNC_CALL;
					ui64 nodeCount = nodeArr.GetCount();
					ui64 exprNodeState = nodeCount;
					currentNode.firstChild = nodeCount + 1;
					currentNode.typeIndex = -1;
					currentNode.tokenIndex = i;
					nodeArr.AddNode(\currentNode);

					ui64 toSkip = ParseFunctionCall(tArr, nodeArr, i, true);
					i += toSkip;
					returnValue += toSkip;
					shouldSkip = true;

					nodeCount = nodeArr.GetCount();
					isNextEnd = IsTokenSpecifiedType(tArr, i + 1, endType);
					isNextMax = (i + 1) == max;
					if isNextEnd | isNextMax {
						nodeArr.UpdateNS(exprNodeState, -1);
					} else {
						nodeArr.UpdateNS(exprNodeState, nodeCount);
					}
					break;
				}
				prevType = nextToken.type;
			}
			if shouldSkip {
				skip;
			}
		}
		currentNode.type = _cPARSER_NODETYPE_EXPRESSION;
		currentNode.firstChild = -1;
		if isNextEnd | isNextMax {
			currentNode.nextSibling = -1;
		} else {
			ui64 nodeCount = nodeArr.GetCount();
			currentNode.nextSibling = nodeCount + 1;
		}
		currentNode.typeIndex = -1;
		currentNode.tokenIndex = i;
		nodeArr.AddNode(\currentNode);
		returnValue += 1;
	}
	ui64 endCount = nodeArr.GetCount();
	nodeArr.UpdateNS(endCount - 1, -1);

	s_precedences[_cTOKENTYPE_MINUS] = 10;
	s_precedences[_cTOKENTYPE_PLUS] = 10;
	s_precedences[_cTOKENTYPE_MULTIPLY] = 20;
	s_precedences[_cTOKENTYPE_POWER_OF] = 30;
	s_precedences[_cTOKENTYPE_DIVIDE] = 20;
	s_precedences[_cTOKENTYPE_MODULUS] = 20;
	s_precedences[_cTOKENTYPE_XOR] = 40;
	s_precedences[_cTOKENTYPE_OR] = 40;
	s_precedences[_cTOKENTYPE_AND] = 40;
	s_precedences[_cTOKENTYPE_NOT] = 40;
	s_precedences[_cTOKENTYPE_NEGATE] = 40;
	s_precedences[_cTOKENTYPE_LESS_THAN] = 6;
	s_precedences[_cTOKENTYPE_SHIFT_LEFT] = 35;
	s_precedences[_cTOKENTYPE_GREATER_THAN] = 6;
	s_precedences[_cTOKENTYPE_SHIFT_RIGHT] = 35;
	s_precedences[_cTOKENTYPE_REFERENCE_OF] = 45;
	s_precedences[_cTOKENTYPE_DEREFERENCE] = 45;
	s_precedences[_cTOKENTYPE_BOOL_OR] = 3;
	s_precedences[_cTOKENTYPE_BOOL_AND] = 3;
	s_precedences[_cTOKENTYPE_NOT | _cTOKENTYPE_ASSIGNMENT] = 5;
	s_precedences[_cTOKENTYPE_EQUALITY] = 5;
	s_precedences[_cTOKENTYPE_LESS_THAN | _cTOKENTYPE_ASSIGNMENT] = 6;
	s_precedences[_cTOKENTYPE_GREATER_THAN | _cTOKENTYPE_ASSIGNMENT] = 6;

	ui64 it = startCount;
	s_expression_indices_count = 0;
	s_expression_stack_count = 0;

	loop {
		ref<Node> expressionPtr = nodeArr.At(it);
		Node expression = @expressionPtr;
		ref<Token> tokenPtr = tArr.At(expression.tokenIndex);
		Token token = @tokenPtr;
		bool isOperator = IsOperator(tokenPtr);

		if ((token.type) == _cTOKENTYPE_INTEGER) | ((token.type) == _cTOKENTYPE_KEYWORD_IDENTIFIER) {
			s_expression_indices[s_expression_indices_count] = it;
			s_expression_indices_count += 1;
		} else if (token.type) == _cTOKENTYPE_PARENTHESIS_OPEN {
			s_expression_stack[s_expression_stack_count] = it;
			s_expression_stack_count += 1;
		} else if (token.type) == _cTOKENTYPE_PARENTHESIS_CLOSE {
			s_expression_stack_count -= 1;
			ui64 topIndex = s_expression_stack[s_expression_stack_count];
			loop {
				ref<Node> topNodePtr = nodeArr.At(topIndex);
				ui64 tokenIndex = topNodePtr.GetTokenIndex();
				ref<Token> topTokenPtr = tArr.At(tokenIndex);
				Token topToken = @topTokenPtr;
				if (topToken.type) == _cTOKENTYPE_PARENTHESIS_CLOSE {
					break;
				}
				s_expression_indices[s_expression_indices_count] = topIndex;
				s_expression_indices_count += 1;
				s_expression_stack_count -= 1;
				topIndex = s_expression_stack[s_expression_stack_count];
			}
		} else {
			loop {
				if s_expression_stack_count > 0 {
					ui64 topIndex = s_expression_stack[s_expression_stack_count - 1];
					ref<Node> topNodePtr = nodeArr.At(topIndex);
					ui64 tokenIndex = topNodePtr.GetTokenIndex();
					ref<Token> topTokenPtr = tArr.At(tokenIndex);
					Token topToken = @topTokenPtr;
					ui8 precedence = s_precedences[topToken.type];
					ui8 tokenPrecedence = s_precedences[token.type];
					if precedence >= tokenPrecedence {
						s_expression_stack_count -= 1;
						s_expression_indices[s_expression_indices_count] = topIndex;
						s_expression_indices_count += 1;
					} else {
						break;
					}
				} else {
					break;
				}
			}
			s_expression_stack[s_expression_stack_count] = it;
			s_expression_stack_count += 1;
		}

		if (expression.nextSibling) == -1 {
			break;
		}
		it = expression.nextSibling;
	}

	loop c, 0..s_expression_stack_count {
		s_expression_stack_count -= 1;
		ui64 index = s_expression_stack[s_expression_stack_count];
		s_expression_indices[s_expression_indices_count] = index;
		s_expression_indices_count += 1;
	}

	// Reverse the array
	loop r, 0..s_expression_indices_count {
		ui64 swapIndex = (s_expression_indices_count - 1) - r;
		if r >= swapIndex {
			break;
		}
		ui64 a = s_expression_indices[r];
		ui64 b = s_expression_indices[swapIndex];
		s_expression_indices[r] = b;
		s_expression_indices[swapIndex] = a;
	}

	// We have the expressions in postfix notation in a stack
	// Update next siblings for all
	// Update main node array
	s_expression_indices_count -= 1;
	ui64 index = s_expression_indices[s_expression_indices_count];
	nodeArr.UpdateFC(startCount - 1, index);

	loop c, 0..s_expression_indices_count {
		ui64 toIndex = s_expression_indices[(s_expression_indices_count - c) - 1];
		nodeArr.UpdateNS(index, toIndex);
		index = toIndex;
	}

	nodeArr.UpdateNS(index, -1);
	return returnValue;
}

ui64 ParseFunctionCall(ref<DynArray> tArr, ref<NodeArr> nodeArr, ui64 offset, bool asExpr) {
	DynArray tokens = @tArr;

	ui64 nodeCount = nodeArr.GetCount();
	Node currentNode = {
		.type = _cPARSER_NODETYPE_FUNCTION_CALL;
		.firstChild = nodeCount + 1;
		.nextSibling = -1;
		.tokenIndex = offset;
		.typeIndex = -1;
	};
	ui64 funcCallNodeState = nodeCount;
	nodeArr.AddNode(\currentNode);
	ui64 toSkip = 0;

	loop j, offset..tokens.count {
		ui16 localToSkip = 0;
		ref<Token> funcCallTokenPtr = tArr.At(j);
		Token funcCallToken = @funcCallTokenPtr;
		if (funcCallToken.type) == _cTOKENTYPE_PARENTHESIS_OPEN {
			break;
		}
		bool equals = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_PARENTHESIS_OPEN);
		if equals {
			nodeCount = nodeArr.GetCount();
			currentNode.type = _cPARSER_NODETYPE_FUNCTION;
			currentNode.firstChild = nodeCount + 1; // Argument list is child of function
			currentNode.nextSibling = -1;
			currentNode.tokenIndex = j;
			currentNode.typeIndex = -1;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;
			break;
		}
		equals = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_NAMESPACE);
		if equals {
			nodeCount = nodeArr.GetCount();
			currentNode.type = _cPARSER_NODETYPE_NAMESPACE;
			currentNode.firstChild = -1;
			currentNode.nextSibling = nodeCount + 1;
			currentNode.tokenIndex = j;
			currentNode.typeIndex = -1;
			nodeArr.AddNode(\currentNode);
			localToSkip += 1;
		}
		equals = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_DOT);
		if equals {
			nodeCount = nodeArr.GetCount();
			currentNode.type = _cPARSER_NODETYPE_CLASS;
			currentNode.firstChild = -1;
			currentNode.nextSibling = nodeCount + 1;
			currentNode.tokenIndex = j;
			currentNode.typeIndex = -1;
			nodeArr.AddNode(\currentNode);
			localToSkip += 1;
		}
		j += localToSkip;
		toSkip += (localToSkip + 1);
	}
	bool assert = IsTokenSpecifiedType(tArr, offset + toSkip, _cTOKENTYPE_PARENTHESIS_OPEN);
	if !assert {
		stdout.writeln("ParseFunctionCall failed assertion - Not opening parenthesis");
		ref<Token> wrongToken = tArr.At(offset + toSkip);
		PrintToken(wrongToken);
		SYS_EXIT(1);
	}

	nodeCount = nodeArr.GetCount();
	currentNode.type = _cPARSER_NODETYPE_ARG_LIST;
	currentNode.firstChild = nodeCount + 1;
	currentNode.nextSibling = -1;
	currentNode.tokenIndex = toSkip + offset;
	currentNode.typeIndex = -1;
	ui64 argListState = nodeArr.GetCount();
	nodeArr.AddNode(\currentNode);
	toSkip += 1; // Skip paren open

	// Following loop is necessary to detect end of argument parsing. We try parsing until a ',' but if there's only one argument it would parse too much.
	// That's why we look up what the matching closing parenthesis is and only parse the expression until that point.
	ui64 matchingParen = 0;
	ui64 parenCount = 1;

	loop j, offset + toSkip..tokens.count {
		// Count opening and closing parentheses, if count gets to 0, we found it
		bool isOpen = IsTokenSpecifiedType(tArr, j, _cTOKENTYPE_PARENTHESIS_OPEN);
		if isOpen {
			parenCount += 1;
		} else {
			bool isClose = IsTokenSpecifiedType(tArr, j, _cTOKENTYPE_PARENTHESIS_CLOSE);
			if isClose {
				parenCount -= 1;
				if parenCount == 0 {
					matchingParen = j;
					break;
				}
			}
		}
	}

	bool hasNoArgument = IsTokenSpecifiedType(tArr, offset + toSkip, _cTOKENTYPE_PARENTHESIS_CLOSE);
	if !hasNoArgument {
		// If we have arguments. Function call wasn't 'foo();'
		loop j, offset + toSkip..tokens.count {
			nodeCount = nodeArr.GetCount();
			ui16 localToSkip = 0;

			currentNode.type = _cPARSER_NODETYPE_ARGUMENT;
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.tokenIndex = offset + toSkip;
			currentNode.typeIndex = -1;
			ui64 argNodeState = nodeCount;
			nodeArr.AddNode(\currentNode);

			localToSkip += ParseExpression(tArr, nodeArr, j, matchingParen, _cTOKENTYPE_COMMA);
			bool hasNextArgument = (j + localToSkip) != matchingParen;
			if hasNextArgument {
				nodeCount = nodeArr.GetCount();
				nodeArr.UpdateNS(argNodeState, nodeCount);
				toSkip += 1;
			} else {
				nodeArr.UpdateNS(argNodeState, -1);
				toSkip += localToSkip;
				break;
			}
			j += localToSkip;
			toSkip += localToSkip;
		}
	} else {
		nodeArr.UpdateFC(argListState, -1);
	}
	assert = IsTokenSpecifiedType(tArr, offset + toSkip, _cTOKENTYPE_PARENTHESIS_CLOSE);
	if !assert {
		stdout.writeln("ParseFunctionCall failed assertion - Not closing parenthesis");
		ref<Token> wrongToken = tArr.At(offset + toSkip);
		PrintToken(wrongToken);
		SYS_EXIT(1);
	}
	if !asExpr {
		toSkip += 1; // skip closing parenthesis, so toSkip is pointing at the semicolon now

		bool hasSemi = IsTokenSpecifiedType(tArr, (toSkip + offset), _cTOKENTYPE_SEMICOLON);
		if !hasSemi {
			stdout.write("[Parser]: Expected a ';' to close the statement but got ");
			ref<Token> notSemi = tArr.At(toSkip + offset);
			PrintToken(notSemi);
			SYS_EXIT(1);
		}
	}

	nodeCount = nodeArr.GetCount();
	if asExpr {
		nodeArr.UpdateNS(funcCallNodeState, -1);
	} else {
		nodeArr.UpdateNS(funcCallNodeState, nodeCount);
	}
	return toSkip;
}

ui64 ParseVarAssignment(ref<DynArray> tArr, ref<NodeArr> nodeArr, ui64 offset) {
	DynArray tokens = @tArr;
	// First, find the '(' or any of the '=' e.g. '+=' '/=' '*=' etc...
	bool isAssignment = false;
	ui64 assignmentIndex = 0;
	loop j, offset+1..tokens.count {
		ref<Token> assignTokenPtr = tArr.At(j);
		Token assignToken = @assignTokenPtr;
		if ((assignToken.type) & _cTOKENTYPE_ASSIGNMENT) == _cTOKENTYPE_ASSIGNMENT {
			isAssignment = true;
			assignmentIndex = j;
			break;
		} else if (assignToken.type) == _cTOKENTYPE_PARENTHESIS_OPEN {
			break;
		}
	}
	if !isAssignment {
		return 0;
	}

	ui64 nodeCount = nodeArr.GetCount();
	Node currentNode = {
		.type = _cPARSER_NODETYPE_VARIABLE_ASSIGNMENT;
		.firstChild = nodeCount + 1;
		.nextSibling = 0;
		.typeIndex = -1;
		.tokenIndex = offset;
	};

	ui64 currentNodeState = nodeCount;
	nodeArr.AddNode(\currentNode);
	ui64 toSkip = 1;

	// very.nested.array[39 + 30].property.also.should.be.supported = true
	if assignmentIndex > offset {
		loop j, offset+1..assignmentIndex {
			ui64 localToSkip = 0;
			bool isProperty = IsTokenSpecifiedType(tArr, j, _cTOKENTYPE_DOT);
			bool isArrayIndex = IsTokenSpecifiedType(tArr, j, _cTOKENTYPE_SQUARE_OPEN);
			bool id = IsTokenSpecifiedType(tArr, j+1, _cTOKENTYPE_KEYWORD_IDENTIFIER);

			if isProperty {
				bool continuesProp = IsTokenSpecifiedType(tArr, j+2, _cTOKENTYPE_DOT);
				bool continuesIndex = IsTokenSpecifiedType(tArr, j+2, _cTOKENTYPE_SQUARE_OPEN);
				currentNode.type = _cPARSER_NODETYPE_PROPERTY;
				currentNode.firstChild = -1;
				nodeCount = nodeArr.GetCount();
				if continuesProp | continuesIndex {
					currentNode.nextSibling = nodeCount + 1;
				} else {
					currentNode.nextSibling = -1;
				}
				currentNode.typeIndex = -1;
				currentNode.tokenIndex = j + 1;
				nodeArr.AddNode(\currentNode);
				localToSkip += 1;
			} else if isArrayIndex {
				bool continuesProp = IsTokenSpecifiedType(tArr, j+2, _cTOKENTYPE_DOT);
				bool continuesIndex = IsTokenSpecifiedType(tArr, j+2, _cTOKENTYPE_SQUARE_OPEN);
				currentNode.type = _cPARSER_NODETYPE_INDEX;
				nodeCount = nodeArr.GetCount();
				currentNode.firstChild = nodeCount + 1;
				if continuesProp | continuesIndex {
					currentNode.nextSibling = 0;
				} else {
					currentNode.nextSibling = -1;
				}
				currentNode.typeIndex = -1;
				currentNode.tokenIndex = j;
				nodeCount = nodeArr.GetCount();
				ui64 nodeState = nodeCount;
				nodeArr.AddNode(\currentNode);
				localToSkip += ParseExpression(tArr, nodeArr, j + 1, assignmentIndex, _cTOKENTYPE_SQUARE_CLOSE);

				if continuesProp | continuesIndex {
					nodeCount = nodeArr.GetCount();
					nodeArr.UpdateNS(nodeState, nodeCount);
				}
			} else {
				break;
			}
			j += localToSkip;
			toSkip += localToSkip;
		}
	}

	nodeCount = nodeArr.GetCount();
	currentNode.type = _cPARSER_NODETYPE_ASSIGNMENT;
	currentNode.firstChild = nodeCount + 1;
	currentNode.nextSibling = -1;
	currentNode.typeIndex = -1;
	currentNode.tokenIndex = offset + toSkip;
	nodeArr.AddNode(\currentNode);
	toSkip += 1;

	toSkip += ParseExpression(tArr, nodeArr, offset + toSkip, tokens.count, _cTOKENTYPE_SEMICOLON);
	nodeCount = nodeArr.GetCount();
	nodeArr.UpdateNS(currentNodeState, nodeCount);
	return toSkip;
}

ui64 ParseVarDeclaration(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset) {
	DynArray types = @typeArr;
	DynArray tokens = @tArr;
	ui64 currType = types.count;
	ui64 toSkip = ParseType(tArr, typeArr, offset);
	ref<Token> token = tArr.At(offset);
	ui64 ttypeIndex = GetTypeIndexFromName(typeArr, token);
	if ttypeIndex == 15 {
		ttypeIndex = currType;
	}
	ref<Token> assignTokenPtr = tArr.At((offset + toSkip) + 1);
	Token assignToken = @assignTokenPtr;

	Node currentNode = {0, 0, 0, 0, 0};
	currentNode.typeIndex = ttypeIndex;
	currentNode.tokenIndex = offset + toSkip;
	ui64 nodeCount = nodeArr.GetCount();
	if ((assignToken.type) & _cTOKENTYPE_ASSIGNMENT) == _cTOKENTYPE_ASSIGNMENT {
		currentNode.type = _cPARSER_NODETYPE_VARIABLE_DECLARATION_ASSIGNMENT;
		currentNode.firstChild = nodeCount + 1;
		currentNode.nextSibling = 0;
		ui64 nodeState = nodeCount;
		nodeArr.AddNode(\currentNode);
		toSkip += 1;

		nodeCount = nodeArr.GetCount();
		currentNode.type = _cPARSER_NODETYPE_ASSIGNMENT;
		currentNode.firstChild = nodeCount + 1;
		currentNode.nextSibling = -1;
		currentNode.typeIndex = -1;
		currentNode.tokenIndex = offset + toSkip;
		nodeArr.AddNode(\currentNode);
		toSkip += 1;

		toSkip += ParseExpression(tArr, nodeArr, offset + toSkip, tokens.count, _cTOKENTYPE_SEMICOLON);
		nodeCount = nodeArr.GetCount();
		nodeArr.UpdateNS(nodeState, nodeCount);
	} else {
		currentNode.type = _cPARSER_NODETYPE_VARIABLE_DECLARATION;
		currentNode.firstChild = -1;
		nodeCount = nodeArr.GetCount();
		currentNode.nextSibling = nodeCount + 1;
		nodeArr.AddNode(\currentNode);
	}

	bool hasSemi = IsTokenSpecifiedType(tArr, offset + toSkip, _cTOKENTYPE_SEMICOLON);
	if !hasSemi {
		stdout.write("[Parser]: Expected a ';' to close the statement but got ");
		ref<Token> notSemi = tArr.At(offset + toSkip);
		PrintToken(notSemi);
		SYS_EXIT(1);
	}
	return toSkip;
}

// ParseBody parses until the matching '}'. Its returnValue is the offset from given offset to that matching bracket
ui64 ParseBody(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset) {
	DynArray tokens = @tArr;
	DynArray types = @typeArr;
	bool hasBody = IsTokenSpecifiedType(tArr, offset, _cTOKENTYPE_CURLY_OPEN);
	if !hasBody {
		stdout.write("[Parser]: Expected a '{' for the body but got ");
		ref<Token> bodyToken = tArr.At(offset);
		PrintToken(bodyToken);
		SYS_EXIT(1);
	}
	ui64 nodeCount = nodeArr.GetCount();
	Node currentNode = { nodeCount + 1, -1, _cPARSER_NODETYPE_BLOCK, -1, offset };
	ui64 lastStatementState = nodeCount;
	nodeArr.AddNode(\currentNode);
	ui64 returnVal = 1;

	bool hasElse = false;
	loop i, offset + 1..tokens.count {
		ref<Token> nextTokenPtr = tArr.At(i);
		Token nextToken = @nextTokenPtr;
		currentNode.tokenIndex = i;
		ui64 toSkip = 0;
		if hasElse {
			if (nextToken.type) == _cTOKENTYPE_CURLY_OPEN {
				hasElse = false;
				currentNode.type = _cPARSER_NODETYPE_ELSE;
				nodeCount = nodeArr.GetCount();
				currentNode.firstChild = nodeCount + 1;
				currentNode.nextSibling = 0;
				currentNode.typeIndex = -1;
				currentNode.tokenIndex = i - 1;
				ui64 nodeState = nodeCount;
				lastStatementState = nodeCount;
				nodeArr.AddNode(\currentNode);
				toSkip += ParseBody(tArr, nodeArr, typeArr, i);
				nodeCount = nodeArr.GetCount();
				nodeArr.UpdateNS(nodeState, nodeCount);

				i += toSkip;
				returnVal += (toSkip + 1);
				skip;
			}
			bool isIf = StrEquals(nextToken.text, "if", 2);
			if !isIf {
				stdout.write("[Parser]: Expected a '{' or 'if' after 'else' but got ");
				PrintToken(nextTokenPtr);
				SYS_EXIT(1);
			}
		}

		// Scoped blocks
		if (nextToken.type) == _cTOKENTYPE_CURLY_OPEN {
			toSkip += ParseBody(tArr, nodeArr, typeArr, i);
			i += toSkip;
			returnVal += toSkip;
			skip;
		}

		if (nextToken.type) == _cTOKENTYPE_CURLY_CLOSE {
			nodeArr.UpdateNS(lastStatementState, -1);
			break;
		}

		bool equals = StrEquals(nextToken.text, "return", 6);
		if equals {
			currentNode.type = _cPARSER_NODETYPE_RETURN;
			nodeCount = nodeArr.GetCount();
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			ui64 nodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;

			toSkip += ParseExpression(tArr, nodeArr, i + toSkip, tokens.count, _cTOKENTYPE_SEMICOLON);
			bool hasSemi = IsTokenSpecifiedType(tArr, i + toSkip, _cTOKENTYPE_SEMICOLON);
			if !hasSemi {
				stdout.write("[Parser]: Expected a ';' to close the statement but got ");
				ref<Token> notSemi = tArr.At(i + toSkip);
				PrintToken(notSemi);
				SYS_EXIT(1);
			}
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}

		equals = StrEquals(nextToken.text, "break", 5);
		if equals {
			currentNode.type = _cPARSER_NODETYPE_BREAK;
			currentNode.firstChild = -1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			nodeCount = nodeArr.GetCount();
			ui64 nodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;
			bool hasSemi = IsTokenSpecifiedType(tArr, i + toSkip, _cTOKENTYPE_SEMICOLON);
			if !hasSemi {
				stdout.write("[Parser]: Expected a ';' to close the statement but got ");
				ref<Token> notSemi = tArr.At(i + toSkip);
				PrintToken(notSemi);
				SYS_EXIT(1);
			}
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}

		equals = StrEquals(nextToken.text, "skip", 4);
		if equals {
			currentNode.type = _cPARSER_NODETYPE_SKIP;
			currentNode.firstChild = -1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			nodeCount = nodeArr.GetCount();
			ui64 nodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;
			bool hasSemi = IsTokenSpecifiedType(tArr, i + toSkip, _cTOKENTYPE_SEMICOLON);
			if !hasSemi {
				stdout.write("[Parser]: Expected a ';' to close the statement but got ");
				ref<Token> notSemi = tArr.At(i + toSkip);
				PrintToken(notSemi);
				SYS_EXIT(1);
			}
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}

		equals = StrEquals(nextToken.text, "if", 2);
		if equals {
			if hasElse {
				currentNode.type = _cPARSER_NODETYPE_ELSE_IF;
				hasElse = false;
			} else {
				currentNode.type = _cPARSER_NODETYPE_IF;
			}
			nodeCount = nodeArr.GetCount();
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			ui64 nodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;

			nodeCount = nodeArr.GetCount();
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i + toSkip;
			currentNode.type = _cPARSER_NODETYPE_CONDITION;
			ui64 condNodeState = nodeCount;
			nodeArr.AddNode(\currentNode);

			toSkip += ParseExpression(tArr, nodeArr, i + 1, tokens.count, _cTOKENTYPE_CURLY_OPEN);

			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(condNodeState, nodeCount);

			if toSkip == 1 {
				stdout.write("[Parser]: Expected an expression for the ");
				PrintToken(nextTokenPtr);
				SYS_EXIT(1);
			}

			toSkip += ParseBody(tArr, nodeArr, typeArr, i + toSkip);
			bool assert = IsTokenSpecifiedType(tArr, i + toSkip, _cTOKENTYPE_CURLY_CLOSE);
			if !assert {
				stdout.writeln("Failed assert - parse body failed");
				ref<Token> debugT = tArr.At(i + toSkip);
				PrintToken(debugT);
				SYS_EXIT(1);
			}
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}
		equals = StrEquals(nextToken.text, "else", 4);
		if equals {
			hasElse = true;
			returnVal += 1;
			// Rest of code is handled at start loop or if
			skip;
		}

		equals = StrEquals(nextToken.text, "loop", 4);
		if equals {
			// Parse unconditional loop
			currentNode.type = _cPARSER_NODETYPE_LOOP;
			nodeCount = nodeArr.GetCount();
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			ui64 loopNodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;

			bool isSimpleLoop = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_CURLY_OPEN);
			if isSimpleLoop {
				toSkip += ParseBody(tArr, nodeArr, typeArr, i + 1);
			} else {
				bool hasVariable = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_KEYWORD_IDENTIFIER);
				if !hasVariable {
					stdout.write("[Parser]: Expected a variable identifier for the ");
					PrintToken(nextTokenPtr);
					SYS_EXIT(1);
				}
				nodeCount = nodeArr.GetCount();
				currentNode.type = _cPARSER_NODETYPE_VARIABLE_DECLARATION;
				currentNode.firstChild = -1;
				currentNode.nextSibling = nodeCount + 1;
				currentNode.typeIndex = 0;
				currentNode.tokenIndex = i + 1;
				nodeArr.AddNode(\currentNode);
				toSkip += 1;

				bool hasStep = IsTokenSpecifiedType(tArr, i + 2, _cTOKENTYPE_COLON);

				if hasStep {
					nodeCount = nodeArr.GetCount();
					currentNode.type = _cPARSER_NODETYPE_RANGE_STEP;
					currentNode.firstChild = nodeCount + 1;
					currentNode.nextSibling = 0;
					currentNode.typeIndex = -1;
					currentNode.tokenIndex = i + 2;
					ui64 stepNodeState = nodeCount;
					nodeArr.AddNode(\currentNode);
					toSkip += 1;

					toSkip += ParseExpression(tArr, nodeArr, i + 2, tokens.count, _cTOKENTYPE_COMMA);
					nodeCount = nodeArr.GetCount()
					nodeArr.UpdateNS(stepNodeState, nodeCount);
				}
				toSkip += 1; // Skip comma

				nodeCount = nodeArr.GetCount();
				currentNode.type = _cPARSER_NODETYPE_RANGE_MIN;
				currentNode.firstChild = nodeCount + 1;
				currentNode.nextSibling = 0;
				currentNode.typeIndex = -1;
				currentNode.tokenIndex = i + toSkip;
				ui64 rangeMinNodeState = nodeCount;
				nodeArr.AddNode(\currentNode);
				toSkip += ParseExpression(tArr, nodeArr, i + toSkip, tokens.count, _cTOKENTYPE_RANGE);
				nodeCount = nodeArr.GetCount();
				nodeArr.UpdateNS(rangeMinNodeState, nodeCount);
				toSkip += 1; // Skip range

				currentNode.type = _cPARSER_NODETYPE_RANGE_MAX;
				currentNode.firstChild = nodeCount + 1;
				currentNode.nextSibling = 0;
				currentNode.typeIndex = -1;
				currentNode.tokenIndex = i + toSkip;
				nodeCount = nodeArr.GetCount();
				nodeArr.AddNode(\currentNode);
				ui64 rangeMaxNodeState = nodeCount;
				toSkip += ParseExpression(tArr, nodeArr, i + toSkip, tokens.count, _cTOKENTYPE_CURLY_OPEN);
				nodeCount = nodeArr.GetCount();
				nodeArr.UpdateNS(rangeMaxNodeState, nodeCount);

				toSkip += ParseBody(tArr, nodeArr, typeArr, i + toSkip);
			}
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(loopNodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}
		equals = StrEquals(nextToken.text, "until", 5);
		if equals {
			nodeCount = nodeArr.GetCount();
			currentNode.type = _cPARSER_NODETYPE_UNTIL;
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i;
			ui64 nodeState = nodeCount;
			lastStatementState = nodeCount;
			nodeArr.AddNode(\currentNode);
			toSkip += 1;

			nodeCount = nodeArr.GetCount();
			currentNode.firstChild = nodeCount + 1;
			currentNode.nextSibling = 0;
			currentNode.typeIndex = -1;
			currentNode.tokenIndex = i + toSkip;
			currentNode.type = _cPARSER_NODETYPE_CONDITION;
			ui64 condNodeState = nodeCount;
			nodeArr.AddNode(\currentNode);

			toSkip += ParseExpression(tArr, nodeArr, i + 1, tokens.count, _cTOKENTYPE_CURLY_OPEN);

			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(condNodeState, nodeCount);

			toSkip += ParseBody(tArr, nodeArr, typeArr, i + toSkip);
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeState, nodeCount);
			i += toSkip;
			returnVal += (toSkip + 1);
			skip;
		}

		bool isIdentifier = IsTokenSpecifiedType(tArr, i, _cTOKENTYPE_KEYWORD_IDENTIFIER);
		bool hasSecondIdent = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_KEYWORD_IDENTIFIER);
		bool isGeneric = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_LESS_THAN);
		bool isArray = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_SQUARE_OPEN);
		bool isArrayType = false;

		if isArray {
			loop j, i + 2..tokens.count {
				bool closing = IsTokenSpecifiedType(tArr, j, _cTOKENTYPE_SQUARE_CLOSE);
				bool ident = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_KEYWORD_IDENTIFIER);
				if closing & ident {
					isArrayType = true;
					break;
				}
			}
		}

		if isIdentifier {
			if (hasSecondIdent | isGeneric) | isArrayType {
				// We are doing var declaration
				nodeCount = nodeArr.GetCount();
				lastStatementState = nodeCount;
				toSkip += ParseVarDeclaration(tArr, nodeArr, typeArr, i);
			} else {
				nodeCount = nodeArr.GetCount();
				lastStatementState = nodeCount;
				ui64 isAssignment = ParseVarAssignment(tArr, nodeArr, i);

				if isAssignment != 0 {
					toSkip += isAssignment;
				} else {
					toSkip += ParseFunctionCall(tArr, nodeArr, i, false);
				}
			}
		}

		i += toSkip;
		returnVal += toSkip;
		returnVal += 1;
	}
	return returnVal;
}

ui64 ParseFunction(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset) {
	DynArray tokens = @tArr;
	DynArray types = @typeArr;
	ref<Token> token = tArr.At(offset);

	ui64 currType = types.count;
	ui64 returnVal = ParseType(tArr, typeArr, offset);
	ui64 typeIndex = GetTypeIndexFromName(typeArr, token);
	if typeIndex == 15 {
		typeIndex = currType;
	}

	ref<Token> functionToken = tArr.At(offset + returnVal);
	ui64 nodeCount = nodeArr.GetCount();
	Node currentNode = { nodeCount + 1, 0, _cPARSER_NODETYPE_FUNCTION, typeIndex, offset + returnVal };
	returnVal += 1; // Skip function name
	bool isSyntaxCorrect = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_PARENTHESIS_OPEN);
	if !isSyntaxCorrect {
		ref<Token> t = tArr.At(offset + returnVal);
		// This never happens as we only call this function when we have detected (
		stdout.write("[Parser]: Expected '(' for function definition but got ");
		PrintToken(t);
		SYS_EXIT(1);
	}

	ui64 nodeState = nodeCount;
	nodeArr.AddNode(\currentNode);

	bool hasNoParameters = IsTokenSpecifiedType(tArr, (offset + returnVal) + 1, _cTOKENTYPE_PARENTHESIS_CLOSE);
	if !hasNoParameters {
		nodeCount = nodeArr.GetCount();
		currentNode.firstChild = nodeCount + 1;
		currentNode.nextSibling = 0;
		currentNode.type = _cPARSER_NODETYPE_PARAM_LIST;
		currentNode.typeIndex = -1;
		currentNode.tokenIndex = offset + returnVal;
		ui64 paramNodeState = nodeCount;
		nodeArr.AddNode(\currentNode);
		returnVal += 1; // Skip open paren

		// Parse param list... type name, type name, etc...
		loop i, offset + returnVal..tokens.count {
			ui64 typeCount = typeArr.GetCount();
			ui16 toIncrease = ParseType(tArr, typeArr, i);
			token = tArr.At(i);
			typeIndex = GetTypeIndexFromName(typeArr, token);
			if typeIndex == 15 {
				typeIndex = typeCount;
			}

			i += toIncrease;
			returnVal += toIncrease;
			toIncrease = 0;
			currentNode.firstChild = -1;
			bool hasComma = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_COMMA);
			nodeCount = nodeArr.GetCount();
			if hasComma {
				currentNode.nextSibling = nodeCount + 1;
				toIncrease = 1;
			} else {
				currentNode.nextSibling = -1;
			}
			currentNode.type = _cPARSER_NODETYPE_VARIABLE_DECLARATION;
			currentNode.typeIndex = typeIndex;
			currentNode.tokenIndex = i;
			nodeArr.AddNode(\currentNode);
			returnVal += 1;
			bool hasClosing = IsTokenSpecifiedType(tArr, i + 1, _cTOKENTYPE_PARENTHESIS_CLOSE);
			if hasClosing {
				returnVal += 1;
				break;
			}

			if ((!hasComma) & (!hasClosing)) {
				stdout.write("[Parser]: Expected a ',' or ')' inside the parameter list of function definition ");
				PrintToken(functionToken);
				SYS_EXIT(1);
			}
			i += toIncrease;
			returnVal += 1;
		}
		nodeCount = nodeArr.GetCount();
		nodeArr.UpdateNS(paramNodeState, nodeCount);
	} else {
		returnVal += 2; // Skip both open and close paren
	}

	bool hasBody = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_CURLY_OPEN);
	if !hasBody {
		stdout.write("[Parser]: Expected a '{' for the body of function definition but got ");
		ref<Token> bodyToken = tArr.At(offset + returnVal);
		PrintToken(bodyToken);
		SYS_EXIT(1);
	}
	nodeCount = nodeArr.GetCount();
	ui64 bodyNodeState = nodeCount;
	returnVal += ParseBody(tArr, nodeArr, typeArr, offset + returnVal);
	nodeArr.UpdateNS(bodyNodeState, -1);
	nodeCount = nodeArr.GetCount();
	nodeArr.UpdateNS(nodeState, nodeCount);

	return returnVal;
}

ui64 ParseFieldList(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset) {
	ui64 tokenCount = tArr.GetCount();
	ui64 returnVal = 0;
	Node currentNode = {0, 0, 0, 0, 0};
	ui64 lastPropertyState = 0;

	loop i, offset..tokenCount {
		ref<Token> token = tArr.At(i);
		bool isClosing = IsTokenSpecifiedType(tArr, i, _cTOKENTYPE_CURLY_CLOSE);
		bool shouldExit = false;
		if isClosing {
			break;
		}

		ui64 currType = typeArr.GetCount();
		ui64 toSkip = ParseType(tArr, typeArr, i);
		ui64 typeIndex = GetTypeIndexFromName(typeArr, token);
		if typeIndex == 15 {
			typeIndex = currType;
		}

		ui64 nodeCount = nodeArr.GetCount();
		currentNode.firstChild = nodeCount + 1;
		currentNode.nextSibling = 0;
		currentNode.type = _cPARSER_NODETYPE_FIELD_LIST;
		currentNode.typeIndex = typeIndex;
		currentNode.tokenIndex = i + toSkip;
		ui64 fieldNodeState = nodeCount;
		lastPropertyState = nodeCount;
		nodeArr.AddNode(\currentNode);

		loop j, i + toSkip..tokenCount {
			currentNode.firstChild = -1;
			currentNode.nextSibling = 0;
			currentNode.type = _cPARSER_NODETYPE_FIELD;
			currentNode.typeIndex = typeIndex;
			currentNode.tokenIndex = j;
			//ref<Token> debugT = tArr.At(j);
			//PrintToken(debugT);

			bool isEnd = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_SEMICOLON);
			if isEnd {
				currentNode.nextSibling = -1;
				nodeCount = nodeArr.GetCount();
				nodeArr.AddNode(\currentNode);
				toSkip += 1;
				break;
			}
			bool isClassEnd = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_PARENTHESIS_OPEN);
			if isClassEnd {
				shouldExit = true;
				break;
			}

			bool isSyntaxCorrect = IsTokenSpecifiedType(tArr, j + 1, _cTOKENTYPE_OR);
			if !isSyntaxCorrect {
				stdout.write("[Parser]: Expected '|' or ';' for struct/class field but got ");
				ref<Token> wrongToken = tArr.At(j + 1);
				PrintToken(wrongToken);
				SYS_EXIT(1);
			}
			nodeCount = nodeArr.GetCount();
			currentNode.nextSibling = nodeCount + 1;
			nodeArr.AddNode(\currentNode);
			toSkip += 2;
			j += 1;
		}

		if shouldExit {
			nodeArr.DeleteLast();
			nodeCount = nodeArr.GetCount();
			nodeArr.UpdateNS(nodeCount - 1, -1);
			return returnVal;
		}
		i += toSkip;
		returnVal += (toSkip + 1);
		nodeCount = nodeArr.GetCount();
		nodeArr.UpdateNS(fieldNodeState, nodeCount);
	}
	nodeArr.UpdateNS(lastPropertyState, -1);
	return returnVal;
}

ui64 ParseStruct(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset, bool isAligned) {
	ui64 tokenCount = tArr.GetCount();
	ui64 nodeCount = nodeArr.GetCount();
	// struct name {
	//   ^ offset

	Node currentNode = { nodeCount + 1, 0, _cPARSER_NODETYPE_STRUCT, -1, offset + 1 };
	if isAligned {
		currentNode.type = _cPARSER_NODETYPE_STRUCT_ALIGNED;
	}
	ui64 structNodeState = nodeCount;
	nodeArr.AddNode(\currentNode);

	ui64 returnVal = 2;

	bool isSyntaxCorrect = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_CURLY_OPEN);
	if !isSyntaxCorrect {
		stdout.write("[Parser]: Expected a '{' for the definition of struct but got ");
		ref<Token> curlyToken = tArr.At(offset + returnVal);
		PrintToken(curlyToken);
		SYS_EXIT(1);
	}
	returnVal += 1;

	returnVal += ParseFieldList(tArr, nodeArr, typeArr, offset + 3);
	isSyntaxCorrect = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_CURLY_CLOSE);
	if !isSyntaxCorrect {
		stdout.write("[Parser]: Expected a '}' for the closing of struct but got ");
		ref<Token> curlyToken = tArr.At(offset + returnVal);
		PrintToken(curlyToken);
		SYS_EXIT(1);
	}

	nodeCount = nodeArr.GetCount();
	nodeArr.UpdateNS(structNodeState, nodeCount);
	return returnVal;
}

void ParseClass(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ui64 offset, bool isAligned) {
	ui64 tokenCount = tArr.GetCount();
	ui64 nodeCount = nodeArr.GetCount();

	Node currentNode = { nodeCount + 1, 0, _cPARSER_NODETYPE_CLASS, -1, offset + 1 };
	if isAligned {
		currentNode.type = _cPARSER_NODETYPE_CLASS_ALIGNED;
	}
	ui64 classNodeState = nodeCount;
	nodeArr.AddNode(\currentNode);

	ui64 returnVal = 2;

	bool isSyntaxCorrect = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_CURLY_OPEN);
	if !isSyntaxCorrect {
		stdout.write("[Parser]: Expected a '{' for the definition of class but got ");
		ref<Token> curlyToken = tArr.At(offset + returnVal);
		PrintToken(curlyToken);
		SYS_EXIT(1);
	}
	returnVal += 1;

	returnVal += ParseFieldList(tArr, nodeArr, typeArr, offset + returnVal);

	bool isEnd = IsTokenSpecifiedType(tArr, offset + returnVal, _cTOKENTYPE_CURLY_CLOSE);
	if isEnd {
		nodeCount = nodeArr.GetCount();
		nodeArr.UpdateNS(classNodeState, nodeCount);
		return returnVal;
	}

	ui64 lastFunctionState = 0;
	loop i, offset + returnVal..tokenCount {
		isEnd = IsTokenSpecifiedType(tArr, i, _cTOKENTYPE_CURLY_CLOSE);
		if isEnd {
			nodeArr.UpdateNS(lastFunctionState, -1);
			break;
		}

		lastFunctionState = nodeArr.GetCount();
		ui64 toSkip = ParseFunction(tArr, nodeArr, typeArr, i);
		returnVal += (toSkip + 1);
		i += toSkip;
	}

	nodeCount = nodeArr.GetCount();
	nodeArr.UpdateNS(classNodeState, nodeCount);
	return returnVal;
}

void Parse(ref<DynArray> tArr, ref<NodeArr> nodes, ref<DynArray> typeArr) {
	DynArray tokens = @tArr;
	DynArray types = @typeArr;
	Node currentNode = {1, -1, 1, -1, 0};
	nodes.AddNode(\currentNode);
	ui64 tokenCount = (tokens.count);

	loop i, 0..tokenCount {
		ref<Token> token = tArr.At(i);
		Token t = @token;
		ui64 ttype = t.type;

		if ttype == _cTOKENTYPE_MACRO {
			stdout.writeln("[Parser]: Parsing macros is not supported yet");
			SYS_EXIT(1);
		}

		if ttype != _cTOKENTYPE_KEYWORD_IDENTIFIER {
			stdout.write("[Parser]: Unexpected token type, expected identifier but got ");
			PrintToken(token);
			SYS_EXIT(1);
		}

		bool isStruct = StrEquals(t.text, "struct", 6);
		bool isClass = StrEquals(t.text, "class", 5);
		bool isAligned = StrEquals(t.text, "aligned", 7);
		if isAligned {
			ref<Token> nextTokenPtr = tArr.At(i + 1);
			Token nextToken = @nextTokenPtr;
			isStruct = StrEquals(nextToken.text, "struct", 6);
			isClass = StrEquals(nextToken.text, "class", 5);

			if isStruct {
				i += ParseStruct(tArr, nodes, typeArr, i + 1, true);
				skip;
			} else if isClass {
				i += ParseClass(tArr, nodes, typeArr, i + 1, true);
				skip;
			} else {
				stdout.writeln("[Parser]: Unexpected aligned token, expected 'class' or 'struct' but got ");
				PrintToken(nextTokenPtr);
				SYS_EXIT(1);
			}
		} else {
			if isStruct {
				i += ParseStruct(tArr, nodes, typeArr, i, false);
				skip;
			} else if isClass {
				i += ParseClass(tArr, nodes, typeArr, i, false);
				skip;
			}
		}

		bool isFunction = false;
		// Find first relevant token. If '(' we have a function definition, else we don't.
		loop j, i..tokens.count {
			ref<Token> iToken = tArr.At(j);
			Token it = @iToken;
			if (it.type) == _cTOKENTYPE_PARENTHESIS_OPEN {
				isFunction = true;
				break;
			} else if (it.type) == _cTOKENTYPE_ASSIGNMENT {
				break;
			} else if (it.type) == _cTOKENTYPE_SEMICOLON {
				break;
			}
		}

		if isFunction {
			ui64 toIncrease = ParseFunction(tArr, nodes, typeArr, i);
			i += toIncrease;
		} else {
			ui64 toIncrease = ParseVarDeclaration(tArr, nodes, typeArr, i);
			i += toIncrease;
		}
	}
}

void SetupTypeArray(ref<DynArray> typeArr) {
	Type ttype = {
		-1,
		-1,
		0,
		0,
		false,
		0
	}; // void
	typeArr.Add(\ttype);
	ttype.byteSize = 1;
	ttype.align = 1;
	ttype.typeType = 1; // UI8
	typeArr.Add(\ttype);
	ttype.byteSize = 2;
	ttype.align = 2;
	ttype.typeType = 2; // UI16
	typeArr.Add(\ttype);
	ttype.byteSize = 4;
	ttype.align = 4;
	ttype.typeType = 3; // UI32
	typeArr.Add(\ttype);
	ttype.byteSize = 8;
	ttype.align = 8;
	ttype.typeType = 4; // UI64
	typeArr.Add(\ttype);
	ttype.signed = true;
	ttype.byteSize = 1;
	ttype.align = 1;
	ttype.typeType = 5; // I8
	typeArr.Add(\ttype);
	ttype.byteSize = 2;
	ttype.align = 2;
	ttype.typeType = 6; // I16
	typeArr.Add(\ttype);
	ttype.byteSize = 4;
	ttype.align = 4;
	ttype.typeType = 7; // I32
	typeArr.Add(\ttype);
	ttype.byteSize = 8;
	ttype.align = 8;
	ttype.typeType = 8; // I64
	typeArr.Add(\ttype);
	ttype.byteSize = 1;
	ttype.align = 1;
	ttype.typeType = 9; // F8
	typeArr.Add(\ttype);
	ttype.byteSize = 2;
	ttype.align = 2;
	ttype.typeType = 10; // F16
	typeArr.Add(\ttype);
	ttype.byteSize = 4;
	ttype.align = 4;
	ttype.typeType = 11; // F32
	typeArr.Add(\ttype);
	ttype.byteSize = 8;
	ttype.align = 8;
	ttype.typeType = 12; // F64
	typeArr.Add(\ttype);
	ttype.byteSize = 1;
	ttype.align = 1;
	ttype.typeType = 13; // BOOL
	typeArr.Add(\ttype);
	ttype.byteSize = 4;
	ttype.align = 4;
	ttype.typeType = 14; // CHAR
	typeArr.Add(\ttype);
}

class Instr {
	ui8 type;
	ui8 valueType;
	ui64 value;

	void UpdateValue(ui64 val) {
		value = val;
	}
}

class InstrArr {
	ui64 size;
	ui64 count;
	ref<Instr> instructions;

	void New(ui64 _size) {
		size = _size;
		instructions = alloc((size * 10) + 10);
		count = 0;
	}

	void AddInstr(ref<Instr> instr) {
		// If count exceeded size, realloc and move
		if (count + 1) == size {
			ui64 s = size * 2;
			ui64 c = count + 1;
			ref<Instr> newRef = alloc((s * 10) + 10);
			memcopy2(newRef, instructions, count * 10);
			dealloc(instructions, (size * 10) + 10);
			instructions = newRef;
			memcopy2(newRef + (count * 10), instr, 10);
			size = s;
			count = c;
		} else {
			ui64 c = count;
			memcopy2(instructions + (count * 10), instr, 10);
			c += 1;
			count = c;
		}
	}

	ui64 GetCount() {
		return count;
	}

	ref<Instr> At(ui64 index) {
		return instructions + (index * 10);
	}

	ref<Instr> Pop() {
		ref<Instr> returnValue = instructions + ((count - 1) * 10);
		ui64 c = count - 1;
		count = c;
		return returnValue;
	}

	void UpdateValue(ui64 index, ui64 value) {
		ref<Instr> instruction = instructions + (index * 10);
		instruction.UpdateValue(value);
	}
}

struct Variable {
	ui64 nodeIndex;
	ui64 tokenIndex;
	i32 offset;
}

class VariableArr {
	ui64 size;
	ui64 count;
	ref<Variable> variables;

	void New(ui64 _size) {
		size = _size;
		variables = alloc((size * 20) + 20);
		count = 0;
	}

	void AddVar(ref<Variable> var) {
		// If count exceeded size, realloc and move
		if (count + 1) == size {
			ui64 s = size * 2;
			ui64 c = count + 1;
			ref<Variable> newRef = alloc((s * 20) + 20);
			memcopy2(newRef, variables, count * 20);
			dealloc(variables, (size * 20) + 20);
			variables = newRef;
			memcopy2(newRef + (count * 20), var, 20);
			size = s;
			count = c;
		} else {
			ui64 c = count;
			memcopy2(variables + (count * 20), var, 20);
			c += 1;
			count = c;
		}
	}

	ui64 GetCount() {
		return count;
	}

	ref<Variable> At(ui64 index) {
		return variables + (index * 20);
	}

	ui64 FindVarIndex(ref<DynArray> tArr, ui64 tokenIndex) {
		ui64 result = -1;
		loop i, 0..count {
			ref<Token> comparePtr = tArr.At(tokenIndex);
			ref<Variable> variablePtr = variables + (i * 20);
			Variable variable = @variablePtr;
			Token compare = @comparePtr;

			ref<Token> localPtr = tArr.At(variable.tokenIndex);
			Token base = @localPtr;
			if (base.textLength) != (compare.textLength) {
				result = -1;
				skip;
			}
			bool equals = StrEquals(base.text, compare.text, base.textLength);
			if equals {
				return i;
			} else {
				result = -1;
			}
		}
		return result;
	}
}

ui64 AnalyseExpression(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ref<InstrArr> instrArr, ui64 offset) {
	Instr currentInstr = {0, 0, 0}; // type, valueType, value
	ui64 i = offset;
	
	currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
	instrArr.AddInstr(\currentInstr);
	
	loop {
		ref<Node> exprNodePtr = nodeArr.At(i);
		Node exprNode = @exprNodePtr;
		// Obviously the below code should depend on the node type, token type, expressions, etc...
		// But for now, just parsing `return 0;` is good enough and I should allow myself that.
		ref<Token> tokenPtr = tArr.At(exprNode.tokenIndex);
		Token token = @tokenPtr;
		

		if (token.type) == _cTOKENTYPE_INTEGER {
			ui64 number = StringToUI64(token.text, token.textLength);
			currentInstr.type = _cANALYSER_INSTRTYPE_LOAD_INTEGER;
			currentInstr.value = number;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_PLUS {
			currentInstr.type = _cANALYSER_INSTRTYPE_ADD;
			currentInstr.value = 0;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_MINUS {
			currentInstr.type = _cANALYSER_INSTRTYPE_SUB;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_MULTIPLY {
			currentInstr.type = _cANALYSER_INSTRTYPE_MULT;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_DIVIDE {
			currentInstr.type = _cANALYSER_INSTRTYPE_DIV;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_MODULUS {
			currentInstr.type = _cANALYSER_INSTRTYPE_MOD;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_POWER_OF {
			currentInstr.type = _cANALYSER_INSTRTYPE_POWER;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);
		} else if (exprNode.type) == _cPARSER_NODETYPE_EXPRESSION_VARIABLE {
			currentInstr.type = _cANALYSER_INSTRTYPE_LOAD_VARIABLE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
			currentInstr.value = exprNode.tokenIndex;
			instrArr.AddInstr(\currentInstr);
		} else if (token.type) == _cTOKENTYPE_EQUALITY {
			if (currentInstr.type) == _cANALYSER_INSTRTYPE_LOAD_VARIABLE {
				instrArr.Pop();
				currentInstr.type = _cANALYSER_INSTRTYPE_CMP_VARIABLE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
				instrArr.AddInstr(\currentInstr);
			} else {
				currentInstr.type = _cANALYSER_INSTRTYPE_CMP_LOADED;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
				currentInstr.value = token.type;
				instrArr.AddInstr(\currentInstr);
			}
		} else if (exprNode.type) == _cPARSER_NODETYPE_EXPRESSION_FUNC_CALL {
			// Iterate over arguments
			// Call AnalyseExpression for each
			// Then add instr SET_ARG
			ui64 child = exprNode.GetFC();
			ref<Node> funcCall = nodeArr.At(child);
			child = funcCall.GetFC();
			ref<Node> funcName = nodeArr.At(child);
			Node funcCallNode = @funcName;
			if (funcCallNode.type) != _cPARSER_NODETYPE_FUNCTION {
				stdout.write("[Compiler#AnalyseExpression]: Function call node was not a function, but ");
				ui64 type = funcCallNode.type;
				stdout.writeln(type);
				SYS_EXIT(1);
			}
			child = funcName.GetFC();
			ref<Node> argsPtr = nodeArr.At(child);
			Node args = @argsPtr;
			if (args.firstChild) != -1 {
				// We have arguments
				// First child is pointing at an ARGUMENT node whose first child is an expression
				ui64 argIt = args.firstChild;
				ui64 counter = 0;
				loop {
					ref<Node> argNodePtr = nodeArr.At(argIt);
					Node argNode = @argNodePtr;
					AnalyseExpression(tArr, nodeArr, typeArr, instrArr, argNode.firstChild);
					currentInstr.type = _cANALYSER_INSTRTYPE_SET_ARG;
					currentInstr.value = counter;
					instrArr.AddInstr(\currentInstr);
					counter += 1;

					if (argNode.nextSibling) == -1 {
						break;
					} else {
						argIt = argNode.nextSibling;
					}
				}
			}

			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
			instrArr.AddInstr(\currentInstr);
			
			currentInstr.type = _cANALYSER_INSTRTYPE_CALL_FUNC;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
			currentInstr.value = exprNode.tokenIndex;
			instrArr.AddInstr(\currentInstr);
		} else {
			stdout.write("[Compiler#AnalyseExpression]: Unknown ");
			exprNodePtr.PrintNode();
			stdout.write(" ");
			PrintToken(tokenPtr);
			SYS_EXIT(1);
		}
		if (exprNode.nextSibling) == -1 {
			return i;
		}
		i = exprNode.nextSibling;
	}
	return 0;
}

ui64[128] s_ifs;
ui64 s_ifs_count = 0;

ui64 s_line_number = 1;

ui64 AnalyseBody(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ref<InstrArr> instrArr, ui64 offset, ref<ui64> labelCountPtr) {
	Instr currentInstr = {0, 0, 0}; // type, valueType, value
	ui64 nodeCount = nodeArr.GetCount();
	ui64 lastNodeIndex = offset;
	ui64 i = offset + 1;
	ui64 stackSize = 0;
	ui64 labelCount = @labelCountPtr;
	bool parsingIf = false;
	ui64 startingIfs = s_ifs_count;

	//currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_SET_BASIC_BLOCK;
	//instrArr.AddInstr(\currentInstr);

	loop {
		ref<Node> nodePtr = nodeArr.At(i);
		Node node = @nodePtr;

		ref<Token> tPtr = tArr.At(node.tokenIndex);
		Token t = @tPtr;
		
		if (t.line) != s_line_number {
			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE;
			currentInstr.value = (t.line) - s_line_number;
			instrArr.AddInstr(\currentInstr);
			s_line_number = t.line;
		}
		
		currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
		instrArr.AddInstr(\currentInstr);
		
		if parsingIf {
			if ((node.type) != _cPARSER_NODETYPE_ELSE) & ((node.type) != _cPARSER_NODETYPE_ELSE_IF) {
				loop j, startingIfs..s_ifs_count {
					instrArr.UpdateValue(s_ifs[j], labelCount);
				}
				s_ifs_count -= (s_ifs_count - startingIfs);
				currentInstr.type = _cANALYSER_INSTRTYPE_END_IF;
				currentInstr.value = labelCount;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
				labelCount += 1;
				instrArr.AddInstr(\currentInstr);
				parsingIf = false;

			} else {
				ui64 ifState = instrArr.GetCount();
				s_ifs[s_ifs_count] = ifState;
				s_ifs_count += 1;
				currentInstr.type = _cANALYSER_INSTRTYPE_JMP_LABEL;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
				currentInstr.value = labelCount + 1;
				instrArr.AddInstr(\currentInstr);
			}
		}

		if (node.type) == _cPARSER_NODETYPE_RETURN {
			// Might not have a value, in case for void functions
			// Return with value of 0 does not have a value, 1 does have a value
			if (node.firstChild) == -1 {
				currentInstr.type = _cANALYSER_INSTRTYPE_RETURN;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
				currentInstr.value = 0;
				instrArr.AddInstr(\currentInstr);
			} else {
				AnalyseExpression(tArr, nodeArr, typeArr, instrArr, node.firstChild);
				currentInstr.type = _cANALYSER_INSTRTYPE_RETURN;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
				currentInstr.value = 1;
				ui64 state = instrArr.GetCount();
				instrArr.AddInstr(\currentInstr);
			}
		} else if (node.type) == _cPARSER_NODETYPE_VARIABLE_DECLARATION_ASSIGNMENT {
			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_VAR;
			currentInstr.value = i;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
			instrArr.AddInstr(\currentInstr);

			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_TYPE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_TYPE;
			currentInstr.value = node.typeIndex;
			instrArr.AddInstr(\currentInstr);

			ref<Type> varTypePtr = typeArr.At(node.typeIndex);
			Type varType = @varTypePtr;
			stackSize += varType.byteSize;

			ref<Node> childPtr = nodeArr.At(node.firstChild);
			i32 fc = childPtr.GetFC();
			ref<Node> nextChildPtr = nodeArr.At(fc);
			Node child = @nextChildPtr;

			AnalyseExpression(tArr, nodeArr, typeArr, instrArr, fc);

			currentInstr.type = _cANALYSER_INSTRTYPE_SET_VALUE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
			currentInstr.value = i;
			instrArr.AddInstr(\currentInstr);
		} else if (node.type) == _cPARSER_NODETYPE_VARIABLE_ASSIGNMENT {
			ref<Node> childPtr = nodeArr.At(node.firstChild);
			Node child = @childPtr;
			ref<Token> tokenPtr = tArr.At(child.tokenIndex);
			Token token = @tokenPtr;

			AnalyseExpression(tArr, nodeArr, typeArr, instrArr, child.firstChild);

			// Check type of assignment
			ui16 assignmentType = (token.type) ^ _cTOKENTYPE_ASSIGNMENT;

			if assignmentType != 0 {
				// We have an operator assignment instruction (+=, -=, *=, etc...)
				currentInstr.type = _cANALYSER_INSTRTYPE_LOAD_VARIABLE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
				currentInstr.value = node.tokenIndex;
				instrArr.AddInstr(\currentInstr);

				if assignmentType == _cTOKENTYPE_PLUS {
					currentInstr.type = _cANALYSER_INSTRTYPE_ADD;
					currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
					currentInstr.value = 0;
					instrArr.AddInstr(\currentInstr);
				} else {
					stdout.write("[Compiler]: Error: Unknown assignment type ");
					stdout.writeln(assignmentType);
					SYS_EXIT(1);
				}
			}

			currentInstr.type = _cANALYSER_INSTRTYPE_SET_VALUE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
			currentInstr.value = i;
			instrArr.AddInstr(\currentInstr);
		} else if ((node.type) == _cPARSER_NODETYPE_IF) | ((node.type) == _cPARSER_NODETYPE_ELSE_IF) {
			if (node.type) == _cPARSER_NODETYPE_ELSE_IF {
				currentInstr.type = _cANALYSER_INSTRTYPE_ELSE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
				currentInstr.value = labelCount;
				instrArr.AddInstr(\currentInstr);
				labelCount += 1;
			}
			ref<Node> childPtr = nodeArr.At(node.firstChild);
			Node child = @childPtr;

			ui64 lastExprNodeIndex = AnalyseExpression(tArr, nodeArr, typeArr, instrArr, child.firstChild);
			ref<Node> lastExprNodePtr = nodeArr.At(lastExprNodeIndex);
			Node lastExprNode = @lastExprNodePtr;
			ref<Token> tokenPtr = tArr.At(lastExprNode.tokenIndex);
			Token token = @tokenPtr;

			if (token.type) == _cTOKENTYPE_EQUALITY {
				currentInstr.type = _cANALYSER_INSTRTYPE_JMP_EQ;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_OFFSET;
				currentInstr.value = 2;
				instrArr.AddInstr(\currentInstr);
			} else {
				stdout.write("[Compiler#AnalayseBody]: Error: Unknown top-level condition type ");
				ui64 type = token.type;
				stdout.writeln(type);
				SYS_EXIT(1);
			}
			ui64 labelState = instrArr.GetCount();
			currentInstr.type = _cANALYSER_INSTRTYPE_JMP_LABEL;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount + 1; // If there is an else (if), jump there, otherwise jump to end
			instrArr.AddInstr(\currentInstr);

			if (node.type) == _cPARSER_NODETYPE_IF {
				currentInstr.type = _cANALYSER_INSTRTYPE_IF;
			} else {
				currentInstr.type = _cANALYSER_INSTRTYPE_ELSE_IF;
			}
			currentInstr.value = labelCount;
			instrArr.AddInstr(\currentInstr);
			labelCount += 1;

			ui64 currentState = instrArr.GetCount();
			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_STACK;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);

			ui64 localStackSize = AnalyseBody(tArr, nodeArr, typeArr, instrArr, child.nextSibling, \labelCount);
			instrArr.UpdateValue(currentState, localStackSize);
			instrArr.UpdateValue(labelState, labelCount);
			parsingIf = true;
		} else if (node.type) == _cPARSER_NODETYPE_ELSE {
			currentInstr.type = _cANALYSER_INSTRTYPE_ELSE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			instrArr.AddInstr(\currentInstr);
			labelCount += 1;

			ui64 currentState = instrArr.GetCount();
			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_STACK;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);

			ui64 localStackSize = AnalyseBody(tArr, nodeArr, typeArr, instrArr, node.firstChild, \labelCount);
			instrArr.UpdateValue(currentState, localStackSize);
			loop j, startingIfs..s_ifs_count {
				instrArr.UpdateValue(s_ifs[j], labelCount);
			}
			s_ifs_count -= (s_ifs_count - startingIfs);
			currentInstr.type = _cANALYSER_INSTRTYPE_END_IF;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			labelCount += 1;
			instrArr.AddInstr(\currentInstr);
			parsingIf = false;
		} else if (node.type) == _cPARSER_NODETYPE_LOOP {
			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_LOOP;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			instrArr.AddInstr(\currentInstr);
			ui64 startLabel = labelCount;
			labelCount += 1;
			ui64 headerLabel = labelCount;

			ui64 currentState = instrArr.GetCount();
			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_STACK;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);

			ui64 localStackSize = 0;
			ui64 jmpState = 0;
			ref<Node> childPtr = nodeArr.At(node.firstChild);
			Node child = @childPtr;
			bool hasVariable = (child.type) == _cPARSER_NODETYPE_VARIABLE_DECLARATION;
			ui64 blockOffset = node.firstChild;
			if hasVariable {
				currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
				instrArr.AddInstr(\currentInstr);
				
				currentInstr.type = _cANALYSER_INSTRTYPE_DEF_VAR;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
				currentInstr.value = node.firstChild;
				instrArr.AddInstr(\currentInstr);
				ref<Node> variableNodePtr = nodeArr.At(node.firstChild);
				Node variableNode = @variableNodePtr;

				currentInstr.type = _cANALYSER_INSTRTYPE_WITH_TYPE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_TYPE;
				currentInstr.value = 4; // NOTE: Hardcoded to be UI64. Will need to find some way to discover the actual type
				instrArr.AddInstr(\currentInstr);
				localStackSize += 8;

				// NOTE: We might have to check if the loop has a step node. Assuming not for now
				ref<Node> rangeMinPtr = nodeArr.At(child.nextSibling);
				Node rangeMin = @rangeMinPtr;

				currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
				instrArr.AddInstr(\currentInstr);
				
				AnalyseExpression(tArr, nodeArr, typeArr, instrArr, rangeMin.firstChild);
				currentInstr.type = _cANALYSER_INSTRTYPE_SET_VALUE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
				currentInstr.value = node.firstChild;
				instrArr.AddInstr(\currentInstr);

				currentInstr.type = _cANALYSER_INSTRTYPE_DEF_LOOP_HEADER;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
				currentInstr.value = headerLabel;
				instrArr.AddInstr(\currentInstr);
				labelCount += 1;

				ref<Node> rangeMaxPtr = nodeArr.At(rangeMin.nextSibling);
				Node rangeMax = @rangeMaxPtr;
				currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
				instrArr.AddInstr(\currentInstr);
				AnalyseExpression(tArr, nodeArr, typeArr, instrArr, rangeMax.firstChild);
				// currentInstr.type = _cANALYSER_INSTRTYPE_SET_RANGE_MAX;
				// currentInstr.value = node.firstChild;
				// instrArr.AddInstr(\currentInstr);
				blockOffset = rangeMax.nextSibling;

				currentInstr.type = _cANALYSER_INSTRTYPE_CMP_VARIABLE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
				currentInstr.value = variableNode.tokenIndex;
				instrArr.AddInstr(\currentInstr);

				// NOTE: UNSIGNED because of the above hardcoded UI64 for the iterator
				currentInstr.type = _cANALYSER_INSTRTYPE_JMP_LT;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_OFFSET;
				currentInstr.value = 2; // Jump two instructions, this one and the next instruction
				instrArr.AddInstr(\currentInstr);

				currentInstr.type = _cANALYSER_INSTRTYPE_JMP_LABEL;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
				currentInstr.value = labelCount + 2;
				jmpState = instrArr.GetCount();
				instrArr.AddInstr(\currentInstr);
			}
			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_LOOP_BODY;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			labelCount += 1;
			instrArr.AddInstr(\currentInstr);
			localStackSize += AnalyseBody(tArr, nodeArr, typeArr, instrArr, blockOffset, \labelCount);

			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_LOOP_FOOTER;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			labelCount += 1;
			instrArr.AddInstr(\currentInstr);

			if hasVariable {
				currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
				instrArr.AddInstr(\currentInstr);
				
				currentInstr.type = _cANALYSER_INSTRTYPE_LOAD_VARIABLE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_TOKEN;
				currentInstr.value = child.tokenIndex;
				instrArr.AddInstr(\currentInstr);

				currentInstr.type = _cANALYSER_INSTRTYPE_INC;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_LAST_VALUE;
				currentInstr.value = 1;
				instrArr.AddInstr(\currentInstr);

				currentInstr.type = _cANALYSER_INSTRTYPE_SET_VALUE;
				currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
				currentInstr.value = node.firstChild;
				instrArr.AddInstr(\currentInstr);
			}

			currentInstr.type = _cANALYSER_INSTRTYPE_JMP_LABEL;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = headerLabel;
			instrArr.AddInstr(\currentInstr);

			instrArr.UpdateValue(jmpState, labelCount);
			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_LOOP_BREAKDOWN;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = labelCount;
			labelCount += 1;
			instrArr.AddInstr(\currentInstr);

			currentInstr.type = _cANALYSER_INSTRTYPE_END_LOOP;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_LABEL;
			currentInstr.value = startLabel;
			instrArr.AddInstr(\currentInstr);

			instrArr.UpdateValue(currentState, localStackSize);
			
			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_STATEMENT;
			instrArr.AddInstr(\currentInstr);
		} else {
			stdout.write("[Compiler#AnalyseBody]: ERROR: Unknown node type ");
			ui64 type = node.type;
			stdout.writeln(type);
			SYS_EXIT(1);
		}

		// This should remain as the very last thing
		if (node.nextSibling) == -1 {
			memcopy2(labelCountPtr, \labelCount, 8);
			return stackSize;
		}
		i = node.nextSibling;
	}

	memcopy2(labelCountPtr, \labelCount, 8);
	return stackSize;
}

void Analyse(ref<DynArray> tArr, ref<NodeArr> nodeArr, ref<DynArray> typeArr, ref<InstrArr> instrArr) {
	// We expect this to be either; VarDeclAssign, VarDecl, Import, Macro, Struct, FuncDecl
	ui64 nodeCount = nodeArr.GetCount();
	VariableArr varArr = {0, 0, 0};
	varArr.New(nodeCount);
	// At a leaf-node, the next node to check is just the leaf index + 1.
	// For (class) functions, the one with no NS is the last function. This actually counts for everything, but for classes it's important so we can put an END_CLASS after the function.
	// If we have a ANALYSE_FUNCTION function or something, it's important that it returns the index of the last visited node, so we do a + 1 for the next node.

	Instr currentInstr = {0, 0, 0}; // type, valueType, value
	ui64 i = 1;
	loop {
		ref<Node> nextNodePtr = nodeArr.At(i);
		Node nextNode = @nextNodePtr;

		ref<Token> tPtr = tArr.At(nextNode.tokenIndex);
		Token t = @tPtr;
		if (t.line) != s_line_number {
			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE;
			currentInstr.value = (t.line) - s_line_number;
			instrArr.AddInstr(\currentInstr);
			s_line_number = t.line;
		}

		if (nextNode.type) == _cPARSER_NODETYPE_FUNCTION {
			// DEF_FUNCTION
			currentInstr.type = _cANALYSER_INSTRTYPE_DEF_FUNC;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
			currentInstr.value = i;
			instrArr.AddInstr(\currentInstr);

			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_TYPE;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_TYPE;
			currentInstr.value = nextNode.typeIndex;
			instrArr.AddInstr(\currentInstr);

			ui64 stackSize = 0;

			ui64 currentState = instrArr.GetCount();
			currentInstr.type = _cANALYSER_INSTRTYPE_WITH_STACK;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NONE;
			currentInstr.value = 0;
			instrArr.AddInstr(\currentInstr);

			ref<Node> firstChild = nodeArr.At(nextNode.firstChild);
			Node child = @firstChild;
			ui64 bodyOffset = nextNode.firstChild;
			if (child.type) == _cPARSER_NODETYPE_PARAM_LIST {

				// Analyse Param list. End is if node.NS == -1
				loop j, i + 2..nodeCount {
					ref<Node> argNodePtr = nodeArr.At(j);
					Node argNode = @argNodePtr;
					currentInstr.type = _cANALYSER_INSTRTYPE_DEF_PARAM;
					currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
					currentInstr.value = j;
					instrArr.AddInstr(\currentInstr);

					currentInstr.type = _cANALYSER_INSTRTYPE_WITH_TYPE;
					currentInstr.valueType = _cANALYSER_INSTRVALUE_TYPE;
					currentInstr.value = argNode.typeIndex;
					instrArr.AddInstr(\currentInstr);

					ref<Type> varTypePtr = typeArr.At(argNode.typeIndex);
					Type varType = @varTypePtr;
					stackSize += varType.byteSize;

					if (argNode.nextSibling) == -1 {
						break;
					}
				}

				// analyse body
				bodyOffset = child.nextSibling;
			}
			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_SET_PROLOGUE_END;
			instrArr.AddInstr(\currentInstr);
			ui64 labelCount = 0;
			stackSize += AnalyseBody(tArr, nodeArr, typeArr, instrArr, bodyOffset, \labelCount);

			instrArr.UpdateValue(currentState, stackSize);
			
			currentInstr.type = _cANALYSER_INSTRTYPE_DEBUG_SET_EPILOGUE_BEGIN;
			instrArr.AddInstr(\currentInstr);

			// END_FUNCTION
			currentInstr.type = _cANALYSER_INSTRTYPE_END_FUNC;
			currentInstr.valueType = _cANALYSER_INSTRVALUE_NODE;
			currentInstr.value = i;
			instrArr.AddInstr(\currentInstr);
		} else {
			stdout.write("[Compiler#Analyse]: ERROR: Unknown node type ");
			ui64 type = nextNode.type;
			stdout.writeln(type);
			SYS_EXIT(1);
		}

		if (nextNode.nextSibling) == -1 {
			break;
		} else if (nextNode.nextSibling) >= nodeCount {
			break;
		}
		i = nextNode.nextSibling;
	}
}

void PrintInstrArray(ref<InstrArr> instrArr) {
	ui64 instrCount = instrArr.GetCount();
	loop i, 0..instrCount {
		ref<Instr> instrPtr = instrArr.At(i);
		Instr instruction = @instrPtr;
		if (instruction.type) == _cANALYSER_INSTRTYPE_NONE {
			stdout.write("NONE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_FUNC {
			stdout.write("DEF_FUNC ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_FUNC {
			stdout.write("END_FUNC ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_PARAM {
			stdout.write("DEF_PARAM ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_TYPE {
			stdout.write("WITH_TYPE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_WITH_STACK {
			stdout.write("WITH_STACK ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_VAR {
			stdout.write("DEF_VAR ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SET_VALUE {
			stdout.write("SET_VALUE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_INTEGER {
			stdout.write("LOAD_INTEGER ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_LOAD_VARIABLE {
			stdout.write("LOAD_VARIABLE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_RETURN {
			stdout.write("RETURN ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ADD {
			stdout.write("ADD ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SUB {
			stdout.write("SUB ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_MULT {
			stdout.write("MULT ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DIV {
			stdout.write("DIV ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_MOD {
			stdout.write("MOD ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_POWER {
			stdout.write("POWER ");
		}  else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP {
			stdout.write("DEF_LOOP ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CMP_LOADED {
			stdout.write("CMP_LOADED ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CMP_VARIABLE {
			stdout.write("CMP_VARIABLE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_LABEL {
			stdout.write("JMP_LABEL ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_HEADER {
			stdout.write("DEF_LOOP_HEADER ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_BODY {
			stdout.write("DEF_LOOP_BODY ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_FOOTER {
			stdout.write("DEF_LOOP_FOOTER ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEF_LOOP_BREAKDOWN {
			stdout.write("DEF_LOOP_BREAKDOWN ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_LOOP {
			stdout.write("END_LOOP ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_INC {
			stdout.write("INC ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_LT {
			stdout.write("JMP_LT ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_JMP_EQ {
			stdout.write("JMP_EQ ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_IF {
			stdout.write("IF ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_END_IF {
			stdout.write("END_IF ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ELSE {
			stdout.write("ELSE ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_ELSE_IF {
			stdout.write("ELSE_IF ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_SET_ARG {
			stdout.write("SET_ARG ");
		} else if (instruction.type) == _cANALYSER_INSTRTYPE_CALL_FUNC {
			stdout.write("CALL_FUNC ");
		} else if (instruction.type) >= 100 {
			if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_PROLOGUE_END {
				stdout.write("DBG_PROLOGUE_END ");
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_EPILOGUE_BEGIN {
				stdout.write("DBG_EPILOGUE_BEGIN ");
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_ADVANCE_LINE {
				stdout.write("DBG_ADVANCE_LINE ");
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_STATEMENT {
				stdout.write("DBG_STATEMENT ");
			} else if (instruction.type) == _cANALYSER_INSTRTYPE_DEBUG_SET_BASIC_BLOCK {
				stdout.write("DBG_BASIC_BLOCK ");
			} else {
				stdout.write("<Debugging instruction> ");
				ui64 type = instruction.type;
				stdout.write(type);
				stdout.write(" ");
			}
		} else {
			stdout.write("[Compiler#PrintInstruction]: ERROR: Unknown instruction type ");
			ui64 type = instruction.type;
			stdout.writeln(type);
			SYS_EXIT(1);
		}
		ui64 value = instruction.value;
		stdout.writeln(value);
	}
}

void PrintASTAsDot(ref<DynArray> tArr, ref<NodeArr> nodeArr) {
	ui64 nodeCount = nodeArr.GetCount();
	stdout.writeln("digraph \"\"");
	stdout.writeln(" {");
	stdout.writeln("subgraph nodes\n{");
	stdout.writeln("n0 [label=\"*Programme*\"]; \nn0 -> n1 ;");
	loop i, 1..nodeCount {
		ref<Node> n = nodeArr.At(i);
		Node node = @n;
		stdout.write("n");
		stdout.write(i);
		stdout.write(" [label=\"");
		stdout.write(i);
		stdout.write(". ");
		if ((node.type) == _cPARSER_NODETYPE_ARGUMENT) {
			stdout.write("*Argument*");
		} else if (node.type) == _cPARSER_NODETYPE_FUNCTION_CALL {
			stdout.write("*Function Call*");
		} else if (node.type) == _cPARSER_NODETYPE_ARG_LIST {
			stdout.write("*Arguments*");
		} else if (node.type) == _cPARSER_NODETYPE_BLOCK {
			stdout.write("*Block*");
		} else if (node.type) == _cPARSER_NODETYPE_CONDITION {
			stdout.write("*Condition*");
		} else if (node.type) == _cPARSER_NODETYPE_RANGE_MIN {
			stdout.write("*Range Min*");
		} else if (node.type) == _cPARSER_NODETYPE_RANGE_MAX {
			stdout.write("*Range Max*");
		} else if (node.type) == _cPARSER_NODETYPE_PARAM_LIST {
			stdout.write("*Param List*");
		} else {
			ref<Token> tok = tArr.At(node.tokenIndex);
			Token t = @tok;
			SYS_WRITE(1, t.text, t.textLength);
		}
		stdout.write("\" tooltip=\"");
		n.PrintNode();
		stdout.writeln("\"] ;");

		if ((node.firstChild) != -1) & ((node.firstChild) != nodeCount) {
			stdout.write("n");
			stdout.write(i);
			stdout.write(" -> ");
			stdout.write("n");
			i32 firstChild = node.firstChild;
			stdout.write(firstChild);
			stdout.writeln(" [label = \"FC\" color = darkgreen];");
		}
		if ((node.nextSibling) != -1) & ((node.nextSibling) != nodeCount) {
			stdout.write("n");
			stdout.write(i);
			stdout.write(" -> ");
			stdout.write("n");
			i32 nextSibling = node.nextSibling;
			stdout.write(nextSibling);
			stdout.writeln(" [label = \"NS\" color = blue];");
		}

	}
	stdout.writeln("}");
	stdout.writeln("}");
}

class ByteArr {
	ui64 size;
	ui64 count;
	ref<ui8> bytes;

	void New(ui64 _size) {
		size = _size;
		bytes = alloc(size + 1);
		count = 0;
		ui8 byte = 0;
		loop i, 0..size {
			memcopy2(bytes + i, \byte, 1);
		}
	}

	void AddByte(ui8 byte) {
		// If count exceeded size, realloc and move
		if (count + 1) == size {
			ui64 s = size * 2;
			ui64 c = count + 1;
			ref<ui8> newRef = alloc(s + 1);
			memcopy2(newRef, bytes, count);
			dealloc(bytes, count + 1);
			bytes = newRef;
			// bytes[count] = byte;
			memcopy2(bytes + count, \byte, 1);
			size = s;
			count = c;
		} else {
			ui64 c = count;
			// bytes[count] = byte;
			memcopy2(bytes + count, \byte, 1);
			c += 1;
			count = c;
		}
	}

	void AddUI16(ui16 short) {
		ui8 byte1 = (short >> 8);
		ui8 byte2 = short & 0xFF;
		// bytes[count] = byte1;
		// bytes[count + 1] = byte2;
		memcopy2(bytes + count, \byte2, 1);
		memcopy2((bytes + count) + 1, \byte1, 1);
		ui64 c = count;
		c += 2;
		count = c;
	}

	void AddUI32(ui32 int) {
		ui8 shiftAmount = 24;
		loop i, 1..5 {
			ui8 offset = 4 - i;
			ui8 byte = (int >> shiftAmount) & 0xFF;
			// bytes[count + i] = byte;
			memcopy2((bytes + count) + offset, \byte, 1);
			shiftAmount -= 8;
		}
		ui64 c = count;
		c += 4;
		count = c;
	}

	void AddUI64(ui64 long) {
		ui8 shiftAmount = 56;
		loop i, 1..9 {
			ui8 offset = 8 - i;
			ui8 byte = (long >> shiftAmount) & 0xFF;
			memcopy2((bytes + count) + offset, \byte, 1);
			shiftAmount -= 8;
		}
		ui64 c = count;
		c += 8;
		count = c;
	}

	ui8 AddULEB128(ui64 value) {
		ui8 byte = value & 0x7F;
		value >>= 7;
		if value != 0 {
			byte |= 0x80;
		}
		memcopy2(bytes + count, \byte, 1);
		ui64 c = count;
		c += 1;
		loop {
			if value == 0 {
				break;
			}
			byte = value & 0x7F;
			value >>= 7;
			if value != 0 {
				byte |= 0x80;
			}
			memcopy2(bytes + c, \byte, 1);
			c += 1;
		}
		ui8 total = c - count;
		count = c;
		return total;
	}

	ui8 AddSLEB128(i64 value) {
		bool more = true;
		bool negative = value < 0;

		ui64 c = count;
		loop {
			if !more {
				break;
			}
			ui8 byte = value & 0x7F;
			value >>= 7;

			if negative {
				value |= 0xFE00000000000000;
			}

			if ((value == 0) & ((byte & 0x40) == 0)) | ((value == -1) & ((byte & 0x40) == 0x40)) {
				more = false;
			} else {
				byte |= 0x80;
			}
			memcopy2(bytes + c, \byte, 1);
			c += 1;
		}
		ui8 total = c - count;
		count = c;
		return total;
	}

	void AddSame(ui8 byte, ui64 amount) {
		if (count + amount) >= size {
			ui64 s = size * 2;
			ref<ui8> newRef = alloc(s + 1);
			memcopy2(newRef, bytes, count);
			dealloc(bytes, count);
			bytes = newRef;
			size = s;
		}
		loop i, 0..amount {
			// bytes[count + i] = byte;
			memcopy2((bytes + count) + i, \byte, 1);
		}
		ui64 c = count;
		c += amount;
		count = c;
	}

	ui64 AddBytes(ref<ui8> address, ui64 byteSize) {
		if (count + byteSize) >= size {
			ui64 s = size * 2;
			ref<ui8> newRef = alloc(s + 1);
			memcopy2(newRef, bytes, count);
			dealloc(bytes, count);
			bytes = newRef;
			size = s;
		}
		memcopy2(bytes + count, address, byteSize);
		ui64 c = count;
		c += byteSize;
		count = c;
		return count - byteSize;
	}

	void UpdateBytes(ref<ui8> src, ui64 startOffset, ui64 byteSize) {
		memcopy2(bytes + startOffset, src, byteSize);
	}

	void UpdateByte(ui64 offset, ui8 byte) {
		memcopy2(bytes + offset, \byte, 1);
	}

	ui64 GetCount() {
		return count;
	}

	ref<ui8> At(ui64 index) {
		return bytes + index;
	}
}

struct Elf64Header {
	ui8 magic0;
	ui8 magic1;
	ui8 magic2;
	ui8 magic3;
	ui8 elfClass;
	ui8 endianness;
	ui8 version;
	ui8 abi;
	ui8 abiVersion;
	ui8 padding0;
	ui8 padding1;
	ui8 padding2;
	ui8 padding3;
	ui8 padding4;
	ui8 padding5;
	ui8 padding6;
	ui16 type;
	ui16 machine;
	ui32 objectVersion;
	ui64 entryPointAddress;
	ui64 programmeHeaderOffset;
	ui64 sectionHeaderOffset;
	ui32 flags;
	ui16 size;
	ui16 programmeHeaderSize;
	ui16 programmeHeaderEntryCount;
	ui16 sectionHeaderSize;
	ui16 sectionHeaderEntryCount;
	ui16 sectionHeaderStringTableIndex;
}

struct Elf64SectionHeader {
	ui32 name;
	ui32 type;
	ui64 flags;
	ui64 address;
	ui64 offset;
	ui64 size;
	ui32 link;
	ui32 info;
	ui64 addressAlign;
	ui64 entrySize;
}

struct Section {
	ref<ui8> name;
	ui64 nameLength;
	ref<ByteArr> bytes;
	ui32 nameOffset;
	ui32 type;
	ui64 flags;
	ui32 link;
	ui32 info;
	ui64 addressAlign;
	ui64 entrySize;
}

struct Elf64SymbolTableEntry {
	ui32 name;
	ui8 info;
	ui8 other;
	ui16 sectionHeaderIndex;
	ui64 value;
	ui64 size;
}

struct Elf64RelocationAddendEntry {
	ui64 offset;
	ui64 info;
	i64 addend;
}

struct DwarfCompilationUnitHeader {
	ui32 cuhLen;
	ui16 version;
	ui8 type;
	ui8 addressSize;
	ui32 abbrevOffset;
}

