enum TestEnum {
	Test1,
	Test2 = 5,
	Test3,
}

struct ScuffedNumber {
	ui64 val;
	ui64 power;
}

class String {
	ref<char> data;
	ui64 size;

	ui64 ToUI64() {
		ScuffedNumber n = { 0, 1 };

		loop i, 0..size {
			n.power *= 10;
		}

		loop i, 0..size {
			ui8 byte = data + i;
			ui8 digit = byte - 48;
			n.val += digit * n.power;
			n.power /= 10;
		}
		
		return n.val;
	}
}

struct Hi {
	ui8 field;
	ui8 field2;
	ui8 field3;
	TestEnum field4;
	String testString;
}

class FileDescriptor {
	ui8 fd;

	ui64 Write(String s) {
		ui64 bytesWritten = SYS_WRITE(fd, s.data, s.size);
		return bytesWritten;
	}

	ui64 Writeln(String s) {
		ui64 bytesWritten = SYS_WRITE(fd, s.data, s.size);
		bytesWritten += SYS_WRITE(fd, "\n", 1);
		return bytesWritten;
	}
	
	ui64 Read(String s) {
		return SYS_READ(fd, s.data, s.size);
	}
}

FileDescriptor stdin = 0;
FileDescriptor stdout = 1;
FileDescriptor stderr = 2;

ui8[4096] global_buffer;


ui8 returnSub2(ui16 value) {
	return value - 2;
}

ui8 assert(bool assertion, String printIfFalse) {
	if !assertion {
		stderr.Write("ASSERTION FAILED\n");
		stderr.Writeln(printIfFalse);
		SYS_KILL(0, 5); // SIGTRAP
	}
	return 0;
}

ui8 globalVar = 6;

ui8 main(array<ref<ui8> > argv) {
	ui16 value = 2 + 3 * 4 * 5 - globalVar;
	ui8 test = returnSub2(value);
	value -= 2;

	assert(test == value, "Returnsub didn't return the same as -=");

	Hi hi = { 5, 6, 7, TestEnum::Test2, "Hello, World!\n" };
	hi.field = 7;

	ref<Hi> hiPtr = \hi;
	hiPtr.field2 = 8;

	TestEnum t = TestEnum::Test3;
	hi.field4 = TestEnum::Test1;
	//test *= 2;

	String hello = "Hello, World!\n";

	loop i, 0..hello.size {
		if i == 1 {
			stdout.Write(hi.testString);
		}
	}

	match hi.field4 {
		TestEnum::Test1: { return 0; }
		TestEnum::Test2: { return hi.field - 3; }
	} else {
		return t;
	}

	/*
	ui64 matchExpressionValue = match t {
		Test1: 0;
		Test2: 5;
	} else {
		-1;
	}
	 */
	
	if hi.field - 3 == 5 {
		return 0;
	} else {
		return hi.field - 3;
	}
}
