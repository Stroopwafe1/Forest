enum TestEnum {
	Test1,
	Test2 = 5,
	Test3,
}

struct Hi {
	ui8 field;
	ui8 field2;
	ui8 field3;
}

class String {
	ref<char> data;
	ui64 size;
}

class FileDescriptor {
	ui8 fd;

	ui64 Write(String s) {
		ui64 bytesWritten = SYS_WRITE(fd, s.data, s.size);
		return bytesWritten;
	}
}


FileDescriptor stdin = 0;
FileDescriptor stdout = 1;
FileDescriptor stderr = 2;

ui8 returnSub2(ui16 value) {
	return value - 2;
}

ui8 globalVar = 6;

ui8 main(array<ref<ui8> > argv) {
	ui16 value = 2 + 3 * 4 * 5 - globalVar;
	ui8 test = returnSub2(value);
	array<char> testStr = "Hello, World";
	Hi hi = { 5, 6, 7 };
	hi.field = 7;

	ref<Hi> hiPtr = \hi;
	hiPtr.field2 = 8;

	TestEnum t = TestEnum::Test3;

	String hello = "Hello, World!";
	stdout.Write(hello);

	match t {
		TestEnum::Test1: { return 0; }
		TestEnum::Test2: { return hi.field - 3; }
	} else {
		return t;
	}

	/*
	ui64 matchExpressionValue = match t {
		Test1: 0;
		Test2: 5;
	} else {
		-1;
	}
	 */
	
	if hi.field - 3 == 5 {
		return 0;
	} else {
		return hi.field - 3;
	}
}
